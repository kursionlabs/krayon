//! Builds a private local preview and serves it until the listener joins.
use std::fmt::Writer;
use server::{Server!, static_files};
use site::{build_preview, clean_after_error, real_path, remove_tree};
use std::arena::Domain!;
use std::buffer::Buffer!;
use std::env::variable;
use std::io::print;
use std::option::{Option, Result};
use std::ptr::is_null;
use std::str::Str;

extern "C" fn mkdtemp(template: *u8) -> *u8;
extern "C" fn uv_chdir(path: *u8) -> i32;

forall 'k.
fn workspace(&cx: Domain!['k]) -> Result[Str['k], Buffer!] {
    let fallback = Str::from_static(&cx, "/tmp");
    let directory = match variable(&cx, Str::from_static(&cx, "TMPDIR")) {
        Some(value) => {
            let path = value.save(&cx);
            if path.is_empty() { fallback } else { path }
        },
        None => fallback,
    };
    let parent = real_path(&cx, directory)?;
    var template = Buffer!::new().write(&cx, parent).write_static("/krayon-preview-XXXXXX").write_byte(0);
    let len = &template.len() - 1;
    let path = unsafe mkdtemp(unsafe &template.as_ptr());
    if is_null(path) {
        template.destroy();
        return Result::Err.(f"krayon: cannot create preview workspace\n");
    }
    Result::Ok.(template.truncate(len).save(&cx))
}

forall 'k.
fn run_server(&cx: Domain!['k], server: Server!, temporary: Str['k],
    base: Str['k]) -> Result[(), Buffer!] {
    var server = server;
    var directory = Buffer!::new().write(&cx, temporary).write_static("/site").write_byte(0);
    let status = unsafe uv_chdir(unsafe &directory.as_ptr());
    directory.destroy();
    if status < 0 {
        server.stop();
        return Result::Err.(f"krayon: cannot enter preview output (libuv error {status})\n");
    }
    let port = &server.port();
    let announcement = Buffer!::new().write_static("Preview at http://127.0.0.1:")
        .put(port as u64).write(&cx, base).write_static("/\n");
    if !print(announcement).is_ok() {
        server.stop();
        return Result::Err.(f"krayon: cannot write preview URL\n");
    }
    match server.run() {
        Ok(nothing) => Result::Ok.(()),
        Err(code) => Result::Err.(f"krayon: preview stopped (libuv error {code})\n"),
    }
}

forall 'k.
fn serve(&cx: Domain!['k], root: Str['k], include_drafts: bool,
    overlay: Option[Str['k]], port: u16) -> Result[(), Buffer!] {
    // Bind first so Kable can receive shutdown signals during the build.
    let server = match Server!::bind(port, static_files::serve_from_cwd) {
        Ok(server) => server,
        Err(code) => return Result::Err.(f"krayon: cannot bind preview on port {port} (libuv error {code})\n"),
    };
    let temporary = match workspace(&cx) {
        Ok(path) => path,
        Err(message) => { server.stop(); return Result::Err.(message); },
    };
    let result = match build_preview(&cx, root, temporary, overlay, include_drafts) {
        Ok(base) => run_server(&cx, server, temporary, base),
        Err(message) => { server.stop(); Result::Err.(message) },
    };
    match result {
        Ok(nothing) => remove_tree(&cx, temporary),
        Err(message) => Result::Err.(clean_after_error(&cx, temporary, message)),
    }
}
