use std::alloc::arena::Domain!;
use std::bytes::buffer::Buffer!;
use std::io::eprint_buffer;
use std::option::{Option, Result};
use std::process::Args;
use std::raw::Span;
use site::build;

fn main(args: Args) -> i32 {
    if args.len() < 2usize || args.len() > 3usize {
        eprint_buffer(Buffer!::new().push_static("usage: krayon build [SITE_ROOT]\n"));
        return 2i32;
    }
    let exists 'k. cx = Domain!::new();
    var cx = cx;
    let command = match args.bytes(1usize) {
        Option::Some(s) => Span::from_static(&cx, s),
        Option::None => Span::from_static(&cx, ""),
    };
    if !command.is(&cx, "build") {
        eprint_buffer(Buffer!::new().push_static("usage: krayon build [SITE_ROOT]\n"));
        cx.destroy();
        return 2i32;
    }
    let root = match args.bytes(2usize) {
        Option::Some(s) => Span::from_static(&cx, s),
        Option::None => Span::from_static(&cx, "."),
    };
    let result = build(&cx, root);
    cx.destroy();
    match result {
        Result::Ok(nothing) => 0i32,
        Result::Err(message) => { eprint_buffer(message); 1i32 },
    }
}
