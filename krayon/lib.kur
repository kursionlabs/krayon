use std::fmt::Writer;
use package::preview;
use std::arena::Domain!;
use std::buffer::Buffer!;
use std::io::{eprint, print};
use std::option::{Option, Result};
use std::parse::parse_u64;
use std::process::{Args, hash_seed};
use std::str::Str;
use site::{build_with_drafts, build_with_overlay, check_with_drafts, check_with_overlay, init,
    routes_with_drafts, routes_with_overlay, routes_json_with_drafts, routes_json_with_overlay};

fn usage() -> () {
    eprint(Buffer!::new().write_static("usage: krayon <build|check|routes> [SITE_ROOT] [--drafts] [--overlay DIR]\n")
        .write_static("       krayon routes [SITE_ROOT] [--drafts] [--json] [--overlay DIR]\n")
        .write_static("       krayon preview [SITE_ROOT] [--drafts] [--overlay DIR] [--port PORT]\n")
        .write_static("       krayon init [DIR]\n"));
}

fn main(args: Args) -> i32 {
    if args.len() < 2usize || args.len() > 8usize {
        usage();
        return 2i32;
    }
    let exists 'k. cx = Domain!::new(hash_seed());
    var cx = cx;
    let command = match args.bytes(1usize) {
        Some(s) => Str::from_static(&cx, s),
        None => Str::from_static(&cx, ""),
    };
    if !command.is(&cx, "build") && !command.is(&cx, "check")
        && !command.is(&cx, "routes") && !command.is(&cx, "init") && !command.is(&cx, "preview") {
        usage();
        cx.destroy();
        return 2i32;
    }
    var root = Str::from_static(&cx, ".");
    if command.is(&cx, "init") {
        if args.len() > 3usize {
            usage();
            cx.destroy();
            return 2i32;
        }
        if args.len() == 3usize {
            let argument = match args.bytes(2usize) {
                Some(s) => Str::from_static(&cx, s),
                None => Str::from_static(&cx, ""),
            };
            if argument.is_empty() || argument.byte_or_zero(&cx, 0usize) == b'-' {
                usage();
                cx.destroy();
                return 2i32;
            }
            root = argument;
        }
        let result = init(&cx, root);
        cx.destroy();
        return match result {
            Ok(nothing) => match print(Buffer!::new().write_static("Krayon site created\n")) {
                Ok(nothing) => 0i32,
                Err(e) => 1i32,
            },
            Err(message) => { eprint(message); 1i32 },
        };
    }
    var have_root = false;
    var include_drafts = false;
    var json = false;
    var port = Option::None;
    var have_overlay = false;
    var overlay = Str::from_static(&cx, "");
    var i = 2usize;
    while i < args.len() {
        let argument = match args.bytes(i) {
            Some(s) => Str::from_static(&cx, s),
            None => Str::from_static(&cx, ""),
        };
        if argument.is(&cx, "--drafts") && !include_drafts { include_drafts = true; }
        else if argument.is(&cx, "--json") && command.is(&cx, "routes") && !json { json = true; }
        else if argument.is(&cx, "--port") && command.is(&cx, "preview") && port.is_none() {
            i = i + 1;
            let value = Str::from_static(&cx, args.bytes(i).unwrap_or(""));
            let number = parse_u64(&cx, value).unwrap_or(u64::MAX);
            if number > u16::MAX as u64 {
                eprint(f"krayon: --port expects a number from 0 to 65535\n");
                cx.destroy();
                return 2;
            }
            port = Option::Some.(number as u16);
        }
        else if argument.is(&cx, "--overlay") && !have_overlay {
            i = i + 1usize;
            if i >= args.len() {
                usage();
                cx.destroy();
                return 2i32;
            }
            overlay = match args.bytes(i) {
                Some(s) => Str::from_static(&cx, s),
                None => Str::from_static(&cx, ""),
            };
            if overlay.is_empty() || overlay.byte_or_zero(&cx, 0usize) == b'-' {
                usage();
                cx.destroy();
                return 2i32;
            }
            have_overlay = true;
        }
        else if !have_root && argument.byte_or_zero(&cx, 0usize) != b'-' {
            root = argument;
            have_root = true;
        } else {
            usage();
            cx.destroy();
            return 2i32;
        }
        i = i + 1usize;
    }
    if command.is(&cx, "routes") {
        let result = if have_overlay {
            if json { routes_json_with_overlay(&cx, root, overlay, include_drafts) }
                else { routes_with_overlay(&cx, root, overlay, include_drafts) }
        } else if json { routes_json_with_drafts(&cx, root, include_drafts) }
            else { routes_with_drafts(&cx, root, include_drafts) };
        cx.destroy();
        return match result {
            Ok(listing) => match print(listing) {
                Ok(nothing) => 0i32,
                Err(e) => { eprint(Buffer!::new().write_static("krayon: cannot write routes\n")); 1i32 },
            },
            Err(message) => { eprint(message); 1i32 },
        };
    }
    let result = if command.is(&cx, "preview") {
        let overlay = if have_overlay { Option::Some.(overlay) } else { Option::None };
        preview::serve(&cx, root, include_drafts, overlay, port.unwrap_or(0))
    } else if command.is(&cx, "check") {
        if have_overlay { check_with_overlay(&cx, root, overlay, include_drafts) }
            else { check_with_drafts(&cx, root, include_drafts) }
    } else if have_overlay { build_with_overlay(&cx, root, overlay, include_drafts) }
        else { build_with_drafts(&cx, root, include_drafts) };
    cx.destroy();
    match result {
        Ok(nothing) => 0i32,
        Err(message) => { eprint(message); 1i32 },
    }
}
