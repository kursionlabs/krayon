use std::arena::Domain!;
use std::buffer::Buffer!;
use std::collections::arena_vec::ArenaVec;
use std::option::{Option, Result};
use std::raw::Span;
use std::slice::Slice;
use std::utf8::decode;

exposed struct Error {
    offset: usize,
    message: Slice[u8, 'static],
}

forall 'k.
exposed struct Location {
    value: Span['k],
    offset: usize,
    bases: Option[ArenaVec[Span['k], 'k]],
}

fn fail(offset: usize, message: Slice[u8, 'static]) -> Error { Error.{ offset, message } }

forall 'k.
fn byte(&cx: Domain!['k], text: Span['k], i: usize) -> u8 { text.byte_or_zero(&cx, i) }

fn space(c: u8) -> bool { c == b' ' || c == b'\t' || c == b'\r' || c == b'\n' }

forall 'k.
fn skip_space(&cx: Domain!['k], text: Span['k], start: usize) -> usize {
    var i = start;
    while i < text.len() && space(byte(&cx, text, i)) { i = i + 1usize; }
    i
}

fn xml_char(code: u32) -> bool {
    code == 9u32 || code == 10u32 || code == 13u32
        || (code >= 32u32 && code <= 55295u32)
        || (code >= 57344u32 && code <= 65533u32)
        || (code >= 65536u32 && code <= 1114111u32)
}

forall 'k.
fn scalar(&cx: Domain!['k], text: Span['k], i: usize) -> Result[(u32, usize), Error] {
    match decode(&cx, text, i) {
        Option::Some(pair) => {
            let (code, next) = pair;
            if !xml_char(code) { return Result::Err.(fail(i, "invalid XML character")); }
            Result::Ok.((code, next))
        },
        Option::None => Result::Err.(fail(i, "invalid UTF-8 in XML")),
    }
}

fn name_start(c: u32) -> bool {
    c == 58u32 || c == 95u32 || (c >= 65u32 && c <= 90u32)
        || (c >= 97u32 && c <= 122u32)
        || (c >= 192u32 && c <= 214u32) || (c >= 216u32 && c <= 246u32)
        || (c >= 248u32 && c <= 767u32) || (c >= 880u32 && c <= 893u32)
        || (c >= 895u32 && c <= 8191u32) || (c >= 8204u32 && c <= 8205u32)
        || (c >= 8304u32 && c <= 8591u32) || (c >= 11264u32 && c <= 12271u32)
        || (c >= 12289u32 && c <= 55295u32) || (c >= 63744u32 && c <= 64975u32)
        || (c >= 65008u32 && c <= 65533u32) || (c >= 65536u32 && c <= 983039u32)
}

fn name_char(c: u32) -> bool {
    name_start(c) || c == 45u32 || c == 46u32 || (c >= 48u32 && c <= 57u32)
        || c == 183u32 || (c >= 768u32 && c <= 879u32)
        || (c >= 8255u32 && c <= 8256u32)
}

forall 'k.
fn name(&cx: Domain!['k], text: Span['k], start: usize) -> Result[(Span['k], usize), Error] {
    if start >= text.len() { return Result::Err.(fail(start, "expected XML name")); }
    let (first, next) = scalar(&cx, text, start)?;
    if !name_start(first) { return Result::Err.(fail(start, "expected XML name")); }
    var i = next;
    while i < text.len() {
        let c = byte(&cx, text, i);
        if c == b' ' || c == b'\n' || c == b'\r' || c == b'\t'
            || c == b'/' || c == b'>' || c == b'=' || c == b'?' { return Result::Ok.((text.slice(start, i), i)); }
        let (code, after) = scalar(&cx, text, i)?;
        if !name_char(code) { return Result::Ok.((text.slice(start, i), i)); }
        i = after;
    }
    Result::Ok.((text.slice(start, i), i))
}

fn digit(c: u8) -> bool { c >= b'0' && c <= b'9' }
fn lower(c: u8) -> u8 { if c >= b'A' && c <= b'Z' { c + 32u8 } else { c } }

forall 'k.
fn equal_ci(&cx: Domain!['k], text: Span['k], expected: Slice[u8, 'static]) -> bool {
    let expected = Span::from_static(&cx, expected);
    if text.len() != expected.len() { return false; }
    var i = 0usize;
    while i < text.len() {
        if lower(byte(&cx, text, i)) != lower(byte(&cx, expected, i)) { return false; }
        i = i + 1usize;
    }
    true
}
fn hex_value(c: u8) -> usize {
    if digit(c) { (c - b'0') as usize }
    else if c >= b'a' && c <= b'f' { (c - b'a' + 10u8) as usize }
    else if c >= b'A' && c <= b'F' { (c - b'A' + 10u8) as usize }
    else { 16usize }
}

forall 'k.
fn reference(&cx: Domain!['k], text: Span['k], start: usize) -> Result[usize, Error] {
    var i = start + 1usize;
    if i >= text.len() { return Result::Err.(fail(start, "unterminated XML reference")); }
    if byte(&cx, text, i) == b'#' {
        i = i + 1usize;
        let hexadecimal = byte(&cx, text, i) == b'x';
        if hexadecimal { i = i + 1usize; }
        let digits = i;
        var code = 0usize;
        while i < text.len() && byte(&cx, text, i) != b';' {
            let c = byte(&cx, text, i);
            let part = if hexadecimal { hex_value(c) }
                else if digit(c) { (c - b'0') as usize } else { 16usize };
            if part >= (if hexadecimal { 16usize } else { 10usize }) {
                return Result::Err.(fail(i, "invalid XML character reference"));
            }
            code = code * (if hexadecimal { 16usize } else { 10usize }) + part;
            if code > 1114111usize { return Result::Err.(fail(i, "invalid XML character reference")); }
            i = i + 1usize;
        }
        if i == digits || i >= text.len() || !xml_char(code as u32) {
            return Result::Err.(fail(start, "invalid XML character reference"));
        }
        return Result::Ok.(i + 1usize);
    }
    let (entity, end) = match name(&cx, text, i) {
        Result::Ok(found) => found,
        Result::Err(e) => return Result::Err.(fail(start, "invalid XML reference")),
    };
    if end >= text.len() || byte(&cx, text, end) != b';' {
        return Result::Err.(fail(start, "unterminated XML reference"));
    }
    if !entity.is(&cx, "amp") && !entity.is(&cx, "lt") && !entity.is(&cx, "gt")
        && !entity.is(&cx, "apos") && !entity.is(&cx, "quot") {
        return Result::Err.(fail(start, "unknown XML entity"));
    }
    Result::Ok.(end + 1usize)
}

forall 'k.
fn quoted(&cx: Domain!['k], text: Span['k], start: usize) -> Result[usize, Error] {
    let quote = byte(&cx, text, start);
    if quote != b'\'' && quote != b'"' { return Result::Err.(fail(start, "expected quoted attribute value")); }
    var i = start + 1usize;
    while i < text.len() {
        let c = byte(&cx, text, i);
        if c == quote { return Result::Ok.(i + 1usize); }
        if c == b'<' { return Result::Err.(fail(i, "unescaped < in attribute value")); }
        if c == b'&' { i = reference(&cx, text, i)?; }
        else { let (code, next) = scalar(&cx, text, i)?; i = next; }
    }
    Result::Err.(fail(start, "unterminated attribute value"))
}

forall 'k.
fn comment(&cx: Domain!['k], text: Span['k], start: usize) -> Result[usize, Error] {
    var i = start + 4usize;
    while i < text.len() {
        if byte(&cx, text, i) == b'-' && byte(&cx, text, i + 1usize) == b'-' {
            if byte(&cx, text, i + 2usize) == b'>' { return Result::Ok.(i + 3usize); }
            return Result::Err.(fail(i, "-- is not allowed inside an XML comment"));
        }
        let (code, next) = scalar(&cx, text, i)?;
        i = next;
    }
    Result::Err.(fail(start, "unterminated XML comment"))
}

forall 'k.
fn cdata(&cx: Domain!['k], text: Span['k], start: usize) -> Result[usize, Error] {
    var i = start + 9usize;
    while i < text.len() {
        if byte(&cx, text, i) == b']' && byte(&cx, text, i + 1usize) == b']'
            && byte(&cx, text, i + 2usize) == b'>' { return Result::Ok.(i + 3usize); }
        let (code, next) = scalar(&cx, text, i)?;
        i = next;
    }
    Result::Err.(fail(start, "unterminated CDATA section"))
}

forall 'k.
fn processing_instruction(&cx: Domain!['k], text: Span['k], start: usize) -> Result[usize, Error] {
    let (target, after) = name(&cx, text, start + 2usize)?;
    if equal_ci(&cx, target, "xml") { return Result::Err.(fail(start, "XML declaration must be first")); }
    var i = after;
    if byte(&cx, text, i) != b'?' && !space(byte(&cx, text, i)) {
        return Result::Err.(fail(i, "expected space after processing instruction target"));
    }
    while i < text.len() {
        if byte(&cx, text, i) == b'?' && byte(&cx, text, i + 1usize) == b'>' {
            return Result::Ok.(i + 2usize);
        }
        let (code, next) = scalar(&cx, text, i)?;
        i = next;
    }
    Result::Err.(fail(start, "unterminated processing instruction"))
}

forall 'k.
fn declaration(&cx: Domain!['k], text: Span['k], start: usize) -> Result[usize, Error] {
    var i = start + 5usize;
    if !space(byte(&cx, text, i)) { return Result::Err.(fail(i, "expected XML version")); }
    i = skip_space(&cx, text, i);
    if !text.slice(i, text.len()).starts_with(&cx, Span::from_static(&cx, "version")) {
        return Result::Err.(fail(i, "expected XML version"));
    }
    i = skip_space(&cx, text, i + 7usize);
    if byte(&cx, text, i) != b'=' { return Result::Err.(fail(i, "expected = after XML version")); }
    i = skip_space(&cx, text, i + 1usize);
    let version_start = i;
    i = quoted(&cx, text, i)?;
    if !text.slice(version_start + 1usize, i - 1usize).is(&cx, "1.0") {
        return Result::Err.(fail(version_start, "only XML 1.0 is supported"));
    }
    var seen_encoding = false;
    var seen_standalone = false;
    while i < text.len() && !(byte(&cx, text, i) == b'?' && byte(&cx, text, i + 1usize) == b'>') {
        if !space(byte(&cx, text, i)) { return Result::Err.(fail(i, "invalid XML declaration")); }
        i = skip_space(&cx, text, i);
        if byte(&cx, text, i) == b'?' && byte(&cx, text, i + 1usize) == b'>' { return Result::Ok.(i + 2usize); }
        let (field, next) = name(&cx, text, i)?;
        if !field.is(&cx, "encoding") && !field.is(&cx, "standalone") {
            return Result::Err.(fail(i, "invalid XML declaration field"));
        }
        if field.is(&cx, "encoding") {
            if seen_encoding || seen_standalone {
                return Result::Err.(fail(i, "invalid XML declaration field order"));
            }
            seen_encoding = true;
        } else {
            if seen_standalone { return Result::Err.(fail(i, "duplicate XML declaration field")); }
            seen_standalone = true;
        }
        i = skip_space(&cx, text, next);
        if byte(&cx, text, i) != b'=' { return Result::Err.(fail(i, "expected = in XML declaration")); }
        i = skip_space(&cx, text, i + 1usize);
        let value_start = i;
        i = quoted(&cx, text, i)?;
        let value = text.slice(value_start + 1usize, i - 1usize);
        if field.is(&cx, "encoding") {
            if !equal_ci(&cx, value, "UTF-8") {
                return Result::Err.(fail(value_start, "only UTF-8 XML is supported"));
            }
        } else if !value.is(&cx, "yes") && !value.is(&cx, "no") {
            return Result::Err.(fail(value_start, "standalone must be yes or no"));
        }
    }
    if i + 1usize >= text.len() { return Result::Err.(fail(start, "unterminated XML declaration")); }
    Result::Ok.(i + 2usize)
}

forall 'k.
fn start_tag(&cx: Domain!['k], text: Span['k], start: usize) -> Result[(Span['k], usize, bool), Error] {
    let (tag, after) = name(&cx, text, start + 1usize)?;
    var i = after;
    let attributes = ArenaVec::new(&cx);
    while i < text.len() {
        let c = byte(&cx, text, i);
        if c == b'>' { return Result::Ok.((tag, i + 1usize, false)); }
        if c == b'/' && byte(&cx, text, i + 1usize) == b'>' {
            return Result::Ok.((tag, i + 2usize, true));
        }
        if !space(c) { return Result::Err.(fail(i, "expected attribute or end of start tag")); }
        i = skip_space(&cx, text, i);
        if byte(&cx, text, i) == b'>' { return Result::Ok.((tag, i + 1usize, false)); }
        if byte(&cx, text, i) == b'/' && byte(&cx, text, i + 1usize) == b'>' {
            return Result::Ok.((tag, i + 2usize, true));
        }
        let (attribute, next) = name(&cx, text, i)?;
        var j = 0usize;
        while j < attributes.len(&cx) {
            if attribute.eq(&cx, attributes.at(&cx, j)) {
                return Result::Err.(fail(i, "duplicate XML attribute"));
            }
            j = j + 1usize;
        }
        attributes.push(&cx, attribute);
        i = skip_space(&cx, text, next);
        if byte(&cx, text, i) != b'=' { return Result::Err.(fail(i, "expected = after attribute name")); }
        i = skip_space(&cx, text, i + 1usize);
        i = quoted(&cx, text, i)?;
    }
    Result::Err.(fail(start, "unterminated XML start tag"))
}

forall 'k.
fn end_tag(&cx: Domain!['k], text: Span['k], start: usize) -> Result[(Span['k], usize), Error] {
    let (tag, after) = name(&cx, text, start + 2usize)?;
    let i = skip_space(&cx, text, after);
    if byte(&cx, text, i) != b'>' { return Result::Err.(fail(i, "expected > after closing tag")); }
    Result::Ok.((tag, i + 1usize))
}

forall 'k.
fn validate(&cx: Domain!['k], text: Span['k]) -> Result[(), Error] {
    var i = 0usize;
    if text.len() >= 3usize && byte(&cx, text, 0usize) == 239u8
        && byte(&cx, text, 1usize) == 187u8 && byte(&cx, text, 2usize) == 191u8 {
        i = 3usize;
    }
    if text.slice(i, text.len()).starts_with(&cx, Span::from_static(&cx, "<?xml"))
        && space(byte(&cx, text, i + 5usize)) {
        i = declaration(&cx, text, i)?;
    }
    let open = ArenaVec::new(&cx);
    var root = false;
    while i < text.len() {
        if byte(&cx, text, i) != b'<' {
            if open.len(&cx) == 0usize && !space(byte(&cx, text, i)) {
                return Result::Err.(fail(i, "text outside XML root element"));
            }
            if byte(&cx, text, i) == b'&' { i = reference(&cx, text, i)?; }
            else {
                if byte(&cx, text, i) == b']' && byte(&cx, text, i + 1usize) == b']'
                    && byte(&cx, text, i + 2usize) == b'>' {
                    return Result::Err.(fail(i, "]]> is not allowed in XML text"));
                }
                let (code, next) = scalar(&cx, text, i)?;
                i = next;
            }
        } else if text.slice(i, text.len()).starts_with(&cx, Span::from_static(&cx, "<!--")) {
            i = comment(&cx, text, i)?;
        } else if text.slice(i, text.len()).starts_with(&cx, Span::from_static(&cx, "<![CDATA[")) {
            if open.len(&cx) == 0usize { return Result::Err.(fail(i, "CDATA outside XML root element")); }
            i = cdata(&cx, text, i)?;
        } else if text.slice(i, text.len()).starts_with(&cx, Span::from_static(&cx, "<!")) {
            return Result::Err.(fail(i, "DTD declarations are not supported"));
        } else if text.slice(i, text.len()).starts_with(&cx, Span::from_static(&cx, "<?")) {
            i = processing_instruction(&cx, text, i)?;
        } else if text.slice(i, text.len()).starts_with(&cx, Span::from_static(&cx, "</")) {
            let (tag, next) = end_tag(&cx, text, i)?;
            let expected = match open.pop(&cx) {
                Option::Some(name) => name,
                Option::None => return Result::Err.(fail(i, "closing tag without opening tag")),
            };
            if !tag.eq(&cx, expected) { return Result::Err.(fail(i, "mismatched XML closing tag")); }
            i = next;
        } else {
            if root && open.len(&cx) == 0usize { return Result::Err.(fail(i, "multiple XML root elements")); }
            let (tag, next, empty) = start_tag(&cx, text, i)?;
            root = true;
            if !empty {
                if open.len(&cx) >= 128usize { return Result::Err.(fail(i, "XML nested too deeply")); }
                open.push(&cx, tag);
            }
            i = next;
        }
    }
    if !root { return Result::Err.(fail(i, "missing XML root element")); }
    if open.len(&cx) != 0usize { return Result::Err.(fail(i, "unclosed XML element")); }
    Result::Ok.(())
}

fn append_utf8(out: Buffer!, code: usize) -> Buffer! {
    if code < 128usize { out.push_byte(code as u8) }
    else if code < 2048usize {
        out.push_byte((192usize + code / 64usize) as u8)
            .push_byte((128usize + code % 64usize) as u8)
    } else if code < 65536usize {
        out.push_byte((224usize + code / 4096usize) as u8)
            .push_byte((128usize + (code / 64usize) % 64usize) as u8)
            .push_byte((128usize + code % 64usize) as u8)
    } else {
        out.push_byte((240usize + code / 262144usize) as u8)
            .push_byte((128usize + (code / 4096usize) % 64usize) as u8)
            .push_byte((128usize + (code / 64usize) % 64usize) as u8)
            .push_byte((128usize + code % 64usize) as u8)
    }
}

forall 'k.
fn append_reference(&cx: Domain!['k], out: Buffer!, text: Span['k], start: usize, end: usize) -> Buffer! {
    let entity = text.slice(start + 1usize, end - 1usize);
    if entity.is(&cx, "amp") { return out.push_byte(b'&'); }
    if entity.is(&cx, "lt") { return out.push_byte(b'<'); }
    if entity.is(&cx, "gt") { return out.push_byte(b'>'); }
    if entity.is(&cx, "quot") { return out.push_byte(b'"'); }
    if entity.is(&cx, "apos") { return out.push_byte(b'\''); }
    let hexadecimal = byte(&cx, entity, 1usize) == b'x';
    let base = if hexadecimal { 16usize } else { 10usize };
    var i = if hexadecimal { 2usize } else { 1usize };
    var code = 0usize;
    while i < entity.len() {
        code = code * base + (if hexadecimal { hex_value(byte(&cx, entity, i)) }
            else { (byte(&cx, entity, i) - b'0') as usize });
        i = i + 1usize;
    }
    append_utf8(out, code)
}

forall 'k.
fn loc_name(&cx: Domain!['k], tag: Span['k]) -> bool {
    tag.is(&cx, "loc") || tag.ends_with(&cx, Span::from_static(&cx, ":loc"))
}

forall 'k.
fn sitemap_root(&cx: Domain!['k], tag: Span['k]) -> bool {
    tag.is(&cx, "urlset") || tag.is(&cx, "sitemapindex")
        || tag.ends_with(&cx, Span::from_static(&cx, ":urlset"))
        || tag.ends_with(&cx, Span::from_static(&cx, ":sitemapindex"))
}

forall 'k.
fn xml_name(&cx: Domain!['k], tag: Span['k], namespace: Span['k], local: Slice[u8, 'static]) -> bool {
    if namespace.is_empty() { tag.is(&cx, local) }
    else { tag.eq(&cx, Buffer!::new().push_bytes(&cx, namespace).push_byte(b':').push_static(local).save(&cx)) }
}

forall 'k.
fn attribute_text(&cx: Domain!['k], raw: Span['k]) -> Result[Span['k], Error] {
    var out = Buffer!::new();
    var i = 0usize;
    while i < raw.len() {
        if byte(&cx, raw, i) == b'&' {
            let next = match reference(&cx, raw, i) {
                Result::Ok(next) => next,
                Result::Err(error) => { out.destroy(); return Result::Err.(error); },
            };
            out = append_reference(&cx, out, raw, i, next);
            i = next;
        } else {
            let start = i;
            while i < raw.len() && byte(&cx, raw, i) != b'&' { i = i + 1usize; }
            out = out.push_bytes(&cx, raw.slice(start, i));
        }
    }
    Result::Ok.(out.save(&cx))
}

forall 'k.
fn named_attribute(&cx: Domain!['k], text: Span['k], tag_start: usize, wanted: Span['k])
    -> Result[Option[Location['k]], Error] {
    let (_, after) = name(&cx, text, tag_start + 1usize)?;
    var i = after;
    var done = false;
    while i < text.len() && !done {
        i = skip_space(&cx, text, i);
        if byte(&cx, text, i) == b'>' || byte(&cx, text, i) == b'/' { done = true; }
        else {
            let (attribute, next) = name(&cx, text, i)?;
            i = skip_space(&cx, text, next);
            i = skip_space(&cx, text, i + 1usize);
            let start = i + 1usize;
            i = quoted(&cx, text, i)?;
            if attribute.eq(&cx, wanted) {
                let value = attribute_text(&cx, text.slice(start, i - 1usize))?;
                return Result::Ok.(Option::Some.(Location.{ value, offset: start, bases: Option::None }));
            }
        }
    }
    Result::Ok.(Option::None)
}

forall 'k.
fn atom_namespace(&cx: Domain!['k], text: Span['k], tag_start: usize, namespace: Span['k])
    -> Result[bool, Error] {
    let attribute = if namespace.is_empty() { Span::from_static(&cx, "xmlns") }
        else { Buffer!::new().push_static("xmlns:").push_bytes(&cx, namespace).save(&cx) };
    match named_attribute(&cx, text, tag_start, attribute)? {
        Option::Some(found) => Result::Ok.(found.value.is(&cx, "http://www.w3.org/2005/Atom")),
        Option::None => Result::Ok.(false),
    }
}

// Called after validate, so all XML tokens and references are well formed.
forall 'k.
fn locations(&cx: Domain!['k], text: Span['k]) -> Result[ArenaVec[Location['k], 'k], Error] {
    let found = ArenaVec::new(&cx);
    var i = 0usize;
    if text.len() >= 3usize && byte(&cx, text, 0usize) == 239u8
        && byte(&cx, text, 1usize) == 187u8 && byte(&cx, text, 2usize) == 191u8 { i = 3usize; }
    if text.slice(i, text.len()).starts_with(&cx, Span::from_static(&cx, "<?xml"))
        && space(byte(&cx, text, i + 5usize)) { i = declaration(&cx, text, i)?; }
    var active = false;
    var root_seen = false;
    var sitemap = false;
    var atom = false;
    var rss = false;
    var namespace = Span::from_static(&cx, "");
    let open = ArenaVec::new(&cx);
    let base_stack = ArenaVec::new(&cx);
    var active_tag = Span::from_static(&cx, "");
    var depth = 0usize;
    var parts = ArenaVec::new(&cx);
    var offset = 0usize;
    var have_offset = false;
    while i < text.len() {
        if byte(&cx, text, i) != b'<' {
            if byte(&cx, text, i) == b'&' {
                let next = reference(&cx, text, i)?;
                if active && depth == 0usize {
                    if !have_offset { offset = i; have_offset = true; }
                    parts.push(&cx, append_reference(&cx, Buffer!::new(), text, i, next).save(&cx));
                }
                i = next;
            } else {
                let start = i;
                while i < text.len() && byte(&cx, text, i) != b'<' && byte(&cx, text, i) != b'&' {
                    i = i + 1usize;
                }
                if active && depth == 0usize {
                    if !have_offset {
                        var first = start;
                        while first < i && space(byte(&cx, text, first)) { first = first + 1usize; }
                        if first < i { offset = first; have_offset = true; }
                    }
                    parts.push(&cx, text.slice(start, i));
                }
            }
        } else if text.slice(i, text.len()).starts_with(&cx, Span::from_static(&cx, "<!--")) {
            i = comment(&cx, text, i)?;
        } else if text.slice(i, text.len()).starts_with(&cx, Span::from_static(&cx, "<![CDATA[")) {
            let next = cdata(&cx, text, i)?;
            if active && depth == 0usize {
                if !have_offset {
                    var first = i + 9usize;
                    while first < next - 3usize && space(byte(&cx, text, first)) { first = first + 1usize; }
                    if first < next - 3usize { offset = first; have_offset = true; }
                }
                parts.push(&cx, text.slice(i + 9usize, next - 3usize));
            }
            i = next;
        } else if text.slice(i, text.len()).starts_with(&cx, Span::from_static(&cx, "<?")) {
            i = processing_instruction(&cx, text, i)?;
        } else if text.slice(i, text.len()).starts_with(&cx, Span::from_static(&cx, "</")) {
            let (tag, next) = end_tag(&cx, text, i)?;
            if active {
                if depth == 0usize && tag.eq(&cx, active_tag) {
                    var value = Buffer!::new();
                    var part = 0usize;
                    while part < parts.len(&cx) {
                        value = value.push_bytes(&cx, parts.at(&cx, part));
                        part = part + 1usize;
                    }
                    let raw = value.save(&cx);
                    var start = 0usize;
                    var end = raw.len();
                    while start < end && space(byte(&cx, raw, start)) { start = start + 1usize; }
                    while end > start && space(byte(&cx, raw, end - 1usize)) { end = end - 1usize; }
                    if end > start { found.push(&cx, Location.{ value: raw.slice(start, end), offset, bases: Option::None }); }
                    active = false;
                } else if depth > 0usize { depth = depth - 1usize; }
            }
            let _ = open.pop(&cx);
            if atom { let _ = base_stack.pop(&cx); }
            i = next;
        } else {
            let (tag, next, empty) = start_tag(&cx, text, i)?;
            if !root_seen {
                root_seen = true;
                sitemap = sitemap_root(&cx, tag);
                let colon = match tag.find_byte(&cx, b':', 0usize) {
                    Option::Some(at) => at,
                    Option::None => tag.len(),
                };
                if colon < tag.len() { namespace = tag.slice(0usize, colon); }
                atom = xml_name(&cx, tag, namespace, "feed")
                    && atom_namespace(&cx, text, i, namespace)?;
                rss = tag.is(&cx, "rss");
            }
            if atom && xml_name(&cx, tag, namespace, "link") &&
                ((open.len(&cx) == 1usize && xml_name(&cx, open.at(&cx, 0usize), namespace, "feed")) ||
                 (open.len(&cx) == 2usize && xml_name(&cx, open.at(&cx, 1usize), namespace, "entry"))) {
                match named_attribute(&cx, text, i, Span::from_static(&cx, "href"))? {
                    Option::Some(location) => {
                        let bases = ArenaVec::new(&cx);
                        var j = 0usize;
                        while j < base_stack.len(&cx) {
                            match base_stack.at(&cx, j) {
                                Option::Some(base) => bases.push(&cx, base),
                                Option::None => (),
                            }
                            j = j + 1usize;
                        }
                        match named_attribute(&cx, text, i, Span::from_static(&cx, "xml:base"))? {
                            Option::Some(base) => bases.push(&cx, base.value),
                            Option::None => (),
                        }
                        found.push(&cx, Location.{ value: location.value, offset: location.offset,
                            bases: Option::Some.(bases) });
                    },
                    Option::None => (),
                }
            }
            if active { if !empty { depth = depth + 1usize; } }
            else if sitemap && !empty && loc_name(&cx, tag) {
                active = true;
                active_tag = tag;
                parts = ArenaVec::new(&cx);
                offset = next;
                have_offset = false;
            } else if rss && !empty && tag.is(&cx, "link") &&
                ((open.len(&cx) == 2usize && open.at(&cx, 1usize).is(&cx, "channel")) ||
                 (open.len(&cx) == 3usize && open.at(&cx, 1usize).is(&cx, "channel") &&
                    open.at(&cx, 2usize).is(&cx, "item"))) {
                active = true;
                active_tag = tag;
                parts = ArenaVec::new(&cx);
                offset = next;
                have_offset = false;
            }
            if !empty {
                open.push(&cx, tag);
                if atom {
                    let base = match named_attribute(&cx, text, i, Span::from_static(&cx, "xml:base"))? {
                        Option::Some(found) => Option::Some.(found.value),
                        Option::None => Option::None,
                    };
                    base_stack.push(&cx, base);
                }
            }
            i = next;
        }
    }
    Result::Ok.(found)
}
