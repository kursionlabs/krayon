use std::arena::Domain!;
use std::buffer::Buffer!;
use std::collections::arena_map::ArenaMap;
use std::collections::arena_vec::ArenaVec;
use std::fs::{canonicalize, read_to_arena};
use std::fmt::Writable;
use std::option::{Option, Result};
use std::raw::Span;
use std::slice::Slice;
use toml::parse;
use toml::value::TomlValue;
use url::{absolute, prefix};
use records::{filter_contains, filter_records, sort_records};

forall 'k.
exposed struct Page {
    data: ArenaMap[Span['k], TomlValue['k], 'k],
    url: Span['k],
    body: Span['k],
    body_line: usize,
}

exposed enum TemplateFormat {
    Html,
    Xml,
    Json,
    Text,
}

struct Frame {
    parent: bool,
    matched: bool,
    else_seen: bool,
    opening: usize,
}

forall 'k.
struct Binding {
    name: Span['k],
    value: TomlValue['k],
}

forall 'k.
struct Group {
    key: Span['k],
    items: ArenaVec[TomlValue['k], 'k],
}

forall 'k.
fn lit(&cx: Domain!['k], text: Slice[u8, 'static]) -> Span['k] { Span::from_static(&cx, text) }

forall 'k.
fn byte(&cx: Domain!['k], text: Span['k], i: usize) -> u8 { text.byte_or_zero(&cx, i) }

forall 'k.
fn starts(&cx: Domain!['k], text: Span['k], prefix: Slice[u8, 'static]) -> bool {
    text.starts_with(&cx, lit(&cx, prefix))
}

forall 'k.
fn position(&cx: Domain!['k], source: Span['k], offset: usize, first_line: usize, first_column: usize) -> (usize, usize) {
    var line = first_line;
    var column = first_column;
    var i = 0usize;
    while i < offset {
        let current = byte(&cx, source, i);
        if current == b'\n' { line = line + 1usize; column = 1usize; }
        else if current < 128u8 || current >= 192u8 { column = column + 1usize; }
        i = i + 1usize;
    }
    (line, column)
}

forall 'k.
fn template_error(&cx: Domain!['k], file: Span['k], source: Span['k], offset: usize,
    first_line: usize, first_column: usize, detail: Span['k]) -> Span['k] {
    let (line, column) = position(&cx, source, offset, first_line, first_column);
    Buffer!::new().push_bytes(&cx, file).push_byte(b':').push_usize(line).push_byte(b':')
        .push_usize(column).push_static(": ").push_bytes(&cx, detail).save(&cx)
}

// Pages and layouts use TOML front matter between +++ lines. A file without
// front matter has an empty data table.
forall 'k.
fn parse_page(&cx: Domain!['k], source: Span['k], url: Span['k]) -> Result[Page['k], Span['k]] {
    if !starts(&cx, source, "+++\n") {
        return Result::Ok.(Page.{ data: ArenaMap::new(&cx), url, body: source, body_line: 1usize });
    }
    match source.find(&cx, lit(&cx, "\n+++"), 4usize) {
        Option::None => Result::Err.(lit(&cx, "unclosed TOML front matter")),
        Option::Some(end) => {
            let after = end + 4usize;
            if after < source.len() && byte(&cx, source, after) != b'\n' {
                return Result::Err.(lit(&cx, "front matter delimiter must end its line"));
            }
            match parse(&cx, source.slice(4usize, end)) {
                Result::Err(e) => Result::Err.(Span::from_static(&cx, e.message)),
                Result::Ok(data) => {
                    let start = if after < source.len() { after + 1usize } else { after };
                    let (line, column) = position(&cx, source, start, 1usize, 1usize);
                    Result::Ok.(Page.{ data, url, body: source.slice(start, source.len()), body_line: line })
                },
            }
        },
    }
}

forall 'k.
fn field(&cx: Domain!['k], table: ArenaMap[Span['k], TomlValue['k], 'k], name: Slice[u8, 'static]) -> Option[TomlValue['k]] {
    table.get(&cx, lit(&cx, name))
}

forall 'k.
fn string_field(&cx: Domain!['k], table: ArenaMap[Span['k], TomlValue['k], 'k], name: Slice[u8, 'static]) -> Option[Span['k]] {
    match field(&cx, table, name) {
        Option::None => Option::None,
        Option::Some(value) => value.as_string(),
    }
}

forall 'k.
fn scalar(&cx: Domain!['k], value: TomlValue['k]) -> Option[Span['k]] {
    match value {
        TomlValue::String(s) => Option::Some.(s),
        TomlValue::Integer(n) => Option::Some.(Buffer!::new().push_i64(n).save(&cx)),
        TomlValue::Boolean(b) => Option::Some.(lit(&cx, if b { "true" } else { "false" })),
        TomlValue::Datetime(d) => Option::Some.(d.text),
        _ => Option::None,
    }
}

forall 'k.
fn lookup(&cx: Domain!['k], site: ArenaMap[Span['k], TomlValue['k], 'k],
    collections: ArenaMap[Span['k], TomlValue['k], 'k], page: Page['k],
    bindings: ArenaVec[Binding['k], 'k], expression: Span['k]) -> Option[TomlValue['k]] {
    var path = expression;
    var table = site;
    if starts(&cx, path, "site.") { path = path.slice(5usize, path.len()); }
    else if starts(&cx, path, "page.") {
        path = path.slice(5usize, path.len());
        if path.is(&cx, "url") { return Option::Some.(TomlValue::String.(page.url)); }
        table = page.data;
    } else if starts(&cx, path, "collections.") {
        path = path.slice(12usize, path.len());
        table = collections;
    } else {
        let dot = path.find_byte(&cx, b'.', 0usize);
        let root = match dot { Option::Some(i) => path.slice(0usize, i), Option::None => path };
        var i = bindings.len(&cx);
        while i > 0usize {
            i = i - 1usize;
            let binding = bindings.at(&cx, i);
            if binding.name.eq(&cx, root) {
                return match dot {
                    Option::None => Option::Some.(binding.value),
                    Option::Some(at) => match binding.value.as_table() {
                        Option::None => Option::None,
                        Option::Some(found) => lookup_table(&cx, found, path.slice(at + 1usize, path.len())),
                    },
                };
            }
        }
        return Option::None;
    }
    lookup_table(&cx, table, path)
}

forall 'k.
fn lookup_table(&cx: Domain!['k], start: ArenaMap[Span['k], TomlValue['k], 'k], path: Span['k]) -> Option[TomlValue['k]] {
    var table = start;
    var path = path;
    while true {
        match path.find_byte(&cx, b'.', 0usize) {
            Option::Some(dot) => {
                let key = path.slice(0usize, dot);
                match table.get(&cx, key) {
                    Option::None => return Option::None,
                    Option::Some(value) => match value.as_table() {
                        Option::None => return Option::None,
                        Option::Some(next) => { table = next; },
                    },
                }
                path = path.slice(dot + 1usize, path.len());
            },
            Option::None => return table.get(&cx, path),
        }
    }
    Option::None
}

forall 'k.
fn literal(&cx: Domain!['k], text: Span['k]) -> Option[Span['k]] {
    let text = text.trim(&cx);
    if text.len() < 2usize { return Option::None; }
    let q = byte(&cx, text, 0usize);
    if (q == b'\'' || q == b'"') && byte(&cx, text, text.len() - 1usize) == q {
        Option::Some.(text.slice(1usize, text.len() - 1usize))
    } else { Option::None }
}

forall 'k.
fn resolve(&cx: Domain!['k], site: ArenaMap[Span['k], TomlValue['k], 'k],
    collections: ArenaMap[Span['k], TomlValue['k], 'k], page: Page['k], bindings: ArenaVec[Binding['k], 'k],
    expr: Span['k], content: Span['k]) -> Option[Span['k]] {
    let expr = expr.trim(&cx);
    if expr.is(&cx, "content") || expr.is(&cx, "content | safe") { return Option::Some.(content); }
    if expr.ends_with(&cx, lit(&cx, " | safe")) {
        let source = expr.slice(0usize, expr.len() - 7usize).trim(&cx);
        return match lookup(&cx, site, collections, page, bindings, source) {
            Option::Some(value) => scalar(&cx, value),
            Option::None => Option::None,
        };
    }
    if expr.ends_with(&cx, lit(&cx, " | absolute_url")) {
        let source = expr.slice(0usize, expr.len() - 15usize).trim(&cx);
        let target = match literal(&cx, source) {
            Option::Some(value) => value,
            Option::None => match lookup(&cx, site, collections, page, bindings, source) {
                Option::Some(value) => match scalar(&cx, value) {
                    Option::Some(text) => text,
                    Option::None => return Option::None,
                },
                Option::None => return Option::None,
            },
        };
        let origin = match string_field(&cx, site, "origin") {
            Option::Some(value) => value,
            Option::None => return Option::None,
        };
        if origin.is_empty() { return Option::None; }
        let base = match string_field(&cx, site, "base_path") {
            Option::Some(path) => path,
            Option::None => lit(&cx, ""),
        };
        return Option::Some.(absolute(&cx, origin, base, target));
    }
    if expr.ends_with(&cx, lit(&cx, " | url")) {
        let source = expr.slice(0usize, expr.len() - 6usize).trim(&cx);
        let target = match literal(&cx, source) {
            Option::Some(value) => value,
            Option::None => match lookup(&cx, site, collections, page, bindings, source) {
                Option::Some(value) => match scalar(&cx, value) {
                    Option::Some(text) => text,
                    Option::None => return Option::None,
                },
                Option::None => return Option::None,
            },
        };
        let base = match string_field(&cx, site, "base_path") {
            Option::Some(path) => path,
            Option::None => lit(&cx, ""),
        };
        return Option::Some.(prefix(&cx, base, target));
    }
    match expr.find(&cx, lit(&cx, " or "), 0usize) {
        Option::Some(at) => {
            let left = expr.slice(0usize, at).trim(&cx);
            match lookup(&cx, site, collections, page, bindings, left) {
                Option::Some(v) => match scalar(&cx, v) {
                    Option::Some(s) => if !s.is_empty() { return Option::Some.(s); },
                    Option::None => (),
                },
                Option::None => (),
            }
            literal(&cx, expr.slice(at + 4usize, expr.len()))
        },
        Option::None => match lookup(&cx, site, collections, page, bindings, expr) {
            Option::None => Option::None,
            Option::Some(v) => scalar(&cx, v),
        },
    }
}

forall 'k.
fn truth(&cx: Domain!['k], site: ArenaMap[Span['k], TomlValue['k], 'k],
    collections: ArenaMap[Span['k], TomlValue['k], 'k], page: Page['k], bindings: ArenaVec[Binding['k], 'k],
    expr: Span['k], content: Span['k]) -> bool {
    let expr = expr.trim(&cx);
    match expr.find(&cx, lit(&cx, " == "), 0usize) {
        Option::Some(at) => {
            let left = resolve(&cx, site, collections, page, bindings, expr.slice(0usize, at), content);
            let right = literal(&cx, expr.slice(at + 4usize, expr.len()));
            match left {
                Option::None => false,
                Option::Some(a) => match right {
                    Option::None => false,
                    Option::Some(b) => a.eq(&cx, b),
                },
            }
        },
        Option::None => {
            match lookup(&cx, site, collections, page, bindings, expr) {
                Option::Some(value) => match value {
                    TomlValue::Array(items) => return items.len(&cx) > 0usize,
                    TomlValue::Table(fields) => return fields.len(&cx) > 0usize,
                    _ => (),
                },
                Option::None => (),
            }
            match resolve(&cx, site, collections, page, bindings, expr, content) {
                Option::None => false,
                Option::Some(s) => !s.is_empty() && !s.is(&cx, "false") && !s.is(&cx, "0"),
            }
        },
    }
}

forall 'k.
fn escape_markup(&cx: Domain!['k], out: Buffer!, text: Span['k]) -> Buffer! {
    var out = out;
    var i = 0usize;
    while i < text.len() {
        let c = byte(&cx, text, i);
        out = if c == b'&' { out.push_static("&amp;") }
            else if c == b'<' { out.push_static("&lt;") }
            else if c == b'>' { out.push_static("&gt;") }
            else if c == b'"' { out.push_static("&quot;") }
            else if c == b'\'' { out.push_static("&#39;") }
            else { out.push_byte(c) };
        i = i + 1usize;
    }
    out
}

fn hex_digit(n: u8) -> u8 { if n < 10u8 { b'0' + n } else { b'a' + n - 10u8 } }

forall 'k.
fn escape_json(&cx: Domain!['k], out: Buffer!, text: Span['k]) -> Buffer! {
    var out = out;
    var i = 0usize;
    while i < text.len() {
        let c = byte(&cx, text, i);
        out = if c == b'"' { out.push_static("\\\"") }
            else if c == b'\\' { out.push_static("\\\\") }
            else if c == b'\n' { out.push_static("\\n") }
            else if c == b'\r' { out.push_static("\\r") }
            else if c == b'\t' { out.push_static("\\t") }
            else if c == 8u8 { out.push_static("\\b") }
            else if c == 12u8 { out.push_static("\\f") }
            else if c < 32u8 { out.push_static("\\u00").push_byte(hex_digit(c / 16u8)).push_byte(hex_digit(c % 16u8)) }
            else { out.push_byte(c) };
        i = i + 1usize;
    }
    out
}

forall 'k.
fn json_value(&cx: Domain!['k], out: Buffer!, value: TomlValue['k], depth: usize)
    -> Result[Buffer!, Span['k]] {
    if depth >= 64usize {
        out.destroy(); return Result::Err.(lit(&cx, "JSON value nested too deeply"));
    }
    match value {
        TomlValue::String(text) => Result::Ok.(escape_json(&cx, out.push_byte(b'"'), text).push_byte(b'"')),
        TomlValue::Integer(number) => Result::Ok.(out.push_i64(number)),
        TomlValue::Float(number) => {
            if !number.is_finite() {
                out.destroy(); return Result::Err.(lit(&cx, "JSON cannot represent NaN or infinity"));
            }
            Result::Ok.(f"{number}".write(out))
        },
        TomlValue::Boolean(flag) => Result::Ok.(out.push_static(if flag { "true" } else { "false" })),
        TomlValue::Datetime(date) => Result::Ok.(escape_json(&cx, out.push_byte(b'"'), date.text).push_byte(b'"')),
        TomlValue::Array(items) => {
            var out = out.push_byte(b'[');
            var i = 0usize;
            while i < items.len(&cx) {
                if i > 0usize { out = out.push_byte(b','); }
                out = match json_value(&cx, out, items.at(&cx, i), depth + 1usize) {
                    Result::Ok(next) => next,
                    Result::Err(message) => return Result::Err.(message),
                };
                i = i + 1usize;
            }
            Result::Ok.(out.push_byte(b']'))
        },
        TomlValue::Table(table) => {
            let keys = ArenaVec::new(&cx);
            var i = 0usize;
            while i < table.positions(&cx) {
                match table.key_at(&cx, i) {
                    Option::Some(key) => keys.push(&cx, key),
                    Option::None => (),
                }
                i = i + 1usize;
            }
            keys.sort_by(&cx, |&cx, a, b| a.cmp(&cx, b));
            var out = out.push_byte(b'{');
            i = 0usize;
            while i < keys.len(&cx) {
                let key = keys.at(&cx, i);
                if i > 0usize { out = out.push_byte(b','); }
                out = escape_json(&cx, out.push_byte(b'"'), key).push_static("\":");
                let field = match table.get(&cx, key) {
                    Option::Some(found) => found,
                    Option::None => { out.destroy(); return Result::Err.(lit(&cx, "JSON table key disappeared")); },
                };
                out = match json_value(&cx, out, field, depth + 1usize) {
                    Result::Ok(next) => next,
                    Result::Err(message) => return Result::Err.(message),
                };
                i = i + 1usize;
            }
            Result::Ok.(out.push_byte(b'}'))
        },
    }
}

forall 'k.
fn valid_xml(&cx: Domain!['k], text: Span['k]) -> bool {
    var i = 0usize;
    while i < text.len() {
        let c = byte(&cx, text, i);
        if !valid_xml_byte(c) { return false; }
        i = i + 1usize;
    }
    true
}

fn valid_xml_byte(c: u8) -> bool { c >= 32u8 || c == b'\t' || c == b'\n' || c == b'\r' }

forall 'k.
fn escape_value(&cx: Domain!['k], out: Buffer!, value: Span['k], format: TemplateFormat) -> Buffer! {
    match format {
        TemplateFormat::Html => escape_markup(&cx, out, value),
        TemplateFormat::Xml => escape_markup(&cx, out, value),
        TemplateFormat::Json => escape_json(&cx, out, value),
        TemplateFormat::Text => out.push_bytes(&cx, value),
    }
}

fn xml_format(format: TemplateFormat) -> bool {
    match format { TemplateFormat::Xml => true, _ => false }
}

forall 'k.
fn format_extension(&cx: Domain!['k], format: TemplateFormat) -> Span['k] {
    lit(&cx, match format {
        TemplateFormat::Html => ".html",
        TemplateFormat::Xml => ".xml",
        TemplateFormat::Json => ".json",
        TemplateFormat::Text => ".txt",
    })
}

forall 'k.
fn valid_name(&cx: Domain!['k], name: Span['k]) -> bool {
    if name.is_empty() || name.is(&cx, "site") || name.is(&cx, "page") || name.is(&cx, "collections") || name.is(&cx, "content") {
        return false;
    }
    var i = 0usize;
    while i < name.len() {
        let c = byte(&cx, name, i);
        let letter = (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') || c == b'_';
        let digit = c >= b'0' && c <= b'9';
        if !letter && (i == 0usize || !digit) { return false; }
        i = i + 1usize;
    }
    true
}

forall 'k.
fn include_name(&cx: Domain!['k], name: Span['k]) -> bool {
    if name.is_empty() || byte(&cx, name, 0usize) == b'/' { return false; }
    var start = 0usize;
    var i = 0usize;
    while i <= name.len() {
        if i == name.len() || byte(&cx, name, i) == b'/' {
            let part = name.slice(start, i);
            if part.is_empty() || part.is(&cx, ".") || part.is(&cx, "..") { return false; }
            start = i + 1usize;
        } else if byte(&cx, name, i) == b'\\' || byte(&cx, name, i) == b'"'
            || byte(&cx, name, i) == b'\'' || byte(&cx, name, i) < 32u8 { return false; }
        i = i + 1usize;
    }
    true
}

forall 'k.
fn include_error(&cx: Domain!['k], name: Span['k], detail: Slice[u8, 'static]) -> Span['k] {
    Buffer!::new().push_static("include ").push_bytes(&cx, name).push_static(": ").push_static(detail).save(&cx)
}

forall 'k.
fn include_source(&cx: Domain!['k], root: Span['k], name: Span['k]) -> Result[Span['k], Span['k]] {
    let base = match canonicalize(&cx, root) {
        Result::Ok(path) => path.save(&cx),
        Result::Err(e) => return Result::Err.(include_error(&cx, name, "cannot resolve layouts directory")),
    };
    let requested = Buffer!::new().push_bytes(&cx, root).push_static("/").push_bytes(&cx, name).save(&cx);
    let actual = match canonicalize(&cx, requested) {
        Result::Ok(path) => path.save(&cx),
        Result::Err(e) => return Result::Err.(include_error(&cx, name, "cannot read file")),
    };
    let prefix = Buffer!::new().push_bytes(&cx, base).push_static("/").save(&cx);
    if !actual.starts_with(&cx, prefix) {
        return Result::Err.(include_error(&cx, name, "path escapes layouts directory"));
    }
    match read_to_arena(&cx, actual) {
        Result::Ok(source) => Result::Ok.(source),
        Result::Err(e) => Result::Err.(include_error(&cx, name, "cannot read file")),
    }
}

forall 'k.
fn query_value(&cx: Domain!['k], site: ArenaMap[Span['k], TomlValue['k], 'k],
    collections: ArenaMap[Span['k], TomlValue['k], 'k], page: Page['k],
    bindings: ArenaVec[Binding['k], 'k], text: Span['k]) -> Option[Span['k]] {
    match literal(&cx, text) {
        Option::Some(value) => Option::Some.(value),
        Option::None => match lookup(&cx, site, collections, page, bindings, text.trim(&cx)) {
            Option::Some(value) => scalar(&cx, value),
            Option::None => Option::None,
        },
    }
}

forall 'k.
fn query_array(&cx: Domain!['k], site: ArenaMap[Span['k], TomlValue['k], 'k],
    collections: ArenaMap[Span['k], TomlValue['k], 'k], page: Page['k],
    bindings: ArenaVec[Binding['k], 'k], expression: Span['k]) -> Result[ArenaVec[TomlValue['k], 'k], Span['k]] {
    let first_pipe = match expression.find_byte(&cx, b'|', 0usize) {
        Option::Some(at) => at,
        Option::None => expression.len(),
    };
    let source = expression.slice(0usize, first_pipe).trim(&cx);
    var values = match lookup(&cx, site, collections, page, bindings, source) {
        Option::Some(value) => match value.as_array() {
            Option::Some(array) => array,
            Option::None => return Result::Err.(source),
        },
        Option::None => return Result::Err.(source),
    };
    var pos = first_pipe;
    while pos < expression.len() {
        let start = pos + 1usize;
        let end = match expression.find_byte(&cx, b'|', start) {
            Option::Some(at) => at,
            Option::None => expression.len(),
        };
        let filter = expression.slice(start, end).trim(&cx);
        let colon = match filter.find_byte(&cx, b':', 0usize) {
            Option::Some(at) => at,
            Option::None => return Result::Err.(filter),
        };
        let operation = filter.slice(0usize, colon).trim(&cx);
        let arguments = filter.slice(colon + 1usize, filter.len()).trim(&cx);
        if operation.is(&cx, "children_of") {
            let parent = match query_value(&cx, site, collections, page, bindings, arguments) {
                Option::Some(value) => value,
                Option::None => return Result::Err.(filter),
            };
            let result = ArenaVec::new(&cx);
            var i = 0usize;
            while i < values.len(&cx) {
                let value = values.at(&cx, i);
                let table = match value.as_table() {
                    Option::Some(table) => table,
                    Option::None => return Result::Err.(filter),
                };
                var matches = false;
                match table.get(&cx, lit(&cx, "parent")) {
                    Option::Some(field) => match field.as_string() {
                        Option::Some(url) => { matches = url.eq(&cx, parent); },
                        Option::None => return Result::Err.(filter),
                    },
                    Option::None => (),
                }
                match table.get(&cx, lit(&cx, "parents")) {
                    Option::Some(field) => match field.as_array() {
                        Option::Some(parents) => {
                            var j = 0usize;
                            while j < parents.len(&cx) {
                                match parents.at(&cx, j).as_string() {
                                    Option::Some(url) => if url.eq(&cx, parent) { matches = true; },
                                    Option::None => return Result::Err.(filter),
                                }
                                j = j + 1usize;
                            }
                        },
                        Option::None => return Result::Err.(filter),
                    },
                    Option::None => (),
                }
                if matches { result.push(&cx, value); }
                i = i + 1usize;
            }
            values = result;
        } else if operation.is(&cx, "where") || operation.is(&cx, "contains")
            || operation.is(&cx, "group_by") || operation.is(&cx, "sort_by") {
            let comma = arguments.find_byte(&cx, b',', 0usize);
            if operation.is(&cx, "group_by") {
                match comma { Option::Some(_) => return Result::Err.(filter), Option::None => (), }
            }
            let field_text = match comma {
                Option::Some(at) => arguments.slice(0usize, at).trim(&cx),
                Option::None => arguments,
            };
            let field_name = match literal(&cx, field_text) {
                Option::Some(name) => name,
                Option::None => return Result::Err.(filter),
            };
            if field_name.is_empty() { return Result::Err.(filter); }
            if operation.is(&cx, "sort_by") {
                let descending = match comma {
                    Option::None => false,
                    Option::Some(at) => match literal(&cx, arguments.slice(at + 1usize, arguments.len())) {
                        Option::Some(order) => if order.is(&cx, "desc") { true }
                            else if order.is(&cx, "asc") { false }
                            else { return Result::Err.(filter); },
                        Option::None => return Result::Err.(filter),
                    },
                };
                values = match sort_records(&cx, values, field_name, descending) {
                    Result::Ok(sorted) => sorted,
                    Result::Err(message) => return Result::Err.(Buffer!::new().push_bytes(&cx, filter)
                        .push_static(": ").push_static(message).save(&cx)),
                };
            } else if operation.is(&cx, "where") || operation.is(&cx, "contains") {
                let comma_at = match comma {
                    Option::Some(at) => at,
                    Option::None => return Result::Err.(filter),
                };
                let target = match query_value(&cx, site, collections, page, bindings, arguments.slice(comma_at + 1usize, arguments.len())) {
                    Option::Some(value) => value,
                    Option::None => return Result::Err.(filter),
                };
                let filtered = if operation.is(&cx, "contains") {
                    filter_contains(&cx, values, field_name, target)
                } else { filter_records(&cx, values, field_name, target) };
                values = match filtered {
                    Result::Ok(selected) => selected,
                    Result::Err(message) => return Result::Err.(Buffer!::new().push_bytes(&cx, filter)
                        .push_static(": ").push_static(message).save(&cx)),
                };
            } else {
                let groups: ArenaVec[Group['k], 'k] = ArenaVec::new(&cx);
                var i = 0usize;
                while i < values.len(&cx) {
                    let value = values.at(&cx, i);
                    let table = match value.as_table() {
                        Option::Some(table) => table,
                        Option::None => return Result::Err.(filter),
                    };
                    let key = match table.get(&cx, field_name) {
                        Option::Some(field) => match scalar(&cx, field) {
                            Option::Some(text) => text,
                            Option::None => return Result::Err.(filter),
                        },
                        Option::None => return Result::Err.(filter),
                    };
                    var found = false;
                    var j = 0usize;
                    while j < groups.len(&cx) && !found {
                        let group = groups.at(&cx, j);
                        if group.key.eq(&cx, key) { group.items.push(&cx, value); found = true; }
                        j = j + 1usize;
                    }
                    if !found {
                        let items = ArenaVec::new(&cx);
                        items.push(&cx, value);
                        groups.push(&cx, Group.{ key, items });
                    }
                    i = i + 1usize;
                }
                let result = ArenaVec::new(&cx);
                var j = 0usize;
                while j < groups.len(&cx) {
                    let group = groups.at(&cx, j);
                    let record = ArenaMap::new(&cx);
                    record.insert(&cx, lit(&cx, "key"), TomlValue::String.(group.key));
                    record.insert(&cx, lit(&cx, "items"), TomlValue::Array.(group.items));
                    result.push(&cx, TomlValue::Table.(record));
                    j = j + 1usize;
                }
                values = result;
            }
        } else { return Result::Err.(filter); }
        pos = end;
    }
    Result::Ok.(values)
}

// The start and end of the endfor tag matching a for whose body starts at
// `start`. Nested for blocks increase the depth; if blocks do not affect it.
forall 'k.
fn find_endfor(&cx: Domain!['k], source: Span['k], start: usize) -> Option[(usize, usize)] {
    var depth = 1usize;
    var pos = start;
    while pos < source.len() {
        let opening = match source.find(&cx, lit(&cx, "{%"), pos) {
            Option::Some(at) => at,
            Option::None => return Option::None,
        };
        let close = match source.find(&cx, lit(&cx, "%}"), opening + 2usize) {
            Option::Some(at) => at,
            Option::None => return Option::None,
        };
        let directive = source.slice(opening + 2usize, close).trim(&cx);
        if starts(&cx, directive, "for ") { depth = depth + 1usize; }
        else if directive.is(&cx, "endfor") {
            depth = depth - 1usize;
            if depth == 0usize { return Option::Some.((opening, close + 2usize)); }
        }
        pos = close + 2usize;
    }
    Option::None
}

// The template language has escaped variables, an explicit safe filter for
// rendered content, nested if/else/endif and for/endfor blocks. Unknown substitutions
// and malformed directives fail the build.
forall 'k.
fn render_scope(&cx: Domain!['k], site: ArenaMap[Span['k], TomlValue['k], 'k],
    collections: ArenaMap[Span['k], TomlValue['k], 'k], page: Page['k], bindings: ArenaVec[Binding['k], 'k],
    includes: ArenaVec[Span['k], 'k], root: Span['k], file: Span['k], source: Span['k], content: Span['k],
    format: TemplateFormat, first_line: usize, first_column: usize, depth: usize) -> Result[Buffer!, Span['k]] {
    if depth >= 64usize { return Result::Err.(template_error(&cx, file, source, 0usize,
        first_line, first_column, lit(&cx, "template scopes nested too deeply"))); }
    var out = Buffer!::new();
    let xml = xml_format(format);
    let stack = ArenaVec::new(&cx);
    var active = true;
    var pos = 0usize;
    while pos < source.len() {
        if byte(&cx, source, pos) == b'{' && byte(&cx, source, pos + 1usize) == b'{' {
            match source.find(&cx, lit(&cx, "}}"), pos + 2usize) {
                Option::None => { out.destroy(); return Result::Err.(template_error(&cx, file, source, pos,
                    first_line, first_column, lit(&cx, "unclosed variable"))); },
                Option::Some(end) => {
                    if active {
                        let expr = source.slice(pos + 2usize, end).trim(&cx);
                        if expr.ends_with(&cx, lit(&cx, " | absolute_url"))
                            || expr.ends_with(&cx, lit(&cx, " | absolute_url | json")) {
                            let origin = match string_field(&cx, site, "origin") {
                                Option::Some(value) => value,
                                Option::None => lit(&cx, ""),
                            };
                            if origin.is_empty() {
                                out.destroy(); return Result::Err.(template_error(&cx, file, source, pos,
                                    first_line, first_column, lit(&cx, "absolute_url requires origin in krayon.toml")));
                            }
                        }
                        if expr.ends_with(&cx, lit(&cx, " | json")) {
                            let json = match format { TemplateFormat::Json => true, _ => false };
                            if !json {
                                out.destroy(); return Result::Err.(template_error(&cx, file, source, pos,
                                    first_line, first_column, lit(&cx, "json filter requires a JSON template")));
                            }
                            let field = expr.slice(0usize, expr.len() - 7usize).trim(&cx);
                            let value = match literal(&cx, field) {
                                Option::Some(text) => Option::Some.(TomlValue::String.(text)),
                                Option::None => if field.ends_with(&cx, lit(&cx, " | url"))
                                    || field.ends_with(&cx, lit(&cx, " | absolute_url")) {
                                    match resolve(&cx, site, collections, page, bindings, field, content) {
                                        Option::Some(text) => Option::Some.(TomlValue::String.(text)),
                                        Option::None => Option::None,
                                    }
                                } else { lookup(&cx, site, collections, page, bindings, field) },
                            };
                            let value = match value {
                                Option::Some(found) => found,
                                Option::None => { out.destroy(); return Result::Err.(template_error(&cx, file, source, pos,
                                    first_line, first_column, expr)); },
                            };
                            out = match json_value(&cx, out, value, 0usize) {
                                Result::Ok(next) => next,
                                Result::Err(message) => return Result::Err.(template_error(&cx, file, source, pos,
                                    first_line, first_column, message)),
                            };
                        } else {
                            match resolve(&cx, site, collections, page, bindings, expr, content) {
                                Option::None => { out.destroy(); return Result::Err.(template_error(&cx, file, source, pos,
                                    first_line, first_column, expr)); },
                                Option::Some(value) => {
                                    if expr.ends_with(&cx, lit(&cx, " | safe")) { out = out.push_bytes(&cx, value); }
                                    else {
                                        if xml && !valid_xml(&cx, value) {
                                            out.destroy(); return Result::Err.(template_error(&cx, file, source, pos,
                                                first_line, first_column, lit(&cx, "XML value contains an invalid control character")));
                                        }
                                        out = escape_value(&cx, out, value, format);
                                    }
                                },
                            }
                        }
                    }
                    pos = end + 2usize;
                },
            }
        } else if byte(&cx, source, pos) == b'{' && byte(&cx, source, pos + 1usize) == b'%' {
            match source.find(&cx, lit(&cx, "%}"), pos + 2usize) {
                Option::None => { out.destroy(); return Result::Err.(template_error(&cx, file, source, pos,
                    first_line, first_column, lit(&cx, "unclosed directive"))); },
                Option::Some(end) => {
                    let directive = source.slice(pos + 2usize, end).trim(&cx);
                    var after = end + 2usize;
                    if starts(&cx, directive, "if ") {
                        let matched = active && truth(&cx, site, collections, page, bindings, directive.slice(3usize, directive.len()), content);
                        stack.push(&cx, Frame.{ parent: active, matched, else_seen: false, opening: pos });
                        active = matched;
                    } else if directive.is(&cx, "else") {
                        match stack.pop(&cx) {
                            Option::None => { out.destroy(); return Result::Err.(template_error(&cx, file, source, pos,
                                first_line, first_column, lit(&cx, "else without if"))); },
                            Option::Some(frame) => {
                                if frame.else_seen { out.destroy(); return Result::Err.(template_error(&cx, file, source, pos,
                                    first_line, first_column, lit(&cx, "duplicate else"))); }
                                active = frame.parent && !frame.matched;
                                stack.push(&cx, Frame.{ parent: frame.parent, matched: frame.matched, else_seen: true, opening: frame.opening });
                            },
                        }
                    } else if directive.is(&cx, "endif") {
                        match stack.pop(&cx) {
                            Option::None => { out.destroy(); return Result::Err.(template_error(&cx, file, source, pos,
                                first_line, first_column, lit(&cx, "endif without if"))); },
                            Option::Some(frame) => { active = frame.parent; },
                        }
                    } else if starts(&cx, directive, "for ") {
                        let clause = directive.slice(4usize, directive.len());
                        let separator = match clause.find(&cx, lit(&cx, " in "), 0usize) {
                            Option::Some(at) => at,
                            Option::None => { out.destroy(); return Result::Err.(template_error(&cx, file, source, pos,
                                first_line, first_column, directive)); },
                        };
                        let name = clause.slice(0usize, separator).trim(&cx);
                        let items = clause.slice(separator + 4usize, clause.len()).trim(&cx);
                        if !valid_name(&cx, name) { out.destroy(); return Result::Err.(template_error(&cx, file, source, pos,
                            first_line, first_column, directive)); }
                        let (body_end, tag_end) = match find_endfor(&cx, source, after) {
                            Option::Some(positions) => positions,
                            Option::None => { out.destroy(); return Result::Err.(template_error(&cx, file, source, pos,
                                first_line, first_column, lit(&cx, "unclosed for"))); },
                        };
                        if active {
                            let values = match query_array(&cx, site, collections, page, bindings, items) {
                                Result::Ok(array) => array,
                                Result::Err(message) => { out.destroy(); return Result::Err.(template_error(&cx, file, source, pos,
                                    first_line, first_column, message)); },
                            };
                            let (line, column) = position(&cx, source, after, first_line, first_column);
                            var i = 0usize;
                            while i < values.len(&cx) {
                                let loop_data = ArenaMap::new(&cx);
                                let first = loop_data.insert(&cx, lit(&cx, "first"), TomlValue::Boolean.(i == 0usize));
                                let last = loop_data.insert(&cx, lit(&cx, "last"), TomlValue::Boolean.(i + 1usize == values.len(&cx)));
                                let index = loop_data.insert(&cx, lit(&cx, "index"), TomlValue::Integer.((i + 1usize) as i64));
                                bindings.push(&cx, Binding.{ name: lit(&cx, "loop"), value: TomlValue::Table.(loop_data) });
                                bindings.push(&cx, Binding.{ name, value: values.at(&cx, i) });
                                let part = render_scope(&cx, site, collections, page, bindings, includes, root, file,
                                    source.slice(after, body_end), content, format, line, column, depth + 1usize);
                                let popped = bindings.pop(&cx);
                                let popped_loop = bindings.pop(&cx);
                                match part {
                                    Result::Ok(html) => { out = out.push_buffer(html); },
                                    Result::Err(message) => { out.destroy(); return Result::Err.(message); },
                                }
                                i = i + 1usize;
                            }
                        }
                        after = tag_end;
                    } else if starts(&cx, directive, "include ") {
                        let operand = directive.slice(8usize, directive.len()).trim(&cx);
                        let name = match literal(&cx, operand) {
                            Option::Some(path) => path,
                            Option::None => { out.destroy(); return Result::Err.(template_error(&cx, file, source, pos,
                                first_line, first_column, directive)); },
                        };
                        if !name.ends_with(&cx, format_extension(&cx, format)) {
                            out.destroy(); return Result::Err.(template_error(&cx, file, source, pos,
                                first_line, first_column, include_error(&cx, name, "wrong suffix for template format")));
                        }
                        if !include_name(&cx, name) {
                            out.destroy(); return Result::Err.(template_error(&cx, file, source, pos,
                                first_line, first_column, include_error(&cx, name, "unsafe path")));
                        }
                        if active {
                            var i = 0usize;
                            while i < includes.len(&cx) {
                                if includes.at(&cx, i).eq(&cx, name) {
                                    out.destroy(); return Result::Err.(template_error(&cx, file, source, pos,
                                        first_line, first_column, include_error(&cx, name, "cyclic include")));
                                }
                                i = i + 1usize;
                            }
                            let partial = match include_source(&cx, root, name) {
                                Result::Ok(source) => source,
                                Result::Err(message) => { out.destroy(); return Result::Err.(template_error(&cx, file, source, pos,
                                    first_line, first_column, message)); },
                            };
                            includes.push(&cx, name);
                            let child_file = Buffer!::new().push_bytes(&cx, root).push_byte(b'/').push_bytes(&cx, name).save(&cx);
                            let part = render_scope(&cx, site, collections, page, bindings, includes, root, child_file,
                                partial, content, format, 1usize, 1usize, depth + 1usize);
                            let popped = includes.pop(&cx);
                            match part {
                                Result::Ok(html) => { out = out.push_buffer(html); },
                                Result::Err(message) => {
                                    out.destroy();
                                    return Result::Err.(template_error(&cx, file, source, pos, first_line, first_column,
                                        Buffer!::new().push_static("include ").push_bytes(&cx, message).save(&cx)));
                                },
                            }
                        }
                    } else if directive.is(&cx, "endfor") {
                        out.destroy(); return Result::Err.(template_error(&cx, file, source, pos,
                            first_line, first_column, lit(&cx, "endfor without for")));
                    } else { out.destroy(); return Result::Err.(template_error(&cx, file, source, pos,
                        first_line, first_column, directive)); }
                    pos = after;
                },
            }
        } else {
            if active {
                if xml && !valid_xml_byte(byte(&cx, source, pos)) {
                    out.destroy(); return Result::Err.(template_error(&cx, file, source, pos,
                        first_line, first_column, lit(&cx, "XML template contains an invalid control character")));
                }
                out = out.push_byte(byte(&cx, source, pos));
            }
            pos = pos + 1usize;
        }
    }
    if stack.len(&cx) != 0usize {
        let opening = stack.at(&cx, stack.len(&cx) - 1usize).opening;
        out.destroy(); Result::Err.(template_error(&cx, file, source, opening,
            first_line, first_column, lit(&cx, "unclosed if")))
    }
    else { Result::Ok.(out) }
}

forall 'k.
fn template(&cx: Domain!['k], site: ArenaMap[Span['k], TomlValue['k], 'k],
    collections: ArenaMap[Span['k], TomlValue['k], 'k], page: Page['k],
    root: Span['k], file: Span['k], source: Span['k], content: Span['k], first_line: usize,
    format: TemplateFormat) -> Result[Buffer!, Span['k]] {
    render_scope(&cx, site, collections, page, ArenaVec::new(&cx), ArenaVec::new(&cx),
        root, file, source, content, format, first_line, 1usize, 0usize)
}
