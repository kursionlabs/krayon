use std::arena::Domain!;
use std::option::{Option, Result};
use std::str::Str;
use std::slice::Slice;
use std::utf8::decode;

exposed struct Error {
    offset: usize,
    message: Str['static],
}

fn fail(at: usize, message: Str['static]) -> Error { Error.{ offset: at, message } }

forall 'k.
fn byte(&cx: Domain!['k], text: Str['k], i: usize) -> u8 { text.byte_or_zero(&cx, i) }

forall 'k.
fn whitespace(&cx: Domain!['k], text: Str['k], start: usize) -> usize {
    var i = start;
    while i < text.len() && (byte(&cx, text, i) == b' ' || byte(&cx, text, i) == b'\t'
        || byte(&cx, text, i) == b'\r' || byte(&cx, text, i) == b'\n') {
        i = i + 1usize;
    }
    i
}

fn hex(c: u8) -> bool {
    (c >= b'0' && c <= b'9') || (c >= b'a' && c <= b'f') || (c >= b'A' && c <= b'F')
}

fn hex_value(c: u8) -> u32 {
    if c >= b'0' && c <= b'9' { (c - b'0') as u32 }
    else if c >= b'a' && c <= b'f' { (c - b'a' + 10u8) as u32 }
    else { (c - b'A' + 10u8) as u32 }
}

forall 'k.
fn unicode_escape(&cx: Domain!['k], text: Str['k], start: usize) -> Result[(u32, usize), Error] {
    if start + 4usize > text.len() { return Result::Err.(fail(start, "incomplete Unicode escape")); }
    var code = 0u32;
    var i = start;
    while i < start + 4usize {
        let c = byte(&cx, text, i);
        if !hex(c) { return Result::Err.(fail(i, "invalid Unicode escape")); }
        code = code * 16u32 + hex_value(c);
        i = i + 1usize;
    }
    Result::Ok.((code, i))
}

forall 'k.
fn string(&cx: Domain!['k], text: Str['k], start: usize) -> Result[usize, Error] {
    var i = start + 1usize;
    while i < text.len() {
        let c = byte(&cx, text, i);
        if c == b'"' { return Result::Ok.(i + 1usize); }
        if c < 32u8 { return Result::Err.(fail(i, "unescaped control character in string")); }
        if c == b'\\' {
            i = i + 1usize;
            if i >= text.len() { return Result::Err.(fail(i, "incomplete string escape")); }
            let escaped = byte(&cx, text, i);
            if escaped == b'u' {
                let (code, next) = unicode_escape(&cx, text, i + 1usize)?;
                i = next;
                if code >= 55296u32 && code <= 56319u32 {
                    if i + 2usize > text.len() || byte(&cx, text, i) != b'\\' || byte(&cx, text, i + 1usize) != b'u' {
                        return Result::Err.(fail(i, "high surrogate requires a low surrogate"));
                    }
                    let (low, next) = unicode_escape(&cx, text, i + 2usize)?;
                    if low < 56320u32 || low > 57343u32 {
                        return Result::Err.(fail(i + 2usize, "invalid low surrogate"));
                    }
                    i = next;
                } else if code >= 56320u32 && code <= 57343u32 {
                    return Result::Err.(fail(i - 4usize, "low surrogate without high surrogate"));
                }
            } else {
                if escaped != b'"' && escaped != b'\\' && escaped != b'/' && escaped != b'b'
                    && escaped != b'f' && escaped != b'n' && escaped != b'r' && escaped != b't' {
                    return Result::Err.(fail(i, "invalid string escape"));
                }
                i = i + 1usize;
            }
        } else {
            if c >= 128u8 {
                match decode(&cx, text, i) {
                    Some(pair) => { let (code, next) = pair; i = next; },
                    None => return Result::Err.(fail(i, "invalid UTF-8 in string")),
                }
            } else { i = i + 1usize; }
        }
    }
    Result::Err.(fail(i, "unterminated string"))
}

fn digit(c: u8) -> bool { c >= b'0' && c <= b'9' }

forall 'k.
fn number(&cx: Domain!['k], text: Str['k], start: usize) -> Result[usize, Error] {
    var i = start;
    if byte(&cx, text, i) == b'-' { i = i + 1usize; }
    if i >= text.len() { return Result::Err.(fail(i, "expected digit")); }
    if byte(&cx, text, i) == b'0' { i = i + 1usize; }
    else {
        if byte(&cx, text, i) < b'1' || byte(&cx, text, i) > b'9' {
            return Result::Err.(fail(i, "expected digit"));
        }
        while i < text.len() && digit(byte(&cx, text, i)) { i = i + 1usize; }
    }
    if i < text.len() && byte(&cx, text, i) == b'.' {
        i = i + 1usize;
        if i >= text.len() || !digit(byte(&cx, text, i)) { return Result::Err.(fail(i, "expected fraction digit")); }
        while i < text.len() && digit(byte(&cx, text, i)) { i = i + 1usize; }
    }
    if i < text.len() && (byte(&cx, text, i) == b'e' || byte(&cx, text, i) == b'E') {
        i = i + 1usize;
        if i < text.len() && (byte(&cx, text, i) == b'+' || byte(&cx, text, i) == b'-') { i = i + 1usize; }
        if i >= text.len() || !digit(byte(&cx, text, i)) { return Result::Err.(fail(i, "expected exponent digit")); }
        while i < text.len() && digit(byte(&cx, text, i)) { i = i + 1usize; }
    }
    Result::Ok.(i)
}

forall 'k.
fn keyword(&cx: Domain!['k], text: Str['k], start: usize, expected: Str['static]) -> Result[usize, Error] {
    let expected = Str::from_static(&cx, expected);
    let len = expected.len();
    if start + len > text.len() { return Result::Err.(fail(start, "invalid JSON value")); }
    var i = 0usize;
    while i < len {
        if byte(&cx, text, start + i) != byte(&cx, expected, i) {
            return Result::Err.(fail(start + i, "invalid JSON value"));
        }
        i = i + 1usize;
    }
    Result::Ok.(start + len)
}

forall 'k.
fn value(&cx: Domain!['k], text: Str['k], start: usize, depth: usize) -> Result[usize, Error] {
    var i = whitespace(&cx, text, start);
    if i >= text.len() { return Result::Err.(fail(i, "expected JSON value")); }
    let c = byte(&cx, text, i);
    if c == b'"' { return string(&cx, text, i); }
    if c == b'-' || digit(c) { return number(&cx, text, i); }
    if c == b't' { return keyword(&cx, text, i, "true"); }
    if c == b'f' { return keyword(&cx, text, i, "false"); }
    if c == b'n' { return keyword(&cx, text, i, "null"); }
    if c != b'[' && c != b'{' { return Result::Err.(fail(i, "expected JSON value")); }
    if depth >= 128usize { return Result::Err.(fail(i, "JSON nested too deeply")); }
    let array = c == b'[';
    i = whitespace(&cx, text, i + 1usize);
    if i < text.len() && byte(&cx, text, i) == (if array { b']' } else { b'}' }) {
        return Result::Ok.(i + 1usize);
    }
    while true {
        if array { i = value(&cx, text, i, depth + 1usize)?; }
        else {
            if i >= text.len() || byte(&cx, text, i) != b'"' {
                return Result::Err.(fail(i, "expected object key"));
            }
            i = whitespace(&cx, text, string(&cx, text, i)?);
            if i >= text.len() || byte(&cx, text, i) != b':' {
                return Result::Err.(fail(i, "expected colon after object key"));
            }
            i = value(&cx, text, i + 1usize, depth + 1usize)?;
        }
        i = whitespace(&cx, text, i);
        if i >= text.len() { return Result::Err.(fail(i, "unterminated JSON container")); }
        let separator = byte(&cx, text, i);
        if separator == (if array { b']' } else { b'}' }) { return Result::Ok.(i + 1usize); }
        if separator != b',' { return Result::Err.(fail(i, "expected comma or closing bracket")); }
        i = whitespace(&cx, text, i + 1usize);
        if i < text.len() && byte(&cx, text, i) == (if array { b']' } else { b'}' }) {
            return Result::Err.(fail(i, "trailing comma in JSON"));
        }
    }
    Result::Err.(fail(i, "invalid JSON value"))
}

forall 'k.
fn validate(&cx: Domain!['k], text: Str['k]) -> Result[(), Error] {
    let end = value(&cx, text, 0usize, 0usize)?;
    let end = whitespace(&cx, text, end);
    if end != text.len() { return Result::Err.(fail(end, "extra content after JSON value")); }
    Result::Ok.(())
}
