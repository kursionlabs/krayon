use std::arena::Domain!;
use std::buffer::Buffer!;
use std::collections::arena_map::ArenaMap;
use std::collections::arena_vec::ArenaVec;
use std::option::{Option, Result};
use std::raw::Span;
use std::slice::Slice;
use url::prefix;
use highlight::render_line;

forall 'k.
exposed struct Heading {
    level: usize,
    text: Span['k],
    id: Span['k],
}

forall 'k.
struct LinkContext {
    base: Span['k],
    urls: ArenaMap[Span['k], Span['k], 'k],
    asset_urls: ArenaMap[Span['k], Span['k], 'k],
    fingerprint_assets: bool,
    source: Span['k],
    rendered_source: Span['k],
    segments: Option[ArenaVec[SourceSegment, 'k]],
    track_sources: bool,
}

struct SourceSegment { start: usize, length: usize, original: usize }

forall 'k.
fn empty(&cx: Domain!['k]) -> Span['k] { Span::from_static(&cx, "") }

forall 'k.
fn lit(&cx: Domain!['k], s: Slice[u8, 'static]) -> Span['k] { Span::from_static(&cx, s) }

forall 'k.
fn starts(&cx: Domain!['k], s: Span['k], prefix: Slice[u8, 'static]) -> bool {
    s.starts_with(&cx, lit(&cx, prefix))
}

forall 'k.
fn at(&cx: Domain!['k], s: Span['k], i: usize) -> u8 { s.byte_or_zero(&cx, i) }

forall 'k.
fn next_line(&cx: Domain!['k], source: Span['k], start: usize) -> (Span['k], usize) {
    var i = start;
    while i < source.len() && at(&cx, source, i) != b'\n' { i = i + 1usize; }
    let line = source.slice(start, i).trim_end(&cx);
    (line, if i < source.len() { i + 1usize } else { i })
}

forall 'k.
fn raw_line(&cx: Domain!['k], source: Span['k], start: usize, next: usize) -> Span['k] {
    let end = if at(&cx, source, next - 1usize) == b'\n' { next - 1usize } else { next };
    source.slice(start, end)
}

forall 'k.
fn paragraph_line(&cx: Domain!['k], raw: Span['k], continues: bool) -> (Span['k], bool) {
    let end = if raw.len() > 0usize && at(&cx, raw, raw.len() - 1usize) == b'\r' {
        raw.len() - 1usize
    } else { raw.len() };
    let content = raw.slice(0usize, end).trim_end(&cx);
    if !continues { return (content, false); }
    var spaces = 0usize;
    while spaces < end && at(&cx, raw, end - spaces - 1usize) == b' ' { spaces = spaces + 1usize; }
    if spaces >= 2usize { return (content, true); }
    if spaces == 0usize && content.len() == end {
        var slashes = 0usize;
        while slashes < content.len() && at(&cx, content, content.len() - slashes - 1usize) == b'\\' {
            slashes = slashes + 1usize;
        }
        if slashes % 2usize == 1usize { return (content.slice(0usize, content.len() - 1usize), true); }
    }
    (content, false)
}

forall 'k.
fn paragraph_continues(&cx: Domain!['k], source: Span['k], pos: usize, depth: usize) -> bool {
    if pos >= source.len() { return false; }
    let (line, after) = next_line(&cx, source, pos);
    if line.is_empty() || fence_open(&cx, line).is_some() || thematic_break(&cx, line) ||
        (depth == 0usize && line.is(&cx, "<!-- more -->")) ||
        quote_line(&cx, line).is_some() || starts(&cx, line, "<") ||
        heading_level(&cx, line) > 0usize { return false; }
    match list_marker(&cx, line) {
        Some(parts) => {
            let (indent, content_start, ordered) = parts;
            if indent <= 3usize { return false; }
        },
        None => (),
    }
    if after < source.len() {
        let (following, next) = next_line(&cx, source, after);
        if !indented_code(&cx, line) && table_delimiter(&cx, line, following).is_some() { return false; }
    }
    true
}

forall 'k.
fn source_path(&cx: Domain!['k], source: Span['k], path: Span['k]) -> Option[Span['k]] {
    let absolute = at(&cx, path, 0usize) == b'/';
    let parts: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    if !absolute {
        var i = 0usize;
        var start = 0usize;
        while i < source.len() {
            if at(&cx, source, i) == b'/' {
                parts.push(&cx, source.slice(start, i));
                start = i + 1usize;
            }
            i = i + 1usize;
        }
    }
    var start = if absolute { 1usize } else { 0usize };
    var i = start;
    while i <= path.len() {
        if i == path.len() || at(&cx, path, i) == b'/' {
            let part = path.slice(start, i);
            if part.is(&cx, "..") {
                if parts.len(&cx) == 0usize { return Option::None; }
                let removed = parts.pop(&cx);
            } else if !part.is_empty() && !part.is(&cx, ".") { parts.push(&cx, part); }
            start = i + 1usize;
        }
        i = i + 1usize;
    }
    var key = Buffer!::new();
    i = 0usize;
    while i < parts.len(&cx) {
        if i > 0usize { key = key.push_byte(b'/'); }
        key = key.push_bytes(&cx, parts.at(&cx, i));
        i = i + 1usize;
    }
    Option::Some.(key.save(&cx))
}

forall 'k.
fn source_link(&cx: Domain!['k], links: LinkContext['k], target: Span['k]) -> Span['k] {
    var end = target.len();
    match target.find_byte(&cx, b'?', 0usize) { Option::Some(at) => if at < end { end = at; }, Option::None => (), }
    match target.find_byte(&cx, b'#', 0usize) { Option::Some(at) => if at < end { end = at; }, Option::None => (), }
    let path = target.slice(0usize, end);
    if !path.ends_with(&cx, lit(&cx, ".md")) || starts(&cx, path, "//")
        || path.find(&cx, lit(&cx, "://"), 0usize).is_some() { return asset_link(&cx, links, target); }
    let key = match source_path(&cx, links.source, path) {
        Some(found) => found,
        None => return asset_link(&cx, links, target),
    };
    match links.urls.get(&cx, key) {
        Some(url) => prefix(&cx, links.base,
            Buffer!::new().push_bytes(&cx, url).push_bytes(&cx, target.slice(end, target.len())).save(&cx)),
        None => asset_link(&cx, links, target),
    }
}

forall 'k.
fn asset_link(&cx: Domain!['k], links: LinkContext['k], target: Span['k]) -> Span['k] {
    if !links.fingerprint_assets { return prefix(&cx, links.base, target); }
    var end = target.len();
    match target.find_byte(&cx, b'?', 0usize) { Option::Some(at) => if at < end { end = at; }, Option::None => (), }
    match target.find_byte(&cx, b'#', 0usize) { Option::Some(at) => if at < end { end = at; }, Option::None => (), }
    let path = target.slice(0usize, end);
    if path.is_empty() || starts(&cx, path, "//") || path.find(&cx, lit(&cx, "://"), 0usize).is_some() {
        return prefix(&cx, links.base, target);
    }
    let relative = match source_path(&cx, links.source, path) {
        Some(found) => found,
        None => return prefix(&cx, links.base, target),
    };
    let key = Buffer!::new().push_static("/").push_bytes(&cx, relative).save(&cx);
    match links.asset_urls.get(&cx, key) {
        Some(url) => prefix(&cx, links.base,
            Buffer!::new().push_bytes(&cx, url).push_bytes(&cx, target.slice(end, target.len())).save(&cx)),
        None => prefix(&cx, links.base, target),
    }
}

forall 'k.
fn html_escape(&cx: Domain!['k], out: Buffer!, s: Span['k]) -> Buffer! {
    var out = out;
    var i = 0usize;
    while i < s.len() {
        let c = at(&cx, s, i);
        out = if c == b'&' { out.push_static("&amp;") }
          else if c == b'<' { out.push_static("&lt;") }
          else if c == b'>' { out.push_static("&gt;") }
          else if c == b'"' { out.push_static("&quot;") }
          else { out.push_byte(c) };
        i = i + 1usize;
    }
    out
}

fn ascii_punctuation(c: u8) -> bool {
    (c >= b'!' && c <= b'/') || (c >= b':' && c <= b'@') ||
        (c >= b'[' && c <= b'`') || (c >= b'{' && c <= b'~')
}

forall 'k.
fn escaped_at(&cx: Domain!['k], s: Span['k], index: usize) -> bool {
    var count = 0usize;
    while count < index && at(&cx, s, index - count - 1usize) == b'\\' {
        count = count + 1usize;
    }
    count % 2usize == 1usize
}

forall 'k.
fn find_unescaped(&cx: Domain!['k], s: Span['k], target: u8, start: usize) -> Option[usize] {
    var pos = start;
    while pos < s.len() {
        if at(&cx, s, pos) == target && !escaped_at(&cx, s, pos) { return Option::Some.(pos); }
        pos = pos + 1usize;
    }
    Option::None
}

forall 'k.
fn find_unescaped_strong(&cx: Domain!['k], s: Span['k], start: usize) -> Option[usize] {
    var pos = start;
    while pos + 1usize < s.len() {
        if at(&cx, s, pos) == b'*' && at(&cx, s, pos + 1usize) == b'*' &&
            !escaped_at(&cx, s, pos) { return Option::Some.(pos); }
        pos = pos + 1usize;
    }
    Option::None
}

forall 'k.
fn unescape_punctuation(&cx: Domain!['k], s: Span['k]) -> Span['k] {
    var out = Buffer!::new();
    var pos = 0usize;
    while pos < s.len() {
        if at(&cx, s, pos) == b'\\' && ascii_punctuation(at(&cx, s, pos + 1usize)) {
            out = out.push_byte(at(&cx, s, pos + 1usize));
            pos = pos + 2usize;
        } else {
            out = out.push_byte(at(&cx, s, pos));
            pos = pos + 1usize;
        }
    }
    out.save(&cx)
}

forall 'k.
fn backtick_run(&cx: Domain!['k], s: Span['k], start: usize) -> usize {
    var end = start;
    while at(&cx, s, end) == b'`' { end = end + 1usize; }
    end - start
}

forall 'k.
fn code_close(&cx: Domain!['k], s: Span['k], start: usize, width: usize) -> Option[usize] {
    var pos = start;
    while pos < s.len() {
        if at(&cx, s, pos) == b'`' {
            let run = backtick_run(&cx, s, pos);
            if run == width { return Option::Some.(pos); }
            pos = pos + run;
        } else { pos = pos + 1usize; }
    }
    Option::None
}

forall 'k.
fn code_content(&cx: Domain!['k], s: Span['k]) -> Span['k] {
    if s.len() < 2usize || at(&cx, s, 0usize) != b' ' ||
        at(&cx, s, s.len() - 1usize) != b' ' { return s; }
    var pos = 0usize;
    while pos < s.len() && at(&cx, s, pos) == b' ' { pos = pos + 1usize; }
    if pos == s.len() { s } else { s.slice(1usize, s.len() - 1usize) }
}

forall 'k.
fn original_offset(&cx: Domain!['k], links: LinkContext['k], text: Span['k], index: usize) -> Option[usize] {
    let start = links.rendered_source.address();
    let address = text.address() + index;
    if address < start || address >= start + links.rendered_source.len() { return Option::None; }
    let offset = address - start;
    match links.segments {
        None => Option::Some.(offset),
        Some(segments) => {
            var i = 0usize;
            while i < segments.len(&cx) {
                let segment = segments.at(&cx, i);
                if offset >= segment.start && offset < segment.start + segment.length {
                    return Option::Some.(segment.original + offset - segment.start);
                }
                i = i + 1usize;
            }
            Option::None
        },
    }
}

forall 'k.
fn mark_source(&cx: Domain!['k], out: Buffer!, text: Span['k], index: usize, links: LinkContext['k]) -> Buffer! {
    if !links.track_sources { return out; }
    match original_offset(&cx, links, text, index) {
        Some(offset) => out.push_static("<!--krayon-md-source:").push_usize(offset).push_static("-->"),
        None => out,
    }
}

forall 'k.
fn inline(&cx: Domain!['k], out: Buffer!, s: Span['k], links: LinkContext['k]) -> Buffer! {
    var out = out;
    var i = 0usize;
    while i < s.len() {
        let c = at(&cx, s, i);
        if c == b'\\' && ascii_punctuation(at(&cx, s, i + 1usize)) {
            out = html_escape(&cx, out, s.slice(i + 1usize, i + 2usize));
            i = i + 2usize;
        } else if c == b'`' {
            let width = backtick_run(&cx, s, i);
            match code_close(&cx, s, i + width, width) {
                Some(end) => {
                    out = html_escape(&cx, out.push_static("<code>"),
                        code_content(&cx, s.slice(i + width, end))).push_static("</code>");
                    i = end + width;
                },
                None => { out = out.push_bytes(&cx, s.slice(i, i + width)); i = i + width; },
            }
        } else if c == b'!' && at(&cx, s, i + 1usize) == b'[' {
            match find_unescaped(&cx, s, b']', i + 2usize) {
                Some(end) => {
                    if at(&cx, s, end + 1usize) == b'(' {
                        match find_unescaped(&cx, s, b')', end + 2usize) {
                            Some(close) => {
                                let destination = s.slice(end + 2usize, close).trim(&cx);
                                var target = destination;
                                var title = empty(&cx);
                                match destination.find(&cx, lit(&cx, " \""), 0usize) {
                                    Some(split) => if destination.ends_with(&cx, lit(&cx, "\"")) {
                                        target = destination.slice(0usize, split);
                                        title = destination.slice(split + 2usize, destination.len() - 1usize);
                                    },
                                    None => (),
                                }
                                out = mark_source(&cx, out, s, i, links);
                                out = html_escape(&cx, out.push_static("<img src=\""),
                                    asset_link(&cx, links, unescape_punctuation(&cx, target)))
                                    .push_static("\" alt=\"");
                                out = html_escape(&cx, out, unescape_punctuation(&cx, s.slice(i + 2usize, end)))
                                    .push_static("\"");
                                if !title.is_empty() {
                                    out = html_escape(&cx, out.push_static(" title=\""),
                                        unescape_punctuation(&cx, title)).push_static("\"");
                                }
                                out = out.push_static(">");
                                i = close + 1usize;
                            },
                            None => { out = out.push_byte(c); i = i + 1usize; },
                        }
                    } else { out = out.push_byte(c); i = i + 1usize; }
                },
                None => { out = out.push_byte(c); i = i + 1usize; },
            }
        } else if c == b'[' {
            match find_unescaped(&cx, s, b']', i + 1usize) {
                Some(end) => {
                    if at(&cx, s, end + 1usize) == b'(' {
                        match find_unescaped(&cx, s, b')', end + 2usize) {
                            Some(close) => {
                                out = mark_source(&cx, out, s, i, links);
                                out = html_escape(&cx, out.push_static("<a href=\""),
                                    source_link(&cx, links, unescape_punctuation(&cx, s.slice(end + 2usize, close))))
                                    .push_static("\">");
                                out = inline(&cx, out, s.slice(i + 1usize, end), links).push_static("</a>");
                                i = close + 1usize;
                            },
                            None => { out = out.push_byte(c); i = i + 1usize; },
                        }
                    } else { out = out.push_byte(c); i = i + 1usize; }
                },
                None => { out = out.push_byte(c); i = i + 1usize; },
            }
        } else if c == b'*' && at(&cx, s, i + 1usize) == b'*' {
            match find_unescaped_strong(&cx, s, i + 2usize) {
                Some(end) => {
                    out = inline(&cx, out.push_static("<strong>"), s.slice(i + 2usize, end), links).push_static("</strong>");
                    i = end + 2usize;
                },
                None => { out = out.push_byte(c); i = i + 1usize; },
            }
        } else if c == b'*' {
            match find_unescaped(&cx, s, b'*', i + 1usize) {
                Some(end) => {
                    out = inline(&cx, out.push_static("<em>"), s.slice(i + 1usize, end), links).push_static("</em>");
                    i = end + 1usize;
                },
                None => { out = out.push_byte(c); i = i + 1usize; },
            }
        } else if c == b'&' || c == b'<' || c == b'>' {
            out = html_escape(&cx, out, s.slice(i, i + 1usize));
            i = i + 1usize;
        } else { out = out.push_byte(c); i = i + 1usize; }
    }
    out
}

forall 'k.
fn table_cells(&cx: Domain!['k], line: Span['k]) -> (ArenaVec[Span['k], 'k], bool) {
    let text = line.trim(&cx);
    let cells = ArenaVec::new(&cx);
    var start = 0usize;
    var end = text.len();
    var has_pipe = false;
    if at(&cx, text, 0usize) == b'|' { start = 1usize; has_pipe = true; }
    if end > start && at(&cx, text, end - 1usize) == b'|' && !escaped_at(&cx, text, end - 1usize) {
        end = end - 1usize;
        has_pipe = true;
    }
    var cell_start = start;
    var pos = start;
    while pos < end {
        if at(&cx, text, pos) == b'`' {
            let width = backtick_run(&cx, text, pos);
            match code_close(&cx, text, pos + width, width) {
                Some(close) => { pos = close + width; },
                None => { pos = pos + width; },
            }
        } else if at(&cx, text, pos) == b'|' && !escaped_at(&cx, text, pos) {
            cells.push(&cx, text.slice(cell_start, pos).trim(&cx));
            has_pipe = true;
            cell_start = pos + 1usize;
            pos = pos + 1usize;
        } else { pos = pos + 1usize; }
    }
    cells.push(&cx, text.slice(cell_start, end).trim(&cx));
    (cells, has_pipe)
}

forall 'k.
fn table_delimiter(&cx: Domain!['k], header: Span['k], delimiter: Span['k])
    -> Option[ArenaVec[u8, 'k]] {
    let (headers, header_pipe) = table_cells(&cx, header);
    let (markers, marker_pipe) = table_cells(&cx, delimiter);
    if !header_pipe && !marker_pipe { return Option::None; }
    if headers.len(&cx) != markers.len(&cx) { return Option::None; }
    let aligns: ArenaVec[u8, 'k] = ArenaVec::new(&cx);
    var i = 0usize;
    while i < markers.len(&cx) {
        let cell = markers.at(&cx, i);
        var start = 0usize;
        var end = cell.len();
        let left = at(&cx, cell, start) == b':';
        if left { start = start + 1usize; }
        let right = end > start && at(&cx, cell, end - 1usize) == b':';
        if right { end = end - 1usize; }
        if start >= end { return Option::None; }
        var pos = start;
        while pos < end {
            if at(&cx, cell, pos) != b'-' { return Option::None; }
            pos = pos + 1usize;
        }
        aligns.push(&cx, if left && right { b'c' } else if left { b'l' }
            else if right { b'r' } else { 0u8 });
        i = i + 1usize;
    }
    Option::Some.(aligns)
}

forall 'k.
fn table_row(&cx: Domain!['k], out: Buffer!, line: Span['k], header: bool,
    aligns: ArenaVec[u8, 'k], links: LinkContext['k]) -> Buffer! {
    var out = out.push_static("<tr>\n");
    let (cells, has_pipe) = table_cells(&cx, line);
    var i = 0usize;
    while i < aligns.len(&cx) {
        out = out.push_static(if header { "<th" } else { "<td" });
        let align = aligns.at(&cx, i);
        if align == b'l' { out = out.push_static(" align=\"left\""); }
        else if align == b'r' { out = out.push_static(" align=\"right\""); }
        else if align == b'c' { out = out.push_static(" align=\"center\""); }
        out = out.push_static(">");
        if i < cells.len(&cx) { out = inline(&cx, out, cells.at(&cx, i), links); }
        out = out.push_static(if header { "</th>\n" } else { "</td>\n" });
        i = i + 1usize;
    }
    out.push_static("</tr>\n")
}

forall 'k.
fn heading_level(&cx: Domain!['k], line: Span['k]) -> usize {
    var level = 0usize;
    while level < 6usize && at(&cx, line, level) == b'#' { level = level + 1usize; }
    if level > 0usize && at(&cx, line, level) == b' ' { level } else { 0usize }
}

forall 'k.
fn attr_name(&cx: Domain!['k], name: Span['k]) -> bool {
    if name.is_empty() { return false; }
    var i = 0usize;
    while i < name.len() {
        let c = at(&cx, name, i);
        if !((c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') ||
            (c >= b'0' && c <= b'9') || c == b'-' || c == b'_' || c == b':') { return false; }
        i = i + 1usize;
    }
    true
}

forall 'k.
fn heading_text(&cx: Domain!['k], source: Span['k]) -> Span['k] {
    var out = Buffer!::new();
    var i = 0usize;
    while i < source.len() {
        let c = at(&cx, source, i);
        let opening = if c == b'!' && at(&cx, source, i + 1usize) == b'[' { i + 1usize } else { i };
        if c == b'`' {
            let width = backtick_run(&cx, source, i);
            match code_close(&cx, source, i + width, width) {
                Some(end) => {
                    out = out.push_bytes(&cx, code_content(&cx, source.slice(i + width, end)));
                    i = end + width;
                },
                None => {
                    out = out.push_bytes(&cx, source.slice(i, i + width));
                    i = i + width;
                },
            }
        }
        else if c == b'\\' && ascii_punctuation(at(&cx, source, i + 1usize)) {
            out = out.push_byte(at(&cx, source, i + 1usize));
            i = i + 2usize;
        }
        else if at(&cx, source, opening) == b'[' {
            match find_unescaped(&cx, source, b']', opening + 1usize) {
                Some(end) => if at(&cx, source, end + 1usize) == b'(' {
                    match find_unescaped(&cx, source, b')', end + 2usize) {
                        Some(close) => {
                            out = out.push_bytes(&cx, heading_text(&cx, source.slice(opening + 1usize, end)));
                            i = close + 1usize;
                        },
                        None => { out = out.push_byte(c); i = i + 1usize; },
                    }
                } else { out = out.push_byte(c); i = i + 1usize; },
                None => { out = out.push_byte(c); i = i + 1usize; },
            }
        } else if c == b'*' { i = i + 1usize; }
        else { out = out.push_byte(c); i = i + 1usize; }
    }
    out.save(&cx)
}

forall 'k.
fn heading_slug(&cx: Domain!['k], text: Span['k]) -> Span['k] {
    var out = Buffer!::new();
    var pending_dash = false;
    var written = false;
    var i = 0usize;
    while i < text.len() {
        let c = at(&cx, text, i);
        let letter = (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z');
        let digit = c >= b'0' && c <= b'9';
        if letter || digit || c >= 128u8 {
            if pending_dash && written { out = out.push_byte(b'-'); }
            out = out.push_byte(if c >= b'A' && c <= b'Z' { c + 32u8 } else { c });
            written = true;
            pending_dash = false;
        } else if c == b' ' || c == b'\t' || c == b'-' || c == b'_' { pending_dash = true; }
        i = i + 1usize;
    }
    if written { out.save(&cx) } else { out.destroy(); lit(&cx, "section") }
}

forall 'k.
fn heading(&cx: Domain!['k], out: Buffer!, content: Span['k], mark: Span['k], level: usize,
    ids: ArenaMap[Span['k], bool, 'k], headings: ArenaVec[Heading['k], 'k], links: LinkContext['k]) -> Result[Buffer!, Span['k]] {
    var out = out;
    var text = content;
    var id = empty(&cx);
    var classes = Buffer!::new();
    var has_class = false;
    if text.ends_with(&cx, lit(&cx, "}")) {
        match text.find(&cx, lit(&cx, " {"), 0usize) {
            Some(marker) => {
                let attrs = text.slice(marker + 2usize, text.len() - 1usize);
                if attrs.is_empty() { classes.destroy(); out.destroy(); return Result::Err.(lit(&cx, "empty heading attributes")); }
                text = text.slice(0usize, marker);
                var pos = 0usize;
                while pos < attrs.len() {
                    while pos < attrs.len() && at(&cx, attrs, pos) == b' ' { pos = pos + 1usize; }
                    if pos < attrs.len() {
                        var end = pos;
                        while end < attrs.len() && at(&cx, attrs, end) != b' ' { end = end + 1usize; }
                        let token = attrs.slice(pos, end);
                        let value = token.slice(1usize, token.len());
                        if (at(&cx, token, 0usize) != b'#' && at(&cx, token, 0usize) != b'.') || !attr_name(&cx, value) {
                            classes.destroy(); out.destroy(); return Result::Err.(lit(&cx, "invalid heading attribute"));
                        }
                        if at(&cx, token, 0usize) == b'#' {
                            if !id.is_empty() { classes.destroy(); out.destroy(); return Result::Err.(lit(&cx, "duplicate heading ID attribute")); }
                            id = value;
                        } else {
                            if has_class { classes = classes.push_byte(b' '); }
                            classes = classes.push_bytes(&cx, value);
                            has_class = true;
                        }
                        pos = end;
                    }
                }
            },
            None => (),
        }
    }
    let plain = heading_text(&cx, text);
    if !id.is_empty() {
        if ids.contains(&cx, id) { classes.destroy(); out.destroy(); return Result::Err.(lit(&cx, "duplicate heading ID")); }
    } else {
        let slug = heading_slug(&cx, plain);
        id = slug;
        var number = 2usize;
        while ids.contains(&cx, id) {
            id = Buffer!::new().push_bytes(&cx, slug).push_byte(b'-').push_usize(number).save(&cx);
            number = number + 1usize;
        }
    }
    ids.insert(&cx, id, true);
    headings.push(&cx, Heading.{ level, text: plain, id });
    out = mark_source(&cx, out, mark, 0usize, links);
    out = out.push_static("<h").push_usize(level);
    out = out.push_static(" id=\"").push_bytes(&cx, id).push_static("\"");
    let class_text = classes.save(&cx);
    if !class_text.is_empty() { out = out.push_static(" class=\"").push_bytes(&cx, class_text).push_static("\""); }
    Result::Ok.(inline(&cx, out.push_static(">"), text, links).push_static("</h").push_usize(level).push_static(">\n"))
}

forall 'k.
fn ordered_marker(&cx: Domain!['k], line: Span['k]) -> usize {
    var i = 0usize;
    while at(&cx, line, i) >= b'0' && at(&cx, line, i) <= b'9' { i = i + 1usize; }
    if i > 0usize && at(&cx, line, i) == b'.' && at(&cx, line, i + 1usize) == b' ' { i + 2usize }
    else { 0usize }
}

forall 'k.
fn list_marker(&cx: Domain!['k], line: Span['k]) -> Option[(usize, usize, bool)] {
    var indent = 0usize;
    while at(&cx, line, indent) == b' ' { indent = indent + 1usize; }
    let marker = line.slice(indent, line.len());
    if starts(&cx, marker, "- ") || starts(&cx, marker, "* ") || starts(&cx, marker, "+ ") {
        Option::Some.((indent, indent + 2usize, false))
    } else {
        let width = ordered_marker(&cx, marker);
        if width > 0usize { Option::Some.((indent, indent + width, true)) }
        else { Option::None }
    }
}

forall 'k.
fn quote_line(&cx: Domain!['k], line: Span['k]) -> Option[Span['k]] {
    var indent = 0usize;
    while indent < 4usize && at(&cx, line, indent) == b' ' { indent = indent + 1usize; }
    if indent > 3usize || at(&cx, line, indent) != b'>' { return Option::None; }
    let start = if at(&cx, line, indent + 1usize) == b' ' { indent + 2usize } else { indent + 1usize };
    Option::Some.(line.slice(start, line.len()))
}

forall 'k.
fn fence_open(&cx: Domain!['k], line: Span['k]) -> Option[(u8, usize, usize, Span['k])] {
    var indent = 0usize;
    while at(&cx, line, indent) == b' ' { indent = indent + 1usize; }
    if indent > 3usize { return Option::None; }
    let marker = at(&cx, line, indent);
    if marker != b'`' && marker != b'~' { return Option::None; }
    var end = indent;
    while at(&cx, line, end) == marker { end = end + 1usize; }
    let width = end - indent;
    if width < 3usize { return Option::None; }
    let info = line.slice(end, line.len()).trim(&cx);
    if marker == b'`' && info.find_byte(&cx, b'`', 0usize).is_some() { return Option::None; }
    Option::Some.((marker, width, indent, info))
}

forall 'k.
fn fence_close(&cx: Domain!['k], line: Span['k], marker: u8, width: usize) -> bool {
    var indent = 0usize;
    while at(&cx, line, indent) == b' ' { indent = indent + 1usize; }
    if indent > 3usize || at(&cx, line, indent) != marker { return false; }
    var end = indent;
    while at(&cx, line, end) == marker { end = end + 1usize; }
    if end - indent < width { return false; }
    while end < line.len() {
        let c = at(&cx, line, end);
        if c != b' ' && c != b'\t' { return false; }
        end = end + 1usize;
    }
    true
}

forall 'k.
fn fence_content(&cx: Domain!['k], line: Span['k], indent: usize) -> Span['k] {
    var removed = 0usize;
    while removed < indent && at(&cx, line, removed) == b' ' { removed = removed + 1usize; }
    let content = line.slice(removed, line.len());
    if content.len() > 0usize && at(&cx, content, content.len() - 1usize) == b'\r' {
        content.slice(0usize, content.len() - 1usize)
    } else { content }
}

forall 'k.
fn indented_code(&cx: Domain!['k], line: Span['k]) -> bool {
    line.len() >= 4usize && at(&cx, line, 0usize) == b' ' &&
        at(&cx, line, 1usize) == b' ' && at(&cx, line, 2usize) == b' ' &&
        at(&cx, line, 3usize) == b' ' && !line.trim(&cx).is_empty()
}

forall 'k.
fn thematic_break(&cx: Domain!['k], line: Span['k]) -> bool {
    var indent = 0usize;
    while at(&cx, line, indent) == b' ' { indent = indent + 1usize; }
    if indent > 3usize { return false; }
    let marker = at(&cx, line, indent);
    if marker != b'-' && marker != b'*' && marker != b'_' { return false; }
    var count = 0usize;
    var pos = indent;
    while pos < line.len() {
        let c = at(&cx, line, pos);
        if c == marker { count = count + 1usize; }
        else if c != b' ' && c != b'\t' { return false; }
        pos = pos + 1usize;
    }
    count >= 3usize
}

forall 'k.
fn paragraph_text_line(&cx: Domain!['k], line: Span['k]) -> bool {
    let text = line.trim(&cx);
    !text.is_empty() && !list_marker(&cx, text).is_some() &&
        !quote_line(&cx, text).is_some() && heading_level(&cx, text) == 0usize &&
        !thematic_break(&cx, line) && !fence_open(&cx, line).is_some() &&
        !starts(&cx, text, "<") && !starts(&cx, text, "| ")
}

forall 'k.
fn setext_level(&cx: Domain!['k], line: Span['k]) -> usize {
    var indent = 0usize;
    while at(&cx, line, indent) == b' ' { indent = indent + 1usize; }
    if indent > 3usize { return 0usize; }
    let marker = at(&cx, line, indent);
    if marker != b'=' && marker != b'-' { return 0usize; }
    var pos = indent;
    while at(&cx, line, pos) == marker { pos = pos + 1usize; }
    while pos < line.len() {
        let c = at(&cx, line, pos);
        if c != b' ' && c != b'\t' { return 0usize; }
        pos = pos + 1usize;
    }
    if marker == b'=' { 1usize } else { 2usize }
}

forall 'k.
fn setext_after(&cx: Domain!['k], source: Span['k], next: usize) -> Option[(usize, usize, usize)] {
    var pos = next;
    while pos < source.len() {
        let (line, after) = next_line(&cx, source, pos);
        let level = setext_level(&cx, line);
        if level > 0usize { return Option::Some.((level, pos, after)); }
        if !paragraph_text_line(&cx, line) { return Option::None; }
        pos = after;
    }
    Option::None
}

forall 'k.
fn item_paragraph_line(&cx: Domain!['k], line: Span['k]) -> bool {
    match list_marker(&cx, line) {
        Some(parts) => {
            let (indent, content_start, ordered) = parts;
            paragraph_text_line(&cx, line.slice(content_start, line.len()))
        },
        None => paragraph_text_line(&cx, line),
    }
}

// A blank line between items or between blocks in an item makes the whole
// list loose, including items that precede the blank line.
forall 'k.
fn loose_list(&cx: Domain!['k], source: Span['k], next: usize,
    indent: usize, content_indent: usize, ordered: bool, first_content: Span['k]) -> bool {
    var pos = next;
    var blank = false;
    var fenced = false;
    var fence_marker = 0u8;
    var fence_width = 0usize;
    match fence_open(&cx, first_content) {
        Some(parts) => {
            let (marker, width, indent, info) = parts;
            fenced = true;
            fence_marker = marker;
            fence_width = width;
        },
        None => (),
    }
    var lazy_paragraph = item_paragraph_line(&cx, first_content);
    while pos < source.len() {
        let (line, after) = next_line(&cx, source, pos);
        pos = after;
        if line.is_empty() {
            if !fenced { blank = true; lazy_paragraph = false; }
        }
        else {
            var line_indent = 0usize;
            while at(&cx, line, line_indent) == b' ' { line_indent = line_indent + 1usize; }
            if fenced && line_indent >= content_indent {
                if fence_close(&cx, line.slice(content_indent, line.len()), fence_marker, fence_width) {
                    fenced = false;
                }
            } else {
                fenced = false;
                let marker = list_marker(&cx, line);
                let same_item_level = match marker {
                    Some(parts) => {
                        let (item_indent, item_content, item_ordered) = parts;
                        item_indent == indent && item_ordered == ordered
                    },
                    None => false,
                };
                if !same_item_level && line_indent < content_indent {
                    if blank || !lazy_paragraph || !paragraph_text_line(&cx, line) { return false; }
                }
                if blank { return true; }
                blank = false;
                let content = if same_item_level {
                    match marker {
                        Some(parts) => {
                            let (item_indent, item_content, item_ordered) = parts;
                            line.slice(item_content, line.len())
                        },
                        None => line,
                    }
                } else if line_indent >= content_indent { line.slice(content_indent, line.len()) }
                else { line };
                match fence_open(&cx, content) {
                    Some(parts) => {
                        let (opened, width, indent, info) = parts;
                        fenced = true;
                        fence_marker = opened;
                        fence_width = width;
                        lazy_paragraph = false;
                    },
                    None => { lazy_paragraph = item_paragraph_line(&cx, content); },
                }
            }
        }
    }
    false
}

forall 'k.
fn render_list(&cx: Domain!['k], source: Span['k], start: usize, links: LinkContext['k],
    ids: ArenaMap[Span['k], bool, 'k], headings: ArenaVec[Heading['k], 'k], depth: usize)
    -> Result[(Buffer!, usize), Span['k]] {
    let (first, first_after) = next_line(&cx, source, start);
    let (indent, content_indent, ordered) = match list_marker(&cx, first) {
        Some(parts) => parts,
        None => return Result::Err.(lit(&cx, "invalid Markdown list marker")),
    };
    let loose = loose_list(&cx, source, first_after, indent, content_indent, ordered,
        first.slice(content_indent, first.len()));
    var out = Buffer!::new();
    if ordered {
        out = out.push_static("<ol");
        let start_number = first.slice(indent, content_indent - 2usize);
        if !start_number.is(&cx, "1") {
            out = out.push_static(" start=\"").push_bytes(&cx, start_number).push_static("\"");
        }
        out = out.push_static(">\n");
    } else { out = out.push_static("<ul>\n"); }
    var pos = start;
    var gathering = true;
    while gathering && pos < source.len() {
        let (line, after) = next_line(&cx, source, pos);
        let marker = list_marker(&cx, line);
        let same_level = match marker {
            Some(parts) => {
                let (item_indent, item_content, item_ordered) = parts;
                item_indent == indent && item_ordered == ordered
            },
            None => false,
        };
        if !same_level { gathering = false; }
        else {
            let item_content = match marker {
                Some(parts) => {
                    let (item_indent, item_content, item_ordered) = parts;
                    item_content
                },
                None => 0usize,
            };
            var body = Buffer!::new();
            let segments = ArenaVec::new(&cx);
            let first_raw = raw_line(&cx, source, pos, after);
            let first_content = first_raw.slice(item_content, first_raw.len());
            match original_offset(&cx, links, first_content, 0usize) {
                Some(offset) => segments.push(&cx, SourceSegment.{ start: 0usize, length: first_content.len(), original: offset }),
                None => (),
            }
            body = body.push_bytes(&cx, first_content).push_byte(b'\n');
            pos = after;
            var reading_item = true;
            var fenced = false;
            var fence_marker = 0u8;
            var fence_width = 0usize;
            match fence_open(&cx, first_content) {
                Some(parts) => {
                    let (marker, width, indent, info) = parts;
                    fenced = true;
                    fence_marker = marker;
                    fence_width = width;
                },
                None => (),
            }
            var lazy_paragraph = item_paragraph_line(&cx, first_content);
            while reading_item && pos < source.len() {
                let (following, next) = next_line(&cx, source, pos);
                if following.is_empty() {
                    body = body.push_byte(b'\n');
                    pos = next;
                    if !fenced { lazy_paragraph = false; }
                } else {
                    var following_indent = 0usize;
                    while at(&cx, following, following_indent) == b' ' { following_indent = following_indent + 1usize; }
                    let following_marker = list_marker(&cx, following);
                    let next_item = match following_marker {
                        Some(parts) => {
                            let (next_indent, next_content, next_ordered) = parts;
                            next_indent <= indent
                        },
                        None => false,
                    };
                    let lazy_line = following_indent < item_content && lazy_paragraph &&
                        paragraph_text_line(&cx, following);
                    if next_item || (following_indent < item_content && !lazy_line) { reading_item = false; }
                    else {
                        let following_raw = raw_line(&cx, source, pos, next);
                        let content = if lazy_line { following_raw.slice(following_indent, following_raw.len()) }
                            else { following_raw.slice(item_content, following_raw.len()) };
                        match original_offset(&cx, links, content, 0usize) {
                            Some(offset) => segments.push(&cx, SourceSegment.{ start: &body.len(), length: content.len(), original: offset }),
                            None => (),
                        }
                        body = body.push_bytes(&cx, content).push_byte(b'\n');
                        pos = next;
                        if fenced {
                            if fence_close(&cx, content, fence_marker, fence_width) { fenced = false; }
                            lazy_paragraph = false;
                        } else {
                            match fence_open(&cx, content) {
                                Some(parts) => {
                                    let (opened, width, indent, info) = parts;
                                    fenced = true;
                                    fence_marker = opened;
                                    fence_width = width;
                                    lazy_paragraph = false;
                                },
                                None => { lazy_paragraph = item_paragraph_line(&cx, content); },
                            }
                        }
                    }
                }
            }
            let body_source = body.save(&cx);
            let body_links = LinkContext.{ base: links.base, urls: links.urls, asset_urls: links.asset_urls,
                fingerprint_assets: links.fingerprint_assets, source: links.source,
                rendered_source: body_source, segments: Option::Some.(segments), track_sources: links.track_sources };
            let inner = match render_blocks(&cx, body_source, body_links, ids, headings, depth + 1usize, !loose) {
                Ok(html) => html,
                Err(message) => { out.destroy(); return Result::Err.(message); },
            };
            out = out.push_static("<li>").push_buffer(inner).push_static("</li>\n");
        }
    }
    out = out.push_static(if ordered { "</ol>\n" } else { "</ul>\n" });
    Result::Ok.((out, pos))
}

forall 'k.
fn render_blocks(&cx: Domain!['k], source: Span['k], links: LinkContext['k],
    ids: ArenaMap[Span['k], bool, 'k], headings: ArenaVec[Heading['k], 'k], depth: usize,
    tight_item: bool) -> Result[Buffer!, Span['k]] {
    if depth >= 32usize { return Result::Err.(lit(&cx, "Markdown containers nested too deeply")); }
    var out = Buffer!::new();
    var pos = 0usize;
    var paragraph = false;
    var paragraph_compact = false;
    var compact_allowed = tight_item;
    var pending_break = false;
    var code = false;
    var code_lang = empty(&cx);
    var code_marker = 0u8;
    var code_width = 0usize;
    var code_indent = 0usize;
    var table = false;
    var table_aligns: ArenaVec[u8, 'k] = ArenaVec::new(&cx);
    while pos < source.len() {
        let line_start = pos;
        let (line, next) = next_line(&cx, source, pos);
        pos = next;
        let raw = raw_line(&cx, source, line_start, next);
        let marker = list_marker(&cx, line);
        let quoted = quote_line(&cx, raw);
        let opening = fence_open(&cx, line);
        let use_marker = match marker {
            Some(parts) => {
                let (indent, content_start, ordered) = parts;
                indent <= 3usize
            },
            None => false,
        };
        if table && (line.is_empty() || opening.is_some() || thematic_break(&cx, line) ||
            (depth == 0usize && line.is(&cx, "<!-- more -->")) || quoted.is_some() ||
            starts(&cx, line, "<") || heading_level(&cx, line) > 0usize || use_marker) {
            out = out.push_static("</tbody>\n</table>\n");
            table = false;
        }
        let table_start = if !table && !indented_code(&cx, raw) && pos < source.len() {
            let (following, after) = next_line(&cx, source, pos);
            match table_delimiter(&cx, line, following) {
                Some(aligns) => Option::Some.((aligns, after)),
                None => Option::None,
            }
        } else { Option::None };
        if code {
            if fence_close(&cx, line, code_marker, code_width) {
                out = out.push_static("</code></pre>\n");
                code = false;
                code_lang = empty(&cx);
            } else {
                out = out.push_buffer(render_line(&cx, code_lang, fence_content(&cx, raw, code_indent)))
                    .push_byte(b'\n');
            }
        } else if opening.is_some() {
            if paragraph {
                if !paragraph_compact { out = out.push_static("</p>\n"); }
                paragraph = false;
            }
            compact_allowed = false;
            match opening {
                Some(parts) => {
                    let (marker, width, indent, info) = parts;
                    code_marker = marker;
                    code_width = width;
                    code_indent = indent;
                    code_lang = info;
                },
                None => (),
            }
            out = out.push_static("<pre><code");
            if !code_lang.is_empty() { out = html_escape(&cx, out.push_static(" class=\"language-"), code_lang).push_static("\""); }
            out = out.push_static(">"); code = true;
        } else if !paragraph && !table && indented_code(&cx, raw) {
            compact_allowed = false;
            out = html_escape(&cx, out.push_static("<pre><code>"),
                fence_content(&cx, raw.slice(4usize, raw.len()), 0usize)).push_byte(b'\n');
            var pending_blank = 0usize;
            var gathering = true;
            while gathering && pos < source.len() {
                let (following, after) = next_line(&cx, source, pos);
                if following.is_empty() {
                    pending_blank = pending_blank + 1usize;
                    pos = after;
                } else {
                    let following_raw = raw_line(&cx, source, pos, after);
                    if indented_code(&cx, following_raw) {
                        while pending_blank > 0usize {
                            out = out.push_byte(b'\n');
                            pending_blank = pending_blank - 1usize;
                        }
                        out = html_escape(&cx, out,
                            fence_content(&cx, following_raw.slice(4usize, following_raw.len()), 0usize))
                            .push_byte(b'\n');
                        pos = after;
                    } else { gathering = false; }
                }
            }
            out = out.push_static("</code></pre>\n");
        } else if thematic_break(&cx, line) {
            if paragraph {
                if !paragraph_compact { out = out.push_static("</p>\n"); }
                paragraph = false;
            }
            compact_allowed = false;
            out = out.push_static("<hr>\n");
        }
        else if depth == 0usize && line.is(&cx, "<!-- more -->") {
            if paragraph {
                if !paragraph_compact { out = out.push_static("</p>\n"); }
                paragraph = false;
            }
            compact_allowed = false;
        }
        else if line.is_empty() {
            if paragraph {
                if !paragraph_compact { out = out.push_static("</p>\n"); }
                paragraph = false;
            }
        } else if quoted.is_some() {
            if paragraph {
                if !paragraph_compact { out = out.push_static("</p>\n"); }
                paragraph = false;
            }
            compact_allowed = false;
            var quote = Buffer!::new();
            let segments = ArenaVec::new(&cx);
            match quoted {
                Some(content) => {
                    match original_offset(&cx, links, content, 0usize) {
                        Some(offset) => segments.push(&cx, SourceSegment.{ start: &quote.len(), length: content.len(), original: offset }),
                        None => (),
                    }
                    quote = quote.push_bytes(&cx, content).push_byte(b'\n');
                },
                None => (),
            }
            var gathering = true;
            while gathering && pos < source.len() {
                let (following, after) = next_line(&cx, source, pos);
                let following_raw = raw_line(&cx, source, pos, after);
                match quote_line(&cx, following_raw) {
                    Some(content) => {
                        match original_offset(&cx, links, content, 0usize) {
                            Some(offset) => segments.push(&cx, SourceSegment.{ start: &quote.len(), length: content.len(), original: offset }),
                            None => (),
                        }
                        quote = quote.push_bytes(&cx, content).push_byte(b'\n');
                        pos = after;
                    },
                    None => { gathering = false; },
                }
            }
            let quoted_source = quote.save(&cx);
            let quote_links = LinkContext.{ base: links.base, urls: links.urls, asset_urls: links.asset_urls,
                fingerprint_assets: links.fingerprint_assets, source: links.source,
                rendered_source: quoted_source, segments: Option::Some.(segments), track_sources: links.track_sources };
            let inner = match render_blocks(&cx, quoted_source, quote_links, ids, headings, depth + 1usize, false) {
                Ok(html) => html,
                Err(message) => { out.destroy(); return Result::Err.(message); },
            };
            out = out.push_static("<blockquote>\n").push_buffer(inner).push_static("</blockquote>\n");
        } else if starts(&cx, line, "<") {
            if paragraph {
                if !paragraph_compact { out = out.push_static("</p>\n"); }
                paragraph = false;
            }
            compact_allowed = false;
            out = out.push_bytes(&cx, line).push_byte(b'\n');
        } else if heading_level(&cx, line) > 0usize {
            if paragraph {
                if !paragraph_compact { out = out.push_static("</p>\n"); }
                paragraph = false;
            }
            compact_allowed = false;
            let level = heading_level(&cx, line);
            out = match heading(&cx, out, line.slice(level + 1usize, line.len()), line,
                level, ids, headings, links) {
                Ok(html) => html,
                Err(message) => return Result::Err.(message),
            };
        } else if use_marker {
            if paragraph {
                if !paragraph_compact { out = out.push_static("</p>\n"); }
                paragraph = false;
            }
            compact_allowed = false;
            let (list, after_list) = match render_list(&cx, source, line_start,
                links, ids, headings, depth) {
                Ok(rendered) => rendered,
                Err(message) => { out.destroy(); return Result::Err.(message); },
            };
            out = out.push_buffer(list);
            pos = after_list;
        } else if table || table_start.is_some() {
            if paragraph {
                if !paragraph_compact { out = out.push_static("</p>\n"); }
                paragraph = false;
            }
            compact_allowed = false;
            if table { out = table_row(&cx, out, line, false, table_aligns, links); }
            else {
                match table_start {
                    Some(parts) => {
                        let (aligns, after) = parts;
                        table_aligns = aligns;
                        out = table_row(&cx, out.push_static("<table>\n<thead>\n"), line,
                            true, table_aligns, links).push_static("</thead>\n<tbody>\n");
                        table = true;
                        pos = after;
                    },
                    None => (),
                }
            }
        } else {
            let setext = if !paragraph { setext_after(&cx, source, pos) } else { Option::None };
            match setext {
                Some(parts) => {
                    let (level, underline_start, underline_after) = parts;
                    var joined = Buffer!::new();
                    let segments = ArenaVec::new(&cx);
                    var scan = line_start;
                    while scan < underline_start {
                        let (part, after) = next_line(&cx, source, scan);
                        let content = raw_line(&cx, source, scan, after).trim(&cx);
                        if scan > line_start { joined = joined.push_byte(b' '); }
                        match original_offset(&cx, links, content, 0usize) {
                            Some(offset) => segments.push(&cx, SourceSegment.{ start: &joined.len(), length: content.len(), original: offset }),
                            None => (),
                        }
                        joined = joined.push_bytes(&cx, content);
                        scan = after;
                    }
                    let heading_source = joined.save(&cx);
                    let heading_links = LinkContext.{ base: links.base, urls: links.urls, asset_urls: links.asset_urls,
                        fingerprint_assets: links.fingerprint_assets, source: links.source,
                        rendered_source: heading_source, segments: Option::Some.(segments), track_sources: links.track_sources };
                    out = match heading(&cx, out, heading_source, heading_source, level,
                        ids, headings, heading_links) {
                        Ok(html) => html,
                        Err(message) => return Result::Err.(message),
                    };
                    pos = underline_after;
                    compact_allowed = false;
                },
                None => {
                    if !paragraph {
                        paragraph_compact = compact_allowed;
                        if !paragraph_compact { out = out.push_static("<p>"); }
                        paragraph = true;
                        compact_allowed = false;
                    } else if pending_break { out = out.push_static("<br>\n"); }
                    else { out = out.push_byte(b' '); }
                    let (content, hard_break) = paragraph_line(&cx, raw,
                        paragraph_continues(&cx, source, pos, depth));
                    out = inline(&cx, out, content, links);
                    pending_break = hard_break;
                },
            }
        }
    }
    if paragraph && !paragraph_compact { out = out.push_static("</p>\n"); }
    if code { out = out.push_static("</code></pre>\n"); }
    if table { out = out.push_static("</tbody>\n</table>\n"); }
    Result::Ok.(out)
}

forall 'k.
fn markdown(&cx: Domain!['k], source: Span['k], base: Span['k],
    urls: ArenaMap[Span['k], Span['k], 'k], asset_urls: ArenaMap[Span['k], Span['k], 'k],
    fingerprint_assets: bool, current: Span['k], track_sources: bool)
    -> Result[(Buffer!, ArenaVec[Heading['k], 'k]), Span['k]] {
    let headings = ArenaVec::new(&cx);
    let links = LinkContext.{ base, urls, asset_urls, fingerprint_assets, source: current,
        rendered_source: source, segments: Option::None, track_sources };
    let html = render_blocks(&cx, source, links, ArenaMap::new(&cx), headings, 0usize, false)?;
    Result::Ok.((html, headings))
}
