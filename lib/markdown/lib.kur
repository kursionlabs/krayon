use std::arena::Domain!;
use std::buffer::Buffer!;
use std::collections::arena_map::ArenaMap;
use std::collections::arena_vec::ArenaVec;
use std::option::{Option, Result};
use std::raw::Span;
use std::slice::Slice;
use url::prefix;
use highlight::render_line;

struct ListFrame {
    indent: usize,
    content_indent: usize,
    ordered: bool,
}

forall 'k.
exposed struct Heading {
    level: usize,
    text: Span['k],
    id: Span['k],
}

forall 'k.
struct LinkContext {
    base: Span['k],
    urls: ArenaMap[Span['k], Span['k], 'k],
    asset_urls: ArenaMap[Span['k], Span['k], 'k],
    fingerprint_assets: bool,
    source: Span['k],
}

forall 'k.
fn empty(&cx: Domain!['k]) -> Span['k] { Span::from_static(&cx, "") }

forall 'k.
fn lit(&cx: Domain!['k], s: Slice[u8, 'static]) -> Span['k] { Span::from_static(&cx, s) }

forall 'k.
fn starts(&cx: Domain!['k], s: Span['k], prefix: Slice[u8, 'static]) -> bool {
    s.starts_with(&cx, lit(&cx, prefix))
}

forall 'k.
fn at(&cx: Domain!['k], s: Span['k], i: usize) -> u8 { s.byte_or_zero(&cx, i) }

forall 'k.
fn next_line(&cx: Domain!['k], source: Span['k], start: usize) -> (Span['k], usize) {
    var i = start;
    while i < source.len() && at(&cx, source, i) != b'\n' { i = i + 1usize; }
    let line = source.slice(start, i).trim_end(&cx);
    (line, if i < source.len() { i + 1usize } else { i })
}

forall 'k.
fn source_path(&cx: Domain!['k], source: Span['k], path: Span['k]) -> Option[Span['k]] {
    let absolute = at(&cx, path, 0usize) == b'/';
    let parts: ArenaVec[Span['k], 'k] = ArenaVec::new(&cx);
    if !absolute {
        var i = 0usize;
        var start = 0usize;
        while i < source.len() {
            if at(&cx, source, i) == b'/' {
                parts.push(&cx, source.slice(start, i));
                start = i + 1usize;
            }
            i = i + 1usize;
        }
    }
    var start = if absolute { 1usize } else { 0usize };
    var i = start;
    while i <= path.len() {
        if i == path.len() || at(&cx, path, i) == b'/' {
            let part = path.slice(start, i);
            if part.is(&cx, "..") {
                if parts.len(&cx) == 0usize { return Option::None; }
                let removed = parts.pop(&cx);
            } else if !part.is_empty() && !part.is(&cx, ".") { parts.push(&cx, part); }
            start = i + 1usize;
        }
        i = i + 1usize;
    }
    var key = Buffer!::new();
    i = 0usize;
    while i < parts.len(&cx) {
        if i > 0usize { key = key.push_byte(b'/'); }
        key = key.push_bytes(&cx, parts.at(&cx, i));
        i = i + 1usize;
    }
    Option::Some.(key.save(&cx))
}

forall 'k.
fn source_link(&cx: Domain!['k], links: LinkContext['k], target: Span['k]) -> Span['k] {
    var end = target.len();
    match target.find_byte(&cx, b'?', 0usize) { Option::Some(at) => if at < end { end = at; }, Option::None => (), }
    match target.find_byte(&cx, b'#', 0usize) { Option::Some(at) => if at < end { end = at; }, Option::None => (), }
    let path = target.slice(0usize, end);
    if !path.ends_with(&cx, lit(&cx, ".md")) || starts(&cx, path, "//")
        || path.find(&cx, lit(&cx, "://"), 0usize).is_some() { return asset_link(&cx, links, target); }
    let key = match source_path(&cx, links.source, path) {
        Option::Some(found) => found,
        Option::None => return asset_link(&cx, links, target),
    };
    match links.urls.get(&cx, key) {
        Option::Some(url) => prefix(&cx, links.base,
            Buffer!::new().push_bytes(&cx, url).push_bytes(&cx, target.slice(end, target.len())).save(&cx)),
        Option::None => asset_link(&cx, links, target),
    }
}

forall 'k.
fn asset_link(&cx: Domain!['k], links: LinkContext['k], target: Span['k]) -> Span['k] {
    if !links.fingerprint_assets { return prefix(&cx, links.base, target); }
    var end = target.len();
    match target.find_byte(&cx, b'?', 0usize) { Option::Some(at) => if at < end { end = at; }, Option::None => (), }
    match target.find_byte(&cx, b'#', 0usize) { Option::Some(at) => if at < end { end = at; }, Option::None => (), }
    let path = target.slice(0usize, end);
    if path.is_empty() || starts(&cx, path, "//") || path.find(&cx, lit(&cx, "://"), 0usize).is_some() {
        return prefix(&cx, links.base, target);
    }
    let relative = match source_path(&cx, links.source, path) {
        Option::Some(found) => found,
        Option::None => return prefix(&cx, links.base, target),
    };
    let key = Buffer!::new().push_static("/").push_bytes(&cx, relative).save(&cx);
    match links.asset_urls.get(&cx, key) {
        Option::Some(url) => prefix(&cx, links.base,
            Buffer!::new().push_bytes(&cx, url).push_bytes(&cx, target.slice(end, target.len())).save(&cx)),
        Option::None => prefix(&cx, links.base, target),
    }
}

forall 'k.
fn html_escape(&cx: Domain!['k], out: Buffer!, s: Span['k]) -> Buffer! {
    var out = out;
    var i = 0usize;
    while i < s.len() {
        let c = at(&cx, s, i);
        out = if c == b'&' { out.push_static("&amp;") }
          else if c == b'<' { out.push_static("&lt;") }
          else if c == b'>' { out.push_static("&gt;") }
          else if c == b'"' { out.push_static("&quot;") }
          else { out.push_byte(c) };
        i = i + 1usize;
    }
    out
}

forall 'k.
fn inline(&cx: Domain!['k], out: Buffer!, s: Span['k], links: LinkContext['k]) -> Buffer! {
    var out = out;
    var i = 0usize;
    while i < s.len() {
        let c = at(&cx, s, i);
        if c == b'`' {
            match s.find_byte(&cx, b'`', i + 1usize) {
                Option::Some(end) => {
                    out = html_escape(&cx, out.push_static("<code>"), s.slice(i + 1usize, end)).push_static("</code>");
                    i = end + 1usize;
                },
                Option::None => { out = out.push_static("`"); i = i + 1usize; },
            }
        } else if c == b'!' && at(&cx, s, i + 1usize) == b'[' {
            match s.find_byte(&cx, b']', i + 2usize) {
                Option::Some(end) => {
                    if at(&cx, s, end + 1usize) == b'(' {
                        match s.find_byte(&cx, b')', end + 2usize) {
                            Option::Some(close) => {
                                let destination = s.slice(end + 2usize, close).trim(&cx);
                                var target = destination;
                                var title = empty(&cx);
                                match destination.find(&cx, lit(&cx, " \""), 0usize) {
                                    Option::Some(split) => if destination.ends_with(&cx, lit(&cx, "\"")) {
                                        target = destination.slice(0usize, split);
                                        title = destination.slice(split + 2usize, destination.len() - 1usize);
                                    },
                                    Option::None => (),
                                }
                                out = html_escape(&cx, out.push_static("<img src=\""), asset_link(&cx, links, target))
                                    .push_static("\" alt=\"");
                                out = html_escape(&cx, out, s.slice(i + 2usize, end)).push_static("\"");
                                if !title.is_empty() {
                                    out = html_escape(&cx, out.push_static(" title=\""), title).push_static("\"");
                                }
                                out = out.push_static(">");
                                i = close + 1usize;
                            },
                            Option::None => { out = out.push_byte(c); i = i + 1usize; },
                        }
                    } else { out = out.push_byte(c); i = i + 1usize; }
                },
                Option::None => { out = out.push_byte(c); i = i + 1usize; },
            }
        } else if c == b'[' {
            match s.find_byte(&cx, b']', i + 1usize) {
                Option::Some(end) => {
                    if at(&cx, s, end + 1usize) == b'(' {
                        match s.find_byte(&cx, b')', end + 2usize) {
                            Option::Some(close) => {
                                out = html_escape(&cx, out.push_static("<a href=\""), source_link(&cx, links, s.slice(end + 2usize, close))).push_static("\">");
                                out = inline(&cx, out, s.slice(i + 1usize, end), links).push_static("</a>");
                                i = close + 1usize;
                            },
                            Option::None => { out = out.push_byte(c); i = i + 1usize; },
                        }
                    } else { out = out.push_byte(c); i = i + 1usize; }
                },
                Option::None => { out = out.push_byte(c); i = i + 1usize; },
            }
        } else if c == b'*' && at(&cx, s, i + 1usize) == b'*' {
            match s.find(&cx, lit(&cx, "**"), i + 2usize) {
                Option::Some(end) => {
                    out = inline(&cx, out.push_static("<strong>"), s.slice(i + 2usize, end), links).push_static("</strong>");
                    i = end + 2usize;
                },
                Option::None => { out = out.push_byte(c); i = i + 1usize; },
            }
        } else if c == b'*' {
            match s.find_byte(&cx, b'*', i + 1usize) {
                Option::Some(end) => {
                    out = inline(&cx, out.push_static("<em>"), s.slice(i + 1usize, end), links).push_static("</em>");
                    i = end + 1usize;
                },
                Option::None => { out = out.push_byte(c); i = i + 1usize; },
            }
        } else if c == b'&' || c == b'<' || c == b'>' {
            out = html_escape(&cx, out, s.slice(i, i + 1usize));
            i = i + 1usize;
        } else { out = out.push_byte(c); i = i + 1usize; }
    }
    out
}

forall 'k.
fn table_row(&cx: Domain!['k], out: Buffer!, line: Span['k], header: bool, links: LinkContext['k]) -> Buffer! {
    var out = out.push_static("<tr>\n");
    var cell_start = 1usize;
    var j = 1usize;
    while j < line.len() {
        if at(&cx, line, j) == b'|' {
            out = out.push_static(if header { "<th>" } else { "<td>" });
            out = inline(&cx, out, line.slice(cell_start, j).trim(&cx), links);
            out = out.push_static(if header { "</th>\n" } else { "</td>\n" });
            cell_start = j + 1usize;
        }
        j = j + 1usize;
    }
    out.push_static("</tr>\n")
}

forall 'k.
fn heading_level(&cx: Domain!['k], line: Span['k]) -> usize {
    var level = 0usize;
    while level < 6usize && at(&cx, line, level) == b'#' { level = level + 1usize; }
    if level > 0usize && at(&cx, line, level) == b' ' { level } else { 0usize }
}

forall 'k.
fn attr_name(&cx: Domain!['k], name: Span['k]) -> bool {
    if name.is_empty() { return false; }
    var i = 0usize;
    while i < name.len() {
        let c = at(&cx, name, i);
        if !((c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z') ||
            (c >= b'0' && c <= b'9') || c == b'-' || c == b'_' || c == b':') { return false; }
        i = i + 1usize;
    }
    true
}

forall 'k.
fn heading_text(&cx: Domain!['k], source: Span['k]) -> Span['k] {
    var out = Buffer!::new();
    var i = 0usize;
    while i < source.len() {
        let c = at(&cx, source, i);
        let opening = if c == b'!' && at(&cx, source, i + 1usize) == b'[' { i + 1usize } else { i };
        if at(&cx, source, opening) == b'[' {
            match source.find_byte(&cx, b']', opening + 1usize) {
                Option::Some(end) => if at(&cx, source, end + 1usize) == b'(' {
                    match source.find_byte(&cx, b')', end + 2usize) {
                        Option::Some(close) => {
                            out = out.push_bytes(&cx, heading_text(&cx, source.slice(opening + 1usize, end)));
                            i = close + 1usize;
                        },
                        Option::None => { out = out.push_byte(c); i = i + 1usize; },
                    }
                } else { out = out.push_byte(c); i = i + 1usize; },
                Option::None => { out = out.push_byte(c); i = i + 1usize; },
            }
        } else if c == b'*' || c == b'`' { i = i + 1usize; }
        else { out = out.push_byte(c); i = i + 1usize; }
    }
    out.save(&cx)
}

forall 'k.
fn heading_slug(&cx: Domain!['k], text: Span['k]) -> Span['k] {
    var out = Buffer!::new();
    var pending_dash = false;
    var written = false;
    var i = 0usize;
    while i < text.len() {
        let c = at(&cx, text, i);
        let letter = (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z');
        let digit = c >= b'0' && c <= b'9';
        if letter || digit || c >= 128u8 {
            if pending_dash && written { out = out.push_byte(b'-'); }
            out = out.push_byte(if c >= b'A' && c <= b'Z' { c + 32u8 } else { c });
            written = true;
            pending_dash = false;
        } else if c == b' ' || c == b'\t' || c == b'-' || c == b'_' { pending_dash = true; }
        i = i + 1usize;
    }
    if written { out.save(&cx) } else { out.destroy(); lit(&cx, "section") }
}

forall 'k.
fn heading(&cx: Domain!['k], out: Buffer!, line: Span['k], level: usize,
    ids: ArenaMap[Span['k], bool, 'k], headings: ArenaVec[Heading['k], 'k], links: LinkContext['k]) -> Result[Buffer!, Span['k]] {
    var out = out;
    var text = line.slice(level + 1usize, line.len());
    var id = empty(&cx);
    var classes = Buffer!::new();
    var has_class = false;
    if text.ends_with(&cx, lit(&cx, "}")) {
        match text.find(&cx, lit(&cx, " {"), 0usize) {
            Option::Some(marker) => {
                let attrs = text.slice(marker + 2usize, text.len() - 1usize);
                if attrs.is_empty() { classes.destroy(); out.destroy(); return Result::Err.(lit(&cx, "empty heading attributes")); }
                text = text.slice(0usize, marker);
                var pos = 0usize;
                while pos < attrs.len() {
                    while pos < attrs.len() && at(&cx, attrs, pos) == b' ' { pos = pos + 1usize; }
                    if pos < attrs.len() {
                        var end = pos;
                        while end < attrs.len() && at(&cx, attrs, end) != b' ' { end = end + 1usize; }
                        let token = attrs.slice(pos, end);
                        let value = token.slice(1usize, token.len());
                        if (at(&cx, token, 0usize) != b'#' && at(&cx, token, 0usize) != b'.') || !attr_name(&cx, value) {
                            classes.destroy(); out.destroy(); return Result::Err.(lit(&cx, "invalid heading attribute"));
                        }
                        if at(&cx, token, 0usize) == b'#' {
                            if !id.is_empty() { classes.destroy(); out.destroy(); return Result::Err.(lit(&cx, "duplicate heading ID attribute")); }
                            id = value;
                        } else {
                            if has_class { classes = classes.push_byte(b' '); }
                            classes = classes.push_bytes(&cx, value);
                            has_class = true;
                        }
                        pos = end;
                    }
                }
            },
            Option::None => (),
        }
    }
    let plain = heading_text(&cx, text);
    if !id.is_empty() {
        if ids.contains(&cx, id) { classes.destroy(); out.destroy(); return Result::Err.(lit(&cx, "duplicate heading ID")); }
    } else {
        let slug = heading_slug(&cx, plain);
        id = slug;
        var number = 2usize;
        while ids.contains(&cx, id) {
            id = Buffer!::new().push_bytes(&cx, slug).push_byte(b'-').push_usize(number).save(&cx);
            number = number + 1usize;
        }
    }
    ids.insert(&cx, id, true);
    headings.push(&cx, Heading.{ level, text: plain, id });
    out = out.push_static("<h").push_usize(level);
    out = out.push_static(" id=\"").push_bytes(&cx, id).push_static("\"");
    let class_text = classes.save(&cx);
    if !class_text.is_empty() { out = out.push_static(" class=\"").push_bytes(&cx, class_text).push_static("\""); }
    Result::Ok.(inline(&cx, out.push_static(">"), text, links).push_static("</h").push_usize(level).push_static(">\n"))
}

forall 'k.
fn ordered_marker(&cx: Domain!['k], line: Span['k]) -> usize {
    var i = 0usize;
    while at(&cx, line, i) >= b'0' && at(&cx, line, i) <= b'9' { i = i + 1usize; }
    if i > 0usize && at(&cx, line, i) == b'.' && at(&cx, line, i + 1usize) == b' ' { i + 2usize }
    else { 0usize }
}

forall 'k.
fn list_marker(&cx: Domain!['k], line: Span['k]) -> Option[(usize, usize, bool)] {
    var indent = 0usize;
    while at(&cx, line, indent) == b' ' { indent = indent + 1usize; }
    let marker = line.slice(indent, line.len());
    if starts(&cx, marker, "- ") || starts(&cx, marker, "* ") || starts(&cx, marker, "+ ") {
        Option::Some.((indent, indent + 2usize, false))
    } else {
        let width = ordered_marker(&cx, marker);
        if width > 0usize { Option::Some.((indent, indent + width, true)) }
        else { Option::None }
    }
}

forall 'k.
fn quote_line(&cx: Domain!['k], line: Span['k]) -> Option[Span['k]] {
    var indent = 0usize;
    while indent < 4usize && at(&cx, line, indent) == b' ' { indent = indent + 1usize; }
    if indent > 3usize || at(&cx, line, indent) != b'>' { return Option::None; }
    let start = if at(&cx, line, indent + 1usize) == b' ' { indent + 2usize } else { indent + 1usize };
    Option::Some.(line.slice(start, line.len()))
}

forall 'k.
fn close_lists(&cx: Domain!['k], out: Buffer!, lists: ArenaVec[ListFrame, 'k]) -> Buffer! {
    var out = out;
    while lists.len(&cx) > 0usize {
        match lists.pop(&cx) {
            Option::Some(frame) => {
                out = out.push_static("</li>\n").push_static(if frame.ordered { "</ol>\n" } else { "</ul>\n" });
            },
            Option::None => (),
        }
    }
    out
}

forall 'k.
fn list_item(&cx: Domain!['k], out: Buffer!, lists: ArenaVec[ListFrame, 'k],
    line: Span['k], indent: usize, content_start: usize, ordered: bool, links: LinkContext['k]) -> Buffer! {
    var out = out;
    var adjusting = true;
    while adjusting && lists.len(&cx) > 0usize {
        let top = lists.at(&cx, lists.len(&cx) - 1usize);
        if indent < top.indent || (indent == top.indent && ordered != top.ordered) {
            match lists.pop(&cx) {
                Option::Some(frame) => {
                    out = out.push_static("</li>\n").push_static(if frame.ordered { "</ol>\n" } else { "</ul>\n" });
                },
                Option::None => (),
            }
        } else { adjusting = false; }
    }
    if lists.len(&cx) > 0usize {
        let top = lists.at(&cx, lists.len(&cx) - 1usize);
        if indent > top.indent && indent < top.content_indent {
            return inline(&cx, out.push_byte(b' '), line.trim(&cx), links);
        }
        if indent == top.indent { out = out.push_static("</li>\n"); }
        else {
            out = out.push_static(if ordered { "<ol>\n" } else { "<ul>\n" });
            lists.push(&cx, ListFrame.{ indent, content_indent: content_start, ordered });
        }
    } else {
        out = out.push_static(if ordered { "<ol>\n" } else { "<ul>\n" });
        lists.push(&cx, ListFrame.{ indent, content_indent: content_start, ordered });
    }
    inline(&cx, out.push_static("<li>"), line.slice(content_start, line.len()), links)
}

forall 'k.
fn render_blocks(&cx: Domain!['k], source: Span['k], links: LinkContext['k],
    ids: ArenaMap[Span['k], bool, 'k], headings: ArenaVec[Heading['k], 'k], depth: usize) -> Result[Buffer!, Span['k]] {
    if depth >= 32usize { return Result::Err.(lit(&cx, "Markdown containers nested too deeply")); }
    var out = Buffer!::new();
    let lists: ArenaVec[ListFrame, 'k] = ArenaVec::new(&cx);
    var pos = 0usize;
    var paragraph = false;
    var code = false;
    var code_lang = empty(&cx);
    var table = false;
    var table_body = false;
    while pos < source.len() {
        let (line, next) = next_line(&cx, source, pos);
        pos = next;
        if table && !starts(&cx, line, "| ") {
            out = out.push_static("</tbody>\n</table>\n");
            table = false;
            table_body = false;
        }
        let table_start = if starts(&cx, line, "| ") && !table && pos < source.len() {
            let (following, after) = next_line(&cx, source, pos);
            starts(&cx, following, "| ---")
        } else { false };
        let marker = list_marker(&cx, line);
        let quoted = quote_line(&cx, line);
        let use_marker = match marker {
            Option::Some(parts) => {
                let (indent, content_start, ordered) = parts;
                lists.len(&cx) > 0usize || indent <= 3usize
            },
            Option::None => false,
        };
        if starts(&cx, line, "```") {
            if paragraph { out = out.push_static("</p>\n"); paragraph = false; }
            out = close_lists(&cx, out, lists);
            if code { out = out.push_static("</code></pre>\n"); code = false; code_lang = empty(&cx); }
            else {
                let lang = line.slice(3usize, line.len());
                code_lang = lang;
                out = out.push_static("<pre><code");
                if !lang.is_empty() { out = html_escape(&cx, out.push_static(" class=\"language-"), lang).push_static("\""); }
                out = out.push_static(">"); code = true;
            }
        } else if code { out = out.push_buffer(render_line(&cx, code_lang, line)).push_byte(b'\n'); }
        else if depth == 0usize && line.is(&cx, "<!-- more -->") {
            if paragraph { out = out.push_static("</p>\n"); paragraph = false; }
            out = close_lists(&cx, out, lists);
        }
        else if line.is_empty() {
            if paragraph { out = out.push_static("</p>\n"); paragraph = false; }
            out = close_lists(&cx, out, lists);
            if table { out = out.push_static("</tbody>\n</table>\n"); table = false; table_body = false; }
        } else if quoted.is_some() {
            if paragraph { out = out.push_static("</p>\n"); paragraph = false; }
            out = close_lists(&cx, out, lists);
            let quote = Buffer!::new();
            var quote = match quoted {
                Option::Some(content) => quote.push_bytes(&cx, content).push_byte(b'\n'),
                Option::None => quote,
            };
            var gathering = true;
            while gathering && pos < source.len() {
                let (following, after) = next_line(&cx, source, pos);
                match quote_line(&cx, following) {
                    Option::Some(content) => {
                        quote = quote.push_bytes(&cx, content).push_byte(b'\n');
                        pos = after;
                    },
                    Option::None => { gathering = false; },
                }
            }
            let inner = match render_blocks(&cx, quote.save(&cx), links, ids, headings, depth + 1usize) {
                Result::Ok(html) => html,
                Result::Err(message) => { out.destroy(); return Result::Err.(message); },
            };
            out = out.push_static("<blockquote>\n").push_buffer(inner).push_static("</blockquote>\n");
        } else if starts(&cx, line, "<") {
            if paragraph { out = out.push_static("</p>\n"); paragraph = false; }
            out = close_lists(&cx, out, lists);
            out = out.push_bytes(&cx, line).push_byte(b'\n');
        } else if heading_level(&cx, line) > 0usize {
            if paragraph { out = out.push_static("</p>\n"); paragraph = false; }
            out = close_lists(&cx, out, lists);
            let level = heading_level(&cx, line);
            out = match heading(&cx, out, line, level, ids, headings, links) {
                Result::Ok(html) => html,
                Result::Err(message) => return Result::Err.(message),
            };
        } else if use_marker {
            if paragraph { out = out.push_static("</p>\n"); paragraph = false; }
            match marker {
                Option::Some(parts) => {
                    let (indent, content_start, ordered) = parts;
                    out = list_item(&cx, out, lists, line, indent, content_start, ordered, links);
                },
                Option::None => (),
            }
        } else if table || table_start {
            if paragraph { out = out.push_static("</p>\n"); paragraph = false; }
            out = close_lists(&cx, out, lists);
            if !table { out = out.push_static("<table>\n<thead>\n"); table = true; }
            if starts(&cx, line, "| ---") { out = out.push_static("</thead>\n<tbody>\n"); table_body = true; }
            else { out = table_row(&cx, out, line, !table_body, links); }
        } else {
            let continuation = if lists.len(&cx) > 0usize {
                let top = lists.at(&cx, lists.len(&cx) - 1usize);
                var count = 0usize;
                while at(&cx, line, count) == b' ' { count = count + 1usize; }
                count >= top.content_indent
            } else { false };
            if continuation { out = inline(&cx, out.push_byte(b' '), line.trim(&cx), links); }
            else {
                out = close_lists(&cx, out, lists);
                if !paragraph { out = out.push_static("<p>"); paragraph = true; }
                else { out = out.push_byte(b' '); }
                out = inline(&cx, out, line, links);
            }
        }
    }
    if paragraph { out = out.push_static("</p>\n"); }
    out = close_lists(&cx, out, lists);
    if code { out = out.push_static("</code></pre>\n"); }
    if table { out = out.push_static("</tbody>\n</table>\n"); }
    Result::Ok.(out)
}

forall 'k.
fn markdown(&cx: Domain!['k], source: Span['k], base: Span['k],
    urls: ArenaMap[Span['k], Span['k], 'k], asset_urls: ArenaMap[Span['k], Span['k], 'k],
    fingerprint_assets: bool, current: Span['k])
    -> Result[(Buffer!, ArenaVec[Heading['k], 'k]), Span['k]] {
    let headings = ArenaVec::new(&cx);
    let links = LinkContext.{ base, urls, asset_urls, fingerprint_assets, source: current };
    let html = render_blocks(&cx, source, links, ArenaMap::new(&cx), headings, 0usize)?;
    Result::Ok.((html, headings))
}
