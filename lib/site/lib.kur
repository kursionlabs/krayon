extern "C" fn getpid() -> i32;

forall 'k.
struct Config {
    input: Span['k],
    output: Span['k],
    layouts: Span['k],
    data: Span['k],
    assets: Span['k],
    fingerprint_assets: bool,
    base_path: Span['k],
    origin: Span['k],
    exclude: ArenaVec[Span['k], 'k],
    definitions: ArenaMap[Span['k], TomlValue['k], 'k],
}

forall 'k.
struct Build {
    source: Span['k],
    output: Span['k],
    layouts: Span['k],
    layouts_rel: Span['k],
    assets: Span['k],
    fingerprint_assets: bool,
    asset_urls: ArenaMap[Span['k], Span['k], 'k],
    data_dir: Span['k],
    base_path: Span['k],
    include_drafts: bool,
    exclude: ArenaVec[Span['k], 'k],
    site_data: ArenaMap[Span['k], TomlValue['k], 'k],
    definitions: ArenaMap[Span['k], TomlValue['k], 'k],
    config_file: Span['k],
    collections: ArenaMap[Span['k], TomlValue['k], 'k],
    navigation: ArenaMap[Span['k], TomlValue['k], 'k],
    source_urls: ArenaMap[Span['k], Span['k], 'k],
    pages: ArenaVec[SourcePage['k], 'k],
    redirects: ArenaVec[Redirect['k], 'k],
    pending_pagination: ArenaVec[PendingPagination['k], 'k],
    stylesheets: ArenaVec[Stylesheet['k], 'k],
    written: ArenaMap[Span['k], Span['k], 'k],
}

forall 'k.
struct SourcePage {
    file: Span['k],
    source_path: Option[Span['k]],
    page: Page['k],
    is_markdown: bool,
    format: TemplateFormat,
    destination: Span['k],
    excerpt: Option[Span['k]],
}

forall 'k.
struct Redirect {
    url: Span['k],
    destination: Span['k],
    target: Span['k],
}

forall 'k.
struct PendingPagination {
    file: Span['k],
    page: Page['k],
    source: Span['k],
    default_url: Span['k],
}

forall 'k.
struct PaginationPattern {
    prefix: Span['k],
    suffix: Span['k],
}

forall 'k.
fn lit(&cx: Domain!['k], s: Slice[u8, 'static]) -> Span['k] { Span::from_static(&cx, s) }

// A standalone marker outside a fenced block splits the rendered excerpt.
forall 'k.
fn markdown_excerpt_source(&cx: Domain!['k], source: Span['k]) -> Option[Span['k]] {
    var pos = 0usize;
    var code = false;
    while pos < source.len() {
        let start = pos;
        let end = match source.find_byte(&cx, b'\n', pos) {
            Option::Some(at) => at,
            Option::None => source.len(),
        };
        let line = source.slice(pos, end).trim_end(&cx);
        pos = if end < source.len() { end + 1usize } else { end };
        if line.starts_with(&cx, lit(&cx, "```")) { code = !code; }
        else if !code && line.is(&cx, "<!-- more -->") {
            return Option::Some.(source.slice(0usize, start));
        }
    }
    Option::None
}

forall 'k.
fn byte(&cx: Domain!['k], s: Span['k], i: usize) -> u8 { s.byte_or_zero(&cx, i) }

forall 'k.
fn join(&cx: Domain!['k], a: Span['k], b: Span['k]) -> Span['k] {
    if b.is_empty() { return a; }
    if a.is_empty() { return b; }
    let separator = if a.ends_with(&cx, lit(&cx, "/")) { "" } else { "/" };
    Buffer!::new().push_bytes(&cx, a).push_static(separator).push_bytes(&cx, b).save(&cx)
}

forall 'k.
fn report(&cx: Domain!['k], action: Slice[u8, 'static], file: Span['k]) -> Buffer! {
    Buffer!::new().push_static("krayon: ").push_static(action).push_static(": ").push_bytes(&cx, file).push_byte(b'\n')
}

forall 'k.
fn report_detail(&cx: Domain!['k], file: Span['k], detail: Span['k]) -> Buffer! {
    Buffer!::new().push_static("krayon: ").push_bytes(&cx, file).push_static(": ").push_bytes(&cx, detail).push_byte(b'\n')
}

forall 'k.
fn report_template(&cx: Domain!['k], detail: Span['k]) -> Buffer! {
    Buffer!::new().push_static("krayon: ").push_bytes(&cx, detail).push_byte(b'\n')
}

forall 'k.
fn report_generated(&cx: Domain!['k], source: SourcePage['k], rendered: Span['k],
    kind: Slice[u8, 'static], offset: usize, detail: Slice[u8, 'static]) -> Buffer! {
    var line = 1usize;
    var column = 1usize;
    var i = 0usize;
    while i < offset {
        let c = rendered.byte_or_zero(&cx, i);
        if c == b'\n' { line = line + 1usize; column = 1usize; }
        else if c < 128u8 || c >= 192u8 { column = column + 1usize; }
        i = i + 1usize;
    }
    Buffer!::new().push_static("krayon: ").push_bytes(&cx, source.file)
        .push_static(": generated ").push_static(kind).push_byte(b' ')
        .push_bytes(&cx, source.page.url).push_byte(b':')
        .push_usize(line).push_byte(b':').push_usize(column).push_static(": ")
        .push_static(detail).push_byte(b'\n')
}

forall 'k.
fn exists_path(&cx: Domain!['k], file: Span['k]) -> Result[bool, Buffer!] {
    match path_exists(&cx, file) {
        Result::Ok(found) => Result::Ok.(found),
        Result::Err(e) => Result::Err.(report(&cx, "cannot stat", file)),
    }
}

forall 'k.
fn load(&cx: Domain!['k], file: Span['k]) -> Result[Span['k], Buffer!] {
    match read_to_arena(&cx, file) {
        Result::Ok(text) => Result::Ok.(text),
        Result::Err(e) => Result::Err.(report(&cx, "cannot read", file)),
    }
}

forall 'k.
fn ensure_one(&cx: Domain!['k], directory: Span['k]) -> Result[(), Buffer!] {
    if directory.is_empty() { return Result::Ok.(()); }
    match metadata(&cx, directory) {
        Result::Ok(m) => match m.kind {
            FileKind::Directory => Result::Ok.(()),
            _ => Result::Err.(report(&cx, "expected directory", directory)),
        },
        Result::Err(e) => {
            if e.errno != 2i32 { return Result::Err.(report(&cx, "cannot stat", directory)); }
            match mkdir(&cx, directory) {
                Result::Ok(nothing) => Result::Ok.(()),
                Result::Err(e) => Result::Err.(report(&cx, "cannot create directory", directory)),
            }
        },
    }
}

forall 'k.
fn ensure_dir(&cx: Domain!['k], directory: Span['k]) -> Result[(), Buffer!] {
    var i = 1usize;
    while i < directory.len() {
        if byte(&cx, directory, i) == b'/' { ensure_one(&cx, directory.slice(0usize, i))?; }
        i = i + 1usize;
    }
    ensure_one(&cx, directory)
}

forall 'k.
fn parent(&cx: Domain!['k], file: Span['k]) -> Span['k] {
    var i = file.len();
    while i > 0usize {
        i = i - 1usize;
        if byte(&cx, file, i) == b'/' { return file.slice(0usize, i); }
    }
    lit(&cx, "")
}

forall 'k.
fn save(&cx: Domain!['k], file: Span['k], contents: Buffer!) -> Result[(), Buffer!] {
    match ensure_dir(&cx, parent(&cx, file)) {
        Result::Ok(nothing) => (),
        Result::Err(message) => { contents.destroy(); return Result::Err.(message); },
    }
    match write(&cx, file, contents) {
        Result::Ok(nothing) => Result::Ok.(()),
        Result::Err(e) => Result::Err.(report(&cx, "cannot write", file)),
    }
}

forall 'k.
fn init(&cx: Domain!['k], root: Span['k]) -> Result[(), Buffer!] {
    match metadata(&cx, root) {
        Result::Ok(info) => {
            match info.kind {
                FileKind::Directory => (),
                _ => return Result::Err.(report(&cx, "expected directory", root)),
            }
            let opened = match read_dir(&cx, root) {
                Result::Ok(directory) => directory,
                Result::Err(e) => return Result::Err.(report(&cx, "cannot list", root)),
            };
            var opened = opened;
            let first = &opened.next();
            match first {
                Result::Err(e) => {
                    let closed = opened.close();
                    return Result::Err.(report(&cx, "cannot list", root));
                },
                Result::Ok(next) => match next {
                    Option::Some(entry) => {
                        let { name, is_directory } = entry;
                        name.destroy();
                        let closed = opened.close();
                        return Result::Err.(report(&cx, "directory is not empty", root));
                    },
                    Option::None => (),
                },
            }
            match opened.close() {
                Result::Ok(nothing) => (),
                Result::Err(e) => return Result::Err.(report(&cx, "cannot list", root)),
            }
        },
        Result::Err(e) => {
            if e.errno != 2i32 { return Result::Err.(report(&cx, "cannot stat", root)); }
            ensure_dir(&cx, root)?;
        },
    }
    save(&cx, join(&cx, root, lit(&cx, "krayon.toml")),
        Buffer!::new().push_static("input = \"src\"\noutput = \"dist\"\n"))?;
    save(&cx, join(&cx, root, lit(&cx, ".gitignore")),
        Buffer!::new().push_static("/dist/\n"))?;
    save(&cx, join(&cx, root, lit(&cx, "src/_includes/base.html")),
        Buffer!::new().push_static("<!doctype html>\n<html lang=\"en\">\n<head>\n")
            .push_static("  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n")
            .push_static("  <title>{{ page.title }}</title>\n</head>\n<body>\n  <main>{{ content | safe }}</main>\n")
            .push_static("</body>\n</html>\n"))?;
    save(&cx, join(&cx, root, lit(&cx, "src/index.md")),
        Buffer!::new().push_static("+++\ntitle = \"Home\"\nlayout = \"base.html\"\n+++\n\n")
            .push_static("# Welcome to Krayon\n\nEdit `src/index.md` to get started.\n"))?;
    Result::Ok.(())
}

// Relative config paths and URL path components cannot escape their root.
forall 'k.
fn safe_path(&cx: Domain!['k], path: Span['k], absolute: bool) -> bool {
    if path.is_empty() { return false; }
    if absolute != (byte(&cx, path, 0usize) == b'/') { return false; }
    var start = if absolute { 1usize } else { 0usize };
    var i = start;
    while i <= path.len() {
        if i == path.len() || byte(&cx, path, i) == b'/' {
            let part = path.slice(start, i);
            if part.is(&cx, ".") || part.is(&cx, "..") { return false; }
            if part.is_empty() && (i < path.len() || !absolute) { return false; }
            start = i + 1usize;
        } else if byte(&cx, path, i) == b'\\' || byte(&cx, path, i) == 0u8 { return false; }
        i = i + 1usize;
    }
    true
}

forall 'k.
fn config_string(&cx: Domain!['k], values: ArenaMap[Span['k], TomlValue['k], 'k], name: Slice[u8, 'static], fallback: Slice[u8, 'static]) -> Result[Span['k], Buffer!] {
    match values.get(&cx, lit(&cx, name)) {
        Option::None => Result::Ok.(lit(&cx, fallback)),
        Option::Some(value) => match value.as_string() {
            Option::None => Result::Err.(Buffer!::new().push_static("krayon: config value must be a string: ").push_static(name).push_byte(b'\n')),
            Option::Some(text) => if safe_path(&cx, text, false) { Result::Ok.(text) }
                else { Result::Err.(Buffer!::new().push_static("krayon: unsafe config path: ").push_static(name).push_byte(b'\n')) },
        },
    }
}

forall 'k.
fn read_config(&cx: Domain!['k], root: Span['k]) -> Result[Config['k], Buffer!] {
    let file = join(&cx, root, lit(&cx, "krayon.toml"));
    let defaults = Config.{ input: lit(&cx, "src"), output: lit(&cx, "dist"), layouts: lit(&cx, "_includes"),
        data: lit(&cx, "_data/site.toml"), assets: lit(&cx, "assets"), fingerprint_assets: false, base_path: lit(&cx, ""),
        origin: lit(&cx, ""), exclude: ArenaVec::new(&cx), definitions: ArenaMap::new(&cx) };
    if !exists_path(&cx, file)? { return Result::Ok.(defaults); }
    let text = load(&cx, file)?;
    match parse(&cx, text) {
        Result::Err(e) => Result::Err.(report_detail(&cx, file, lit(&cx, e.message))),
        Result::Ok(values) => {
            var i = 0usize;
            while i < values.positions(&cx) {
                match values.key_at(&cx, i) {
                    Option::None => (),
                    Option::Some(key) => {
                        if !key.is(&cx, "input") && !key.is(&cx, "output") && !key.is(&cx, "layouts")
                            && !key.is(&cx, "data") && !key.is(&cx, "assets") && !key.is(&cx, "base_path")
                            && !key.is(&cx, "origin") && !key.is(&cx, "exclude") && !key.is(&cx, "fingerprint_assets")
                            && !key.is(&cx, "collections") {
                            return Result::Err.(report(&cx, "unknown config key", key));
                        }
                    },
                }
                i = i + 1usize;
            }
            let base_path = match values.get(&cx, lit(&cx, "base_path")) {
                Option::None => lit(&cx, ""),
                Option::Some(value) => match value.as_string() {
                    Option::None => return Result::Err.(report(&cx, "base_path must be a string", file)),
                    Option::Some(path) => {
                        if path.is_empty() { path }
                        else if path.is(&cx, "/") { lit(&cx, "") }
                        else if !safe_path(&cx, path, true) || byte(&cx, path, path.len() - 1usize) == b'/' {
                            return Result::Err.(report(&cx, "unsafe base_path", path));
                        } else {
                            var j = 0usize;
                            while j < path.len() {
                                let c = byte(&cx, path, j);
                                let allowed = (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z')
                                    || (c >= b'0' && c <= b'9') || c == b'/' || c == b'-'
                                    || c == b'_' || c == b'.' || c == b'~';
                                if !allowed { return Result::Err.(report(&cx, "unsafe base_path", path)); }
                                j = j + 1usize;
                            }
                            path
                        }
                    },
                },
            };
            let origin = match values.get(&cx, lit(&cx, "origin")) {
                Option::None => lit(&cx, ""),
                Option::Some(value) => match value.as_string() {
                    Option::None => return Result::Err.(report(&cx, "origin must be a string", file)),
                    Option::Some(text) => {
                        let normalized = if text.is_empty() { text }
                            else if text.ends_with(&cx, lit(&cx, "/")) {
                                text.slice(0usize, text.len() - 1usize)
                            } else { text };
                        if !normalized.is_empty() && !valid_origin(&cx, normalized) {
                            return Result::Err.(report(&cx, "invalid origin", text));
                        }
                        normalized
                    },
                },
            };
            let definitions = match values.get(&cx, lit(&cx, "collections")) {
                Option::None => ArenaMap::new(&cx),
                Option::Some(value) => match value.as_table() {
                    Option::Some(table) => table,
                    Option::None => return Result::Err.(report(&cx, "collections must be a table", file)),
                },
            };
            let fingerprint_assets = match values.get(&cx, lit(&cx, "fingerprint_assets")) {
                Option::None => false,
                Option::Some(value) => match value {
                    TomlValue::Boolean(enabled) => enabled,
                    _ => return Result::Err.(report(&cx, "fingerprint_assets must be a boolean", file)),
                },
            };
            let exclude = ArenaVec::new(&cx);
            match values.get(&cx, lit(&cx, "exclude")) {
                Option::None => (),
                Option::Some(value) => {
                    let rules = match value.as_array() {
                        Option::Some(items) => items,
                        Option::None => return Result::Err.(report(&cx, "exclude must be an array of paths", file)),
                    };
                    var j = 0usize;
                    while j < rules.len(&cx) {
                        let rule = match rules.at(&cx, j).as_string() {
                            Option::Some(path) => path,
                            Option::None => return Result::Err.(report(&cx, "exclude entry must be a string path", file)),
                        };
                        let path = if rule.ends_with(&cx, lit(&cx, "/")) {
                            rule.slice(0usize, rule.len() - 1usize)
                        } else { rule };
                        if !safe_path(&cx, path, false) || !valid_glob(&cx, path)
                            || rule.find_byte(&cx, b'?', 0usize).is_some()
                            || rule.find_byte(&cx, b'[', 0usize).is_some()
                            || rule.find_byte(&cx, b']', 0usize).is_some() {
                            return Result::Err.(report_detail(&cx, file,
                                Buffer!::new().push_static("invalid exclude path: ").push_bytes(&cx, rule).save(&cx)));
                        }
                        exclude.push(&cx, rule);
                        j = j + 1usize;
                    }
                },
            }
            Result::Ok.(Config.{
                input: config_string(&cx, values, "input", "src")?,
                output: config_string(&cx, values, "output", "dist")?,
                layouts: config_string(&cx, values, "layouts", "_includes")?,
                data: config_string(&cx, values, "data", "_data/site.toml")?,
                assets: config_string(&cx, values, "assets", "assets")?,
                fingerprint_assets,
                base_path,
                origin,
                exclude,
                definitions,
            })
        },
    }
}

forall 'k.
fn claim(&cx: Domain!['k], build: Build['k], output: Span['k], source: Span['k]) -> Result[(), Buffer!] {
    match build.written.insert(&cx, output, source) {
        Option::None => Result::Ok.(()),
        Option::Some(previous) => Result::Err.(Buffer!::new().push_static("krayon: output collision: ")
            .push_bytes(&cx, previous).push_static(" and ").push_bytes(&cx, source).push_static(" -> ").push_bytes(&cx, output).push_byte(b'\n')),
    }
}

forall 'k.
fn source_url(&cx: Domain!['k], relative: Span['k], ext_len: usize) -> Span['k] {
    let stem = relative.slice(0usize, relative.len() - ext_len);
    if stem.is(&cx, "index") { return lit(&cx, "/"); }
    let index = lit(&cx, "/index");
    if stem.ends_with(&cx, index) {
        return Buffer!::new().push_static("/").push_bytes(&cx, stem.slice(0usize, stem.len() - 5usize)).save(&cx);
    }
    Buffer!::new().push_static("/").push_bytes(&cx, stem).push_static("/").save(&cx)
}

forall 'k.
fn page_format(&cx: Domain!['k], relative: Span['k]) -> TemplateFormat {
    if relative.ends_with(&cx, lit(&cx, ".xml")) { TemplateFormat::Xml }
    else if relative.ends_with(&cx, lit(&cx, ".json")) { TemplateFormat::Json }
    else if relative.ends_with(&cx, lit(&cx, ".txt")) { TemplateFormat::Text }
    else { TemplateFormat::Html }
}

forall 'k.
fn format_suffix(&cx: Domain!['k], format: TemplateFormat) -> Span['k] {
    lit(&cx, match format {
        TemplateFormat::Html => ".html",
        TemplateFormat::Xml => ".xml",
        TemplateFormat::Json => ".json",
        TemplateFormat::Text => ".txt",
    })
}

forall 'k.
fn output_for_url(&cx: Domain!['k], output: Span['k], url: Span['k], source: Span['k],
    format: TemplateFormat) -> Result[Span['k], Buffer!] {
    if !safe_path(&cx, url, true) { return Result::Err.(report_detail(&cx, source,
        Buffer!::new().push_static("unsafe URL: ").push_bytes(&cx, url).save(&cx))); }
    let relative = url.slice(1usize, url.len());
    match format {
        TemplateFormat::Html => if url.ends_with(&cx, lit(&cx, "/")) {
            return Result::Ok.(join(&cx, output, join(&cx, relative, lit(&cx, "index.html"))));
        },
        _ => (),
    }
    if url.ends_with(&cx, format_suffix(&cx, format)) {
        return Result::Ok.(join(&cx, output, relative));
    }
    let expected = match format {
        TemplateFormat::Html => "/ or .html",
        TemplateFormat::Xml => ".xml",
        TemplateFormat::Json => ".json",
        TemplateFormat::Text => ".txt",
    };
    Result::Err.(report_detail(&cx, source,
        Buffer!::new().push_static("URL must end in ").push_static(expected)
            .push_static(": ").push_bytes(&cx, url).save(&cx)))
}

forall 'k.
fn add_aliases(&cx: Domain!['k], build: Build['k], file: Span['k],
    fields: ArenaMap[Span['k], TomlValue['k], 'k], canonical: Span['k]) -> Result[(), Buffer!] {
    let aliases = match fields.get(&cx, lit(&cx, "aliases")) {
        Option::None => return Result::Ok.(()),
        Option::Some(value) => match value.as_array() {
            Option::Some(items) => items,
            Option::None => return Result::Err.(report_detail(&cx, file, lit(&cx, "aliases must be an array of URLs"))),
        },
    };
    var i = 0usize;
    while i < aliases.len(&cx) {
        let label = Buffer!::new().push_bytes(&cx, file).push_static(" [alias ")
            .push_usize(i + 1usize).push_static("]").save(&cx);
        let alias = match aliases.at(&cx, i).as_string() {
            Option::Some(url) => url,
            Option::None => return Result::Err.(report_detail(&cx, label, lit(&cx, "alias must be a string URL"))),
        };
        let destination = output_for_url(&cx, build.output, alias, label, TemplateFormat::Html)?;
        claim(&cx, build, destination, label)?;
        build.redirects.push(&cx, Redirect.{ url: alias, destination, target: canonical });
        i = i + 1usize;
    }
    Result::Ok.(())
}

forall 'k.
fn escape_redirect(&cx: Domain!['k], out: Buffer!, value: Span['k]) -> Buffer! {
    var out = out;
    var i = 0usize;
    while i < value.len() {
        let c = byte(&cx, value, i);
        out = if c == b'&' { out.push_static("&amp;") }
            else if c == b'<' { out.push_static("&lt;") }
            else if c == b'>' { out.push_static("&gt;") }
            else if c == b'"' { out.push_static("&quot;") }
            else if c == b'\'' { out.push_static("&#39;") }
            else { out.push_byte(c) };
        i = i + 1usize;
    }
    out
}

forall 'k.
fn write_redirects(&cx: Domain!['k], build: Build['k]) -> Result[(), Buffer!] {
    var i = 0usize;
    while i < build.redirects.len(&cx) {
        let redirect = build.redirects.at(&cx, i);
        let target = prefix(&cx, build.base_path, redirect.target);
        var html = Buffer!::new().push_static("<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">")
            .push_static("<meta name=\"robots\" content=\"noindex\">")
            .push_static("<meta http-equiv=\"refresh\" content=\"0; url=");
        html = escape_redirect(&cx, html, target).push_static("\"></head><body><p>This page moved to ")
            .push_static("<a href=\"");
        html = escape_redirect(&cx, html, target).push_static("\">the new page</a>.</p></body></html>\n");
        save(&cx, redirect.destination, html)?;
        i = i + 1usize;
    }
    Result::Ok.(())
}

forall 'k.
fn layout_name(&cx: Domain!['k], data: ArenaMap[Span['k], TomlValue['k], 'k]) -> Result[Option[Span['k]], Buffer!] {
    match data.get(&cx, lit(&cx, "layout")) {
        Option::None => Result::Ok.(Option::None),
        Option::Some(value) => match value.as_string() {
            Option::None => Result::Err.(Buffer!::new().push_static("krayon: layout must be a string\n")),
            Option::Some(name) => if name.is_empty() { Result::Ok.(Option::None) }
                else if safe_path(&cx, name, false) { Result::Ok.(Option::Some.(name)) }
                else { Result::Err.(report(&cx, "unsafe layout name", name)) },
        },
    }
}

forall 'k.
fn site_value(&cx: Domain!['k], data: ArenaMap[Span['k], TomlValue['k], 'k], path: Span['k]) -> Option[TomlValue['k]] {
    var table = data;
    var remaining = path;
    while true {
        match remaining.find_byte(&cx, b'.', 0usize) {
            Option::Some(dot) => {
                let name = remaining.slice(0usize, dot);
                if name.is_empty() { return Option::None; }
                table = match table.get(&cx, name) {
                    Option::Some(value) => match value.as_table() {
                        Option::Some(child) => child,
                        Option::None => return Option::None,
                    },
                    Option::None => return Option::None,
                };
                remaining = remaining.slice(dot + 1usize, remaining.len());
            },
            Option::None => if remaining.is_empty() { return Option::None; }
                else { return table.get(&cx, remaining); },
        }
    }
    Option::None
}

forall 'k.
fn draft(&cx: Domain!['k], data: ArenaMap[Span['k], TomlValue['k], 'k], file: Span['k]) -> Result[bool, Buffer!] {
    match data.get(&cx, lit(&cx, "draft")) {
        Option::None => Result::Ok.(false),
        Option::Some(value) => match value.as_bool() {
            Option::Some(flag) => Result::Ok.(flag),
            Option::None => Result::Err.(report_detail(&cx, file, lit(&cx, "draft must be a boolean"))),
        },
    }
}

forall 'k.
fn permalink_pattern(&cx: Domain!['k], pattern: Span['k], record: ArenaMap[Span['k], TomlValue['k], 'k],
    field_prefix: Slice[u8, 'static])
    -> Result[Span['k], Span['k]] {
    var out = Buffer!::new();
    var pos = 0usize;
    while pos < pattern.len() {
        let opening = match pattern.find(&cx, lit(&cx, "{{"), pos) {
            Option::Some(at) => at,
            Option::None => pattern.len(),
        };
        match pattern.find(&cx, lit(&cx, "}}"), pos) {
            Option::Some(at) => if at < opening {
                out.destroy(); return Result::Err.(lit(&cx, "unexpected }} in permalink pattern"));
            },
            Option::None => (),
        }
        out = out.push_bytes(&cx, pattern.slice(pos, opening));
        if opening == pattern.len() { return Result::Ok.(out.save(&cx)); }
        let closing = match pattern.find(&cx, lit(&cx, "}}"), opening + 2usize) {
            Option::Some(at) => at,
            Option::None => { out.destroy(); return Result::Err.(lit(&cx, "unclosed permalink placeholder")); },
        };
        let expression = pattern.slice(opening + 2usize, closing).trim(&cx);
        let prefix = lit(&cx, field_prefix);
        if !expression.starts_with(&cx, prefix) || expression.len() <= prefix.len() {
            out.destroy(); return Result::Err.(Buffer!::new().push_static("permalink placeholders must use ")
                .push_static(field_prefix).push_static("<field>").save(&cx));
        }
        let value = match site_value(&cx, record, expression.slice(prefix.len(), expression.len())) {
            Option::Some(value) => value,
            Option::None => { out.destroy(); return Result::Err.(Buffer!::new().push_static("missing permalink field: ")
                .push_bytes(&cx, expression).save(&cx)); },
        };
        let text = match value {
            TomlValue::String(text) => text,
            TomlValue::Integer(number) => Buffer!::new().push_i64(number).save(&cx),
            TomlValue::Datetime(date) => date.text,
            _ => { out.destroy(); return Result::Err.(Buffer!::new().push_static("permalink field must be a string, integer, or date: ")
                .push_bytes(&cx, expression).save(&cx)); },
        };
        out = out.push_bytes(&cx, text);
        pos = closing + 2usize;
    }
    Result::Ok.(out.save(&cx))
}

forall 'k.
fn generated_fields(&cx: Domain!['k], defaults: ArenaMap[Span['k], TomlValue['k], 'k],
    record: ArenaMap[Span['k], TomlValue['k], 'k]) -> ArenaMap[Span['k], TomlValue['k], 'k] {
    let fields = ArenaMap::new(&cx);
    var i = 0usize;
    while i < defaults.positions(&cx) {
        match defaults.key_at(&cx, i) {
            Option::None => (),
            Option::Some(key) => if !key.is(&cx, "generate") && !key.is(&cx, "permalink_pattern") {
                match defaults.get(&cx, key) {
                    Option::None => (),
                    Option::Some(value) => { let replaced = fields.insert(&cx, key, value); },
                }
            },
        }
        i = i + 1usize;
    }
    i = 0usize;
    while i < record.positions(&cx) {
        match record.key_at(&cx, i) {
            Option::None => (),
            Option::Some(key) => match record.get(&cx, key) {
                Option::None => (),
                Option::Some(value) => { let replaced = fields.insert(&cx, key, value); },
            },
        }
        i = i + 1usize;
    }
    fields
}

forall 'k.
fn merge_defaults(&cx: Domain!['k], inherited: ArenaMap[Span['k], TomlValue['k], 'k],
    local: ArenaMap[Span['k], TomlValue['k], 'k]) -> ArenaMap[Span['k], TomlValue['k], 'k] {
    let fields = ArenaMap::new(&cx);
    var i = 0usize;
    while i < inherited.positions(&cx) {
        match inherited.key_at(&cx, i) {
            Option::Some(key) => match inherited.get(&cx, key) {
                Option::Some(value) => { let replaced = fields.insert(&cx, key, value); },
                Option::None => (),
            },
            Option::None => (),
        }
        i = i + 1usize;
    }
    i = 0usize;
    while i < local.positions(&cx) {
        match local.key_at(&cx, i) {
            Option::Some(key) => match local.get(&cx, key) {
                Option::Some(value) => { let replaced = fields.insert(&cx, key, value); },
                Option::None => (),
            },
            Option::None => (),
        }
        i = i + 1usize;
    }
    fields
}

forall 'k.
fn directory_defaults(&cx: Domain!['k], build: Build['k], relative: Span['k],
    inherited: ArenaMap[Span['k], TomlValue['k], 'k]) -> Result[ArenaMap[Span['k], TomlValue['k], 'k], Buffer!] {
    let file = join(&cx, join(&cx, build.source, relative), lit(&cx, "_defaults.toml"));
    if !exists_path(&cx, file)? { return Result::Ok.(inherited); }
    let source = load(&cx, file)?;
    let local = match parse(&cx, source) {
        Result::Ok(fields) => fields,
        Result::Err(error) => return Result::Err.(report_detail(&cx, file, lit(&cx, error.message))),
    };
    var i = 0usize;
    while i < local.positions(&cx) {
        match local.key_at(&cx, i) {
            Option::Some(key) => if key.is(&cx, "permalink") || key.is(&cx, "generate")
                || key.is(&cx, "paginate") || key.is(&cx, "page_size")
                || key.is(&cx, "page_permalink") || key.is(&cx, "where")
                || key.is(&cx, "sort_by") || key.is(&cx, "sort_order")
                || key.is(&cx, "pagination") || key.is(&cx, "headings")
                || key.is(&cx, "collection_navigation") || key.is(&cx, "url")
                || key.is(&cx, "aliases") {
                return Result::Err.(report_detail(&cx, file,
                    Buffer!::new().push_static("field cannot be a directory default: ").push_bytes(&cx, key).save(&cx)));
            },
            Option::None => (),
        }
        i = i + 1usize;
    }
    match local.get(&cx, lit(&cx, "permalink_pattern")) {
        Option::Some(value) => match value.as_string() {
            Option::Some(pattern) => if pattern.is_empty() {
                return Result::Err.(report_detail(&cx, file, lit(&cx, "permalink_pattern must not be empty")));
            },
            Option::None => return Result::Err.(report_detail(&cx, file, lit(&cx, "permalink_pattern must be a string"))),
        },
        Option::None => (),
    }
    Result::Ok.(merge_defaults(&cx, inherited, local))
}

forall 'k.
fn generate_pages(&cx: Domain!['k], build: Build['k], file: Span['k], template_page: Page['k],
    source: Span['k], format: TemplateFormat) -> Result[(), Buffer!] {
    if !source.starts_with(&cx, lit(&cx, "site.")) || source.len() <= 5usize {
        return Result::Err.(report_detail(&cx, file, lit(&cx, "generate must name a site data array, such as site.products")));
    }
    let pattern = match template_page.data.get(&cx, lit(&cx, "permalink")) {
        Option::None => Option::None,
        Option::Some(value) => match value.as_string() {
            Option::Some(text) => Option::Some.(text),
            Option::None => return Result::Err.(report_detail(&cx, file, lit(&cx, "permalink must be a string"))),
        },
    };
    match draft(&cx, template_page.data, file) {
        Result::Ok(flag) => (),
        Result::Err(message) => return Result::Err.(message),
    }
    let value = match site_value(&cx, build.site_data, source.slice(5usize, source.len())) {
        Option::Some(found) => found,
        Option::None => return Result::Err.(report_detail(&cx, file, lit(&cx, "generate source is missing"))),
    };
    let items = match value.as_array() {
        Option::Some(array) => array,
        Option::None => return Result::Err.(report_detail(&cx, file, lit(&cx, "generate source must be an array"))),
    };
    var i = 0usize;
    while i < items.len(&cx) {
        let label = Buffer!::new().push_bytes(&cx, file).push_static(" [item ")
            .push_usize(i + 1usize).push_static("]").save(&cx);
        let record = match items.at(&cx, i).as_table() {
            Option::Some(table) => table,
            Option::None => return Result::Err.(report_detail(&cx, label, lit(&cx, "generate item must be a table"))),
        };
        let fields = generated_fields(&cx, template_page.data, record);
        if fields.contains(&cx, lit(&cx, "aliases")) {
            return Result::Err.(report_detail(&cx, label, lit(&cx, "aliases require an ordinary page")));
        }
        let is_draft = draft(&cx, fields, label)?;
        if build.include_drafts || !is_draft {
            let url = match record.get(&cx, lit(&cx, "url")) {
                Option::Some(value) => match value.as_string() {
                    Option::Some(text) => text,
                    Option::None => return Result::Err.(report_detail(&cx, label, lit(&cx, "generate item url must be a string"))),
                },
                Option::None => match pattern {
                    Option::Some(text) => match permalink_pattern(&cx, text, record, "item.") {
                        Result::Ok(url) => url,
                        Result::Err(message) => return Result::Err.(report_detail(&cx, label, message)),
                    },
                    Option::None => return Result::Err.(report_detail(&cx, label, lit(&cx, "generate item needs a url or template permalink"))),
                },
            };
            let destination = output_for_url(&cx, build.output, url, label, format)?;
            claim(&cx, build, destination, label)?;
            let replaced = fields.insert(&cx, lit(&cx, "permalink"), TomlValue::String.(url));
            let page = Page.{ data: fields, source_urls: build.source_urls,
                url, body: template_page.body, body_line: template_page.body_line };
            build.pages.push(&cx, SourcePage.{ file: label, source_path: Option::None, page, is_markdown: false, format,
                destination, excerpt: Option::None });
        }
        i = i + 1usize;
    }
    Result::Ok.(())
}

forall 'k.
fn pagination_url(&cx: Domain!['k], base: Span['k], pattern: Option[PaginationPattern['k]], number: usize) -> Span['k] {
    if number == 1usize { return base; }
    match pattern {
        Option::Some(parts) => Buffer!::new().push_bytes(&cx, parts.prefix).push_usize(number)
            .push_bytes(&cx, parts.suffix).save(&cx),
        Option::None => Buffer!::new().push_bytes(&cx, base).push_static("page/").push_usize(number)
            .push_byte(b'/').save(&cx),
    }
}

forall 'k.
fn select_records(&cx: Domain!['k], all: ArenaVec[TomlValue['k], 'k],
    rules: ArenaMap[Span['k], TomlValue['k], 'k], file: Span['k]) -> Result[ArenaVec[TomlValue['k], 'k], Buffer!] {
    let all = match rules.get(&cx, lit(&cx, "where")) {
        Option::None => all,
        Option::Some(value) => {
            let rule = match value.as_table() {
                Option::Some(table) => table,
                Option::None => return Result::Err.(report_detail(&cx, file,
                    lit(&cx, "where must be a table with field and equals"))),
            };
            let field = match rule.get(&cx, lit(&cx, "field")) {
                Option::Some(value) => match value.as_string() {
                    Option::Some(text) => text,
                    Option::None => return Result::Err.(report_detail(&cx, file, lit(&cx, "where.field must be a string"))),
                },
                Option::None => return Result::Err.(report_detail(&cx, file, lit(&cx, "where requires field"))),
            };
            let equals = rule.get(&cx, lit(&cx, "equals"));
            let contains = rule.get(&cx, lit(&cx, "contains"));
            if equals.is_some() && contains.is_some() {
                return Result::Err.(report_detail(&cx, file,
                    lit(&cx, "where accepts either equals or contains")));
            }
            let membership = contains.is_some();
            let target_value = if membership { contains } else { equals };
            let target = match target_value {
                Option::Some(value) => match scalar(&cx, value) {
                    Option::Some(text) => text,
                    Option::None => return Result::Err.(report_detail(&cx, file,
                        lit(&cx, "where value must be a string, integer, boolean, or date"))),
                },
                Option::None => return Result::Err.(report_detail(&cx, file, lit(&cx, "where requires equals or contains"))),
            };
            let filtered = if membership { filter_contains(&cx, all, field, target) }
                else { filter_records(&cx, all, field, target) };
            match filtered {
                Result::Ok(selected) => selected,
                Result::Err(message) => return Result::Err.(report_detail(&cx, file,
                    Buffer!::new().push_static("where: ").push_static(message).save(&cx))),
            }
        },
    };
    let all = match rules.get(&cx, lit(&cx, "sort_by")) {
        Option::None => {
            if rules.contains(&cx, lit(&cx, "sort_order")) {
                return Result::Err.(report_detail(&cx, file, lit(&cx, "sort_order requires sort_by")));
            }
            all
        },
        Option::Some(value) => {
            let field = match value.as_string() {
                Option::Some(text) => text,
                Option::None => return Result::Err.(report_detail(&cx, file, lit(&cx, "sort_by must be a string"))),
            };
            let descending = match rules.get(&cx, lit(&cx, "sort_order")) {
                Option::None => false,
                Option::Some(value) => match value.as_string() {
                    Option::Some(order) => if order.is(&cx, "desc") { true }
                        else if order.is(&cx, "asc") { false }
                        else { return Result::Err.(report_detail(&cx, file, lit(&cx, "sort_order must be asc or desc"))); },
                    Option::None => return Result::Err.(report_detail(&cx, file, lit(&cx, "sort_order must be asc or desc"))),
                },
            };
            match sort_records(&cx, all, field, descending) {
                Result::Ok(sorted) => sorted,
                Result::Err(message) => return Result::Err.(report_detail(&cx, file,
                    Buffer!::new().push_static("sort_by: ").push_static(message).save(&cx))),
            }
        },
    };
    Result::Ok.(all)
}

forall 'k.
fn paginate_pages(&cx: Domain!['k], build: Build['k], file: Span['k], template_page: Page['k],
    source: Span['k], default_url: Span['k]) -> Result[(), Buffer!] {
    let collection = source.starts_with(&cx, lit(&cx, "collections.")) && source.len() > 12usize;
    if !collection && (!source.starts_with(&cx, lit(&cx, "site.")) || source.len() <= 5usize) {
        return Result::Err.(report_detail(&cx, file,
            lit(&cx, "paginate must name a site data array or collection")));
    }
    let page_size = match template_page.data.get(&cx, lit(&cx, "page_size")) {
        Option::Some(value) => match value.as_integer() {
            Option::Some(number) => if number > 0i64 { number as usize }
                else { return Result::Err.(report_detail(&cx, file, lit(&cx, "page_size must be a positive integer"))); },
            Option::None => return Result::Err.(report_detail(&cx, file, lit(&cx, "page_size must be a positive integer"))),
        },
        Option::None => return Result::Err.(report_detail(&cx, file, lit(&cx, "paginate requires page_size"))),
    };
    if template_page.data.contains(&cx, lit(&cx, "pagination")) {
        return Result::Err.(report_detail(&cx, file, lit(&cx, "pagination is a reserved page field")));
    }
    let is_draft = draft(&cx, template_page.data, file)?;
    if is_draft && !build.include_drafts { return Result::Ok.(()); }
    let base = match template_page.data.get(&cx, lit(&cx, "permalink")) {
        Option::None => default_url,
        Option::Some(value) => match value.as_string() {
            Option::Some(text) => text,
            Option::None => return Result::Err.(report_detail(&cx, file, lit(&cx, "permalink must be a string"))),
        },
    };
    if !safe_path(&cx, base, true) || !base.ends_with(&cx, lit(&cx, "/")) {
        return Result::Err.(report_detail(&cx, file, lit(&cx, "paginate permalink must be a safe directory URL ending in /")));
    }
    let pattern = match template_page.data.get(&cx, lit(&cx, "page_permalink")) {
        Option::None => Option::None,
        Option::Some(value) => {
            let text = match value.as_string() {
                Option::Some(text) => text,
                Option::None => return Result::Err.(report_detail(&cx, file, lit(&cx, "page_permalink must be a string"))),
            };
            let placeholder = lit(&cx, "{{ page.pagination.number }}");
            let at = match text.find(&cx, placeholder, 0usize) {
                Option::Some(at) => at,
                Option::None => return Result::Err.(report_detail(&cx, file,
                    lit(&cx, "page_permalink must contain {{ page.pagination.number }}"))),
            };
            let prefix = text.slice(0usize, at);
            let suffix = text.slice(at + placeholder.len(), text.len());
            if prefix.find(&cx, lit(&cx, "{{"), 0usize).is_some()
                || prefix.find(&cx, lit(&cx, "}}"), 0usize).is_some()
                || suffix.find(&cx, lit(&cx, "{{"), 0usize).is_some()
                || suffix.find(&cx, lit(&cx, "}}"), 0usize).is_some() {
                return Result::Err.(report_detail(&cx, file,
                    lit(&cx, "page_permalink accepts only one page number placeholder")));
            }
            let parts = PaginationPattern.{ prefix, suffix };
            let example = pagination_url(&cx, base, Option::Some.(parts), 2usize);
            let destination = output_for_url(&cx, build.output, example, file, TemplateFormat::Html)?;
            Option::Some.(parts)
        },
    };
    let value = if collection {
        match build.collections.get(&cx, source.slice(12usize, source.len())) {
            Option::Some(found) => found,
            Option::None => return Result::Err.(report_detail(&cx, file, lit(&cx, "paginate source is missing"))),
        }
    } else {
        match site_value(&cx, build.site_data, source.slice(5usize, source.len())) {
            Option::Some(found) => found,
            Option::None => return Result::Err.(report_detail(&cx, file, lit(&cx, "paginate source is missing"))),
        }
    };
    let all = match value.as_array() {
        Option::Some(array) => array,
        Option::None => return Result::Err.(report_detail(&cx, file, lit(&cx, "paginate source must be an array"))),
    };
    let all = select_records(&cx, all, template_page.data, file)?;
    let count = all.len(&cx);
    let pages = if count == 0usize { 1usize } else { (count - 1usize) / page_size + 1usize };
    var number = 1usize;
    while number <= pages {
        let label = Buffer!::new().push_bytes(&cx, file).push_static(" [page ")
            .push_usize(number).push_static("]").save(&cx);
        let url = pagination_url(&cx, base, pattern, number);
        let destination = output_for_url(&cx, build.output, url, label, TemplateFormat::Html)?;
        claim(&cx, build, destination, label)?;
        let items = ArenaVec::new(&cx);
        let start = (number - 1usize) * page_size;
        var i = start;
        while i < count && i - start < page_size {
            items.push(&cx, all.at(&cx, i));
            i = i + 1usize;
        }
        let pagination = ArenaMap::new(&cx);
        let replaced = pagination.insert(&cx, lit(&cx, "items"), TomlValue::Array.(items));
        let replaced = pagination.insert(&cx, lit(&cx, "number"), TomlValue::Integer.(number as i64));
        let replaced = pagination.insert(&cx, lit(&cx, "total_pages"), TomlValue::Integer.(pages as i64));
        let replaced = pagination.insert(&cx, lit(&cx, "total_items"), TomlValue::Integer.(count as i64));
        if number > 1usize {
            let replaced = pagination.insert(&cx, lit(&cx, "previous"),
                TomlValue::String.(pagination_url(&cx, base, pattern, number - 1usize)));
        }
        if number < pages {
            let replaced = pagination.insert(&cx, lit(&cx, "next"),
                TomlValue::String.(pagination_url(&cx, base, pattern, number + 1usize)));
        }
        let fields = generated_fields(&cx, template_page.data, ArenaMap::new(&cx));
        let replaced = fields.insert(&cx, lit(&cx, "pagination"), TomlValue::Table.(pagination));
        let replaced = fields.insert(&cx, lit(&cx, "permalink"), TomlValue::String.(url));
        let page = Page.{ data: fields, source_urls: build.source_urls,
            url, body: template_page.body, body_line: template_page.body_line };
        build.pages.push(&cx, SourcePage.{ file: label, source_path: Option::None, page, is_markdown: false,
            format: TemplateFormat::Html, destination, excerpt: Option::None });
        number = number + 1usize;
    }
    Result::Ok.(())
}

forall 'k.
fn render_layout(&cx: Domain!['k], build: Build['k], page: Page['k], content: Span['k], name: Span['k],
    format: TemplateFormat, depth: usize) -> Result[Span['k], Buffer!] {
    if depth >= 32usize { return Result::Err.(report(&cx, "layout chain too deep or cyclic", name)); }
    if !name.ends_with(&cx, format_suffix(&cx, format)) {
        return Result::Err.(report(&cx, "layout has the wrong suffix", name));
    }
    let file = join(&cx, build.layouts, name);
    let source = load(&cx, file)?;
    let layout = match parse_page(&cx, source, page.url) {
        Result::Ok(layout) => layout,
        Result::Err(message) => return Result::Err.(report_detail(&cx, file, message)),
    };
    let rendered = match template(&cx, build.site_data, build.collections, page, build.layouts,
        file, layout.body, content, layout.body_line, format) {
        Result::Ok(html) => html.save(&cx),
        Result::Err(message) => return Result::Err.(report_template(&cx, message)),
    };
    match layout_name(&cx, layout.data)? {
        Option::None => Result::Ok.(rendered),
        Option::Some(outer) => render_layout(&cx, build, page, rendered, outer, format, depth + 1usize),
    }
}

forall 'k.
fn collect_page(&cx: Domain!['k], build: Build['k], relative: Span['k],
    defaults: ArenaMap[Span['k], TomlValue['k], 'k]) -> Result[(), Buffer!] {
    let file = join(&cx, build.source, relative);
    let source = load(&cx, file)?;
    let is_markdown = relative.ends_with(&cx, lit(&cx, ".md"));
    let format = page_format(&cx, relative);
    let url = match format {
        TemplateFormat::Html => source_url(&cx, relative, if is_markdown { 3usize } else { 5usize }),
        _ => Buffer!::new().push_static("/").push_bytes(&cx, relative).save(&cx),
    };
    let parsed = match parse_page(&cx, source, url) {
        Result::Ok(page) => page,
        Result::Err(message) => return Result::Err.(report_detail(&cx, file, message)),
    };
    let parsed = Page.{ data: merge_defaults(&cx, defaults, parsed.data), source_urls: parsed.source_urls,
        url: parsed.url, body: parsed.body, body_line: parsed.body_line };
    if parsed.data.contains(&cx, lit(&cx, "aliases"))
        && (parsed.data.contains(&cx, lit(&cx, "generate")) || parsed.data.contains(&cx, lit(&cx, "paginate"))) {
        return Result::Err.(report_detail(&cx, file, lit(&cx, "aliases require an ordinary page")));
    }
    match parsed.data.get(&cx, lit(&cx, "paginate")) {
        Option::None => (),
        Option::Some(value) => {
            if parsed.data.contains(&cx, lit(&cx, "generate")) {
                return Result::Err.(report_detail(&cx, file, lit(&cx, "paginate and generate cannot be combined")));
            }
            let html = match format { TemplateFormat::Html => true, _ => false };
            if is_markdown || !html {
                return Result::Err.(report_detail(&cx, file, lit(&cx, "paginate requires an HTML template")));
            }
            let source = match value.as_string() {
                Option::Some(text) => text,
                Option::None => return Result::Err.(report_detail(&cx, file, lit(&cx, "paginate must be a string"))),
            };
            if source.starts_with(&cx, lit(&cx, "collections.")) {
                build.pending_pagination.push(&cx, PendingPagination.{ file, page: parsed, source, default_url: url });
                return Result::Ok.(());
            }
            return paginate_pages(&cx, build, file, parsed, source, url);
        },
    }
    match parsed.data.get(&cx, lit(&cx, "generate")) {
        Option::None => (),
        Option::Some(value) => {
            if is_markdown { return Result::Err.(report_detail(&cx, file, lit(&cx, "generate requires an HTML template"))); }
            let source = match value.as_string() {
                Option::Some(text) => text,
                Option::None => return Result::Err.(report_detail(&cx, file, lit(&cx, "generate must be a string"))),
            };
            return generate_pages(&cx, build, file, parsed, source, format);
        },
    }
    let is_draft = draft(&cx, parsed.data, file)?;
    if is_draft && !build.include_drafts { return Result::Ok.(()); }
    let html = match format { TemplateFormat::Html => true, _ => false };
    if !html && parsed.data.contains(&cx, lit(&cx, "aliases")) {
        return Result::Err.(report_detail(&cx, file, lit(&cx, "aliases require an HTML page")));
    }
    let url = match parsed.data.get(&cx, lit(&cx, "permalink")) {
        Option::None => match parsed.data.get(&cx, lit(&cx, "permalink_pattern")) {
            Option::None => url,
            Option::Some(value) => {
                let pattern = match value.as_string() {
                    Option::Some(text) => text,
                    Option::None => return Result::Err.(report_detail(&cx, file, lit(&cx, "permalink_pattern must be a string"))),
                };
                if pattern.is_empty() { url }
                else {
                    if !parsed.data.contains(&cx, lit(&cx, "slug")) {
                        let filename = basename(&cx, relative);
                        let extension = if is_markdown { 3usize } else { format_suffix(&cx, format).len() };
                        let slug = filename.slice(0usize, filename.len() - extension);
                        let replaced = parsed.data.insert(&cx, lit(&cx, "slug"), TomlValue::String.(slug));
                    }
                    match permalink_pattern(&cx, pattern, parsed.data, "page.") {
                        Result::Ok(resolved) => resolved,
                        Result::Err(message) => return Result::Err.(report_detail(&cx, file, message)),
                    }
                }
            },
        },
        Option::Some(value) => match value.as_string() {
            Option::Some(link) => link,
            Option::None => return Result::Err.(report(&cx, "permalink must be a string", file)),
        },
    };
    let removed = parsed.data.remove(&cx, lit(&cx, "permalink_pattern"));
    let page = Page.{ data: parsed.data, source_urls: build.source_urls,
        url, body: parsed.body, body_line: parsed.body_line };
    let destination = output_for_url(&cx, build.output, url, file, format)?;
    claim(&cx, build, destination, file)?;
    add_aliases(&cx, build, file, page.data, url)?;
    let excerpt = if is_markdown { markdown_excerpt_source(&cx, page.body) } else { Option::None };
    build.pages.push(&cx, SourcePage.{ file, source_path: Option::Some.(relative), page, is_markdown, format, destination, excerpt });
    Result::Ok.(())
}

forall 'k.
fn render_page(&cx: Domain!['k], build: Build['k], source: SourcePage['k]) -> Result[(), Buffer!] {
    let original = source.page;
    if original.data.contains(&cx, lit(&cx, "collection_navigation")) {
        return Result::Err.(report_detail(&cx, source.file, lit(&cx, "collection_navigation is a reserved page field")));
    }
    let page = match build.navigation.get(&cx, original.url) {
        Option::Some(value) => {
            let fields = generated_fields(&cx, original.data, ArenaMap::new(&cx));
            let replaced = fields.insert(&cx, lit(&cx, "collection_navigation"), value);
            Page.{ data: fields, source_urls: original.source_urls,
                url: original.url, body: original.body, body_line: original.body_line }
        },
        Option::None => original,
    };
    let relative = source.file.slice(build.source.len() + 1usize, source.file.len());
    let body = if source.is_markdown { match markdown(&cx, page.body, build.base_path, build.source_urls,
        build.asset_urls, build.fingerprint_assets, relative) {
            Result::Ok(result) => {
                let (html, found) = result;
                if page.data.contains(&cx, lit(&cx, "headings")) {
                    html.destroy();
                    return Result::Err.(report_detail(&cx, source.file, lit(&cx, "headings is a reserved Markdown page field")));
                }
                let headings = ArenaVec::new(&cx);
                var i = 0usize;
                while i < found.len(&cx) {
                    let heading = found.at(&cx, i);
                    let fields = ArenaMap::new(&cx);
                    let replaced = fields.insert(&cx, lit(&cx, "level"), TomlValue::Integer.(heading.level as i64));
                    let replaced = fields.insert(&cx, lit(&cx, "text"), TomlValue::String.(heading.text));
                    let replaced = fields.insert(&cx, lit(&cx, "id"), TomlValue::String.(heading.id));
                    headings.push(&cx, TomlValue::Table.(fields));
                    i = i + 1usize;
                }
                let replaced = page.data.insert(&cx, lit(&cx, "headings"), TomlValue::Array.(headings));
                html.save(&cx)
            },
            Result::Err(message) => return Result::Err.(report_detail(&cx, source.file, message)),
        } }
        else { match template(&cx, build.site_data, build.collections, page, build.layouts,
            source.file, page.body, lit(&cx, ""), page.body_line, source.format) {
            Result::Ok(html) => html.save(&cx),
            Result::Err(message) => return Result::Err.(report_template(&cx, message)),
        } };
    let rendered = match layout_name(&cx, page.data)? {
        Option::None => body,
        Option::Some(name) => render_layout(&cx, build, page, body, name, source.format, 0usize)?,
    };
    match source.format {
        TemplateFormat::Json => match validate_json(&cx, rendered) {
            Result::Ok(nothing) => (),
            Result::Err(error) => return Result::Err.(report_generated(&cx, source, rendered,
                "JSON", error.offset, error.message)),
        },
        TemplateFormat::Xml => match validate_xml_document(&cx, rendered) {
            Result::Ok(nothing) => (),
            Result::Err(error) => return Result::Err.(report_generated(&cx, source, rendered,
                "XML", error.offset, error.message)),
        },
        _ => (),
    }
    save(&cx, source.destination, Buffer!::new().push_bytes(&cx, rendered))
}

forall 'k.
fn valid_glob(&cx: Domain!['k], path: Span['k]) -> bool {
    var start = 0usize;
    var i = 0usize;
    while i <= path.len() {
        if i == path.len() || byte(&cx, path, i) == b'/' {
            let segment = path.slice(start, i);
            match segment.find(&cx, lit(&cx, "**"), 0usize) {
                Option::Some(at) => if !segment.is(&cx, "**") { return false; },
                Option::None => (),
            }
            start = i + 1usize;
        }
        i = i + 1usize;
    }
    true
}

forall 'k.
fn segment_glob(&cx: Domain!['k], pattern: Span['k], name: Span['k]) -> bool {
    var p = 0usize;
    var n = 0usize;
    var star: Option[usize] = Option::None;
    var retry = 0usize;
    while n < name.len() {
        if p < pattern.len() && byte(&cx, pattern, p) == byte(&cx, name, n)
            && byte(&cx, pattern, p) != b'*' { p = p + 1usize; n = n + 1usize; }
        else if p < pattern.len() && byte(&cx, pattern, p) == b'*' {
            star = Option::Some.(p);
            retry = n;
            p = p + 1usize;
        } else {
            match star {
                Option::Some(at) => { retry = retry + 1usize; n = retry; p = at + 1usize; },
                Option::None => return false,
            }
        }
    }
    while p < pattern.len() && byte(&cx, pattern, p) == b'*' { p = p + 1usize; }
    p == pattern.len()
}

forall 'k.
fn glob_parts(&cx: Domain!['k], value: Span['k]) -> ArenaVec[Span['k], 'k] {
    let parts = ArenaVec::new(&cx);
    var start = 0usize;
    var i = 0usize;
    while i <= value.len() {
        if i == value.len() || byte(&cx, value, i) == b'/' {
            parts.push(&cx, value.slice(start, i));
            start = i + 1usize;
        }
        i = i + 1usize;
    }
    parts
}

forall 'k.
fn path_glob(&cx: Domain!['k], pattern: Span['k], path: Span['k]) -> bool {
    let pattern_parts = glob_parts(&cx, pattern);
    let path_parts = glob_parts(&cx, path);
    var previous = ArenaVec::new(&cx);
    previous.push(&cx, true);
    var j = 0usize;
    while j < path_parts.len(&cx) { previous.push(&cx, false); j = j + 1usize; }
    var i = 0usize;
    while i < pattern_parts.len(&cx) {
        let segment = pattern_parts.at(&cx, i);
        let row = ArenaVec::new(&cx);
        j = 0usize;
        while j <= path_parts.len(&cx) {
            let matched = if segment.is(&cx, "**") {
                previous.at(&cx, j) || (j > 0usize && row.at(&cx, j - 1usize))
            } else if j == 0usize { false }
            else { previous.at(&cx, j - 1usize) && segment_glob(&cx, segment, path_parts.at(&cx, j - 1usize)) };
            row.push(&cx, matched);
            j = j + 1usize;
        }
        previous = row;
        i = i + 1usize;
    }
    previous.at(&cx, path_parts.len(&cx))
}

forall 'k.
fn excluded(&cx: Domain!['k], rules: ArenaVec[Span['k], 'k], relative: Span['k], is_directory: bool) -> bool {
    var i = 0usize;
    while i < rules.len(&cx) {
        let rule = rules.at(&cx, i);
        if rule.ends_with(&cx, lit(&cx, "/")) {
            let directory = rule.slice(0usize, rule.len() - 1usize);
            if is_directory {
                let matched = if directory.find_byte(&cx, b'*', 0usize).is_some() {
                    path_glob(&cx, directory, relative)
                } else { directory.eq(&cx, relative) };
                if matched { return true; }
            }
        } else if !is_directory {
            let matched = if rule.find_byte(&cx, b'*', 0usize).is_some() {
                path_glob(&cx, rule, relative)
            } else { rule.eq(&cx, relative) };
            if matched { return true; }
        }
        i = i + 1usize;
    }
    false
}

forall 'k.
fn scan_pages(&cx: Domain!['k], build: Build['k], relative: Span['k], depth: usize,
    inherited: ArenaMap[Span['k], TomlValue['k], 'k]) -> Result[(), Buffer!] {
    if depth >= 64usize { return Result::Err.(report(&cx, "source tree too deep", relative)); }
    let defaults = directory_defaults(&cx, build, relative, inherited)?;
    let directory = join(&cx, build.source, relative);
    let directory = match read_dir(&cx, directory) {
        Result::Ok(directory) => directory,
        Result::Err(e) => return Result::Err.(report(&cx, "cannot list", directory)),
    };
    var directory = directory;
    var going = true;
    while going {
        match &directory.next() {
            Result::Err(e) => { directory.close(); return Result::Err.(report(&cx, "cannot list", relative)); },
            Result::Ok(next) => match next {
                Option::None => { going = false; },
                Option::Some(entry) => {
                    let { name, is_directory } = entry;
                    let child = join(&cx, relative, name.save(&cx));
                    if excluded(&cx, build.exclude, child, is_directory) {
                        // excluded source path
                    } else if child.eq(&cx, build.assets) || child.eq(&cx, build.layouts_rel) || (!build.data_dir.is_empty() && child.eq(&cx, build.data_dir)) {
                        // reserved source directories
                    } else if is_directory {
                        match scan_pages(&cx, build, child, depth + 1usize, defaults) {
                            Result::Ok(nothing) => (),
                            Result::Err(message) => { directory.close(); return Result::Err.(message); },
                        }
                    } else if child.ends_with(&cx, lit(&cx, ".md")) || child.ends_with(&cx, lit(&cx, ".html"))
                        || child.ends_with(&cx, lit(&cx, ".xml")) || child.ends_with(&cx, lit(&cx, ".json"))
                        || child.ends_with(&cx, lit(&cx, ".txt")) {
                        match collect_page(&cx, build, child, defaults) {
                            Result::Ok(nothing) => (),
                            Result::Err(message) => { directory.close(); return Result::Err.(message); },
                        }
                    }
                },
            },
        }
    }
    if !directory.close().is_ok() { return Result::Err.(report(&cx, "cannot close directory", relative)); }
    Result::Ok.(())
}

forall 'k.
fn fingerprint_name_hash(&cx: Domain!['k], relative: Span['k], hash: Span['k]) -> Span['k] {
    var dot = relative.len();
    var i = relative.len();
    var found = false;
    while i > 0usize && !found {
        i = i - 1usize;
        if byte(&cx, relative, i) == b'/' { found = true; }
        if byte(&cx, relative, i) == b'.' { dot = i; found = true; }
    }
    let name = Buffer!::new().push_bytes(&cx, relative.slice(0usize, dot)).push_byte(b'.')
        .push_bytes(&cx, hash);
    name.push_bytes(&cx, relative.slice(dot, relative.len())).save(&cx)
}

forall 'k.
fn fingerprint_name(&cx: Domain!['k], relative: Span['k], contents: Span['k]) -> Span['k] {
    fingerprint_name_hash(&cx, relative, digest_hex(&cx, contents))
}

forall 'k.
fn asset_url(&cx: Domain!['k], build: Build['k], relative: Span['k]) -> Span['k] {
    Buffer!::new().push_static("/").push_bytes(&cx, build.assets)
        .push_byte(b'/').push_bytes(&cx, relative).save(&cx)
}

forall 'k.
fn scan_assets(&cx: Domain!['k], build: Build['k], relative: Span['k], depth: usize) -> Result[(), Buffer!] {
    if depth >= 64usize { return Result::Err.(report(&cx, "asset tree too deep", relative)); }
    let path = join(&cx, join(&cx, build.source, build.assets), relative);
    let opened = match read_dir(&cx, path) {
        Result::Ok(directory) => directory,
        Result::Err(e) => return Result::Err.(report(&cx, "cannot list", path)),
    };
    var opened = opened;
    var going = true;
    while going {
        match &opened.next() {
            Result::Err(e) => { opened.close(); return Result::Err.(report(&cx, "cannot list", relative)); },
            Result::Ok(next) => match next {
                Option::None => { going = false; },
                Option::Some(entry) => {
                    let { name, is_directory } = entry;
                    let child = join(&cx, relative, name.save(&cx));
                    if is_directory {
                        match scan_assets(&cx, build, child, depth + 1usize) {
                            Result::Ok(nothing) => (),
                            Result::Err(message) => { opened.close(); return Result::Err.(message); },
                        }
                    } else {
                        let output_name = if build.fingerprint_assets && !child.ends_with(&cx, lit(&cx, ".css")) {
                            let source = join(&cx, join(&cx, build.source, build.assets), child);
                            let hash = match digest_file(&cx, source) {
                                Result::Ok(value) => value,
                                Result::Err(e) => { opened.close(); return Result::Err.(report(&cx, "cannot read", source)); },
                            };
                            fingerprint_name_hash(&cx, child, hash)
                        } else if build.fingerprint_assets {
                            let source = join(&cx, join(&cx, build.source, build.assets), child);
                            let contents = match load(&cx, source) {
                                Result::Ok(value) => value,
                                Result::Err(message) => { opened.close(); return Result::Err.(message); },
                            };
                            fingerprint_name(&cx, child, contents)
                        } else { child };
                        let replaced = build.asset_urls.insert(&cx, asset_url(&cx, build, child),
                            asset_url(&cx, build, output_name));
                    }
                },
            },
        }
    }
    if !opened.close().is_ok() { return Result::Err.(report(&cx, "cannot close directory", relative)); }
    Result::Ok.(())
}

forall 'k.
fn fingerprint_stylesheet(&cx: Domain!['k], build: Build['k], url: Span['k],
    states: ArenaMap[Span['k], u8, 'k], depth: usize) -> Result[(), Buffer!] {
    if depth >= 64usize { return Result::Err.(report(&cx, "CSS dependency tree too deep", url)); }
    match states.get(&cx, url) {
        Option::Some(state) => {
            if state == 1u8 { return Result::Err.(report(&cx, "CSS dependency cycle", url)); }
            if state == 2u8 { return Result::Ok.(()); }
        },
        Option::None => (),
    }
    let replaced = states.insert(&cx, url, 1u8);
    let source = join(&cx, build.source, url.slice(1usize, url.len()));
    let contents = load(&cx, source)?;
    let dependencies = css_dependencies(&cx, contents, url, build.base_path, build.asset_urls);
    var i = 0usize;
    while i < dependencies.len(&cx) {
        fingerprint_stylesheet(&cx, build, dependencies.at(&cx, i), states, depth + 1usize)?;
        i = i + 1usize;
    }
    let rewritten = rewrite_css(&cx, contents, url, build.base_path, build.asset_urls);
    let relative = url.slice(build.assets.len() + 2usize, url.len());
    let name = fingerprint_name(&cx, relative, rewritten);
    let replaced = build.asset_urls.insert(&cx, url, asset_url(&cx, build, name));
    let replaced = states.insert(&cx, url, 2u8);
    Result::Ok.(())
}

forall 'k.
fn fingerprint_stylesheets(&cx: Domain!['k], build: Build['k]) -> Result[(), Buffer!] {
    if !build.fingerprint_assets { return Result::Ok.(()); }
    let states = ArenaMap::new(&cx);
    var i = 0usize;
    while i < build.asset_urls.positions(&cx) {
        match build.asset_urls.key_at(&cx, i) {
            Option::None => (),
            Option::Some(url) => if url.ends_with(&cx, lit(&cx, ".css")) {
                fingerprint_stylesheet(&cx, build, url, states, 0usize)?;
            },
        }
        i = i + 1usize;
    }
    Result::Ok.(())
}

forall 'k.
fn stream_copy(&cx: Domain!['k], source: Span['k], destination: Span['k]) -> Result[(), Buffer!] {
    ensure_dir(&cx, parent(&cx, destination))?;
    let input = match File!::open_read(&cx, source) {
        Result::Ok(file) => file,
        Result::Err(e) => return Result::Err.(report(&cx, "cannot read", source)),
    };
    var input = input;
    let output = match File!::create(&cx, destination) {
        Result::Ok(file) => file,
        Result::Err(e) => {
            let closed = input.close();
            return Result::Err.(report(&cx, "cannot write", destination));
        },
    };
    var output = output;
    var chunk = Buffer!::new_with_cap(65536usize);
    var going = true;
    while going {
        let count = match &input.read_exact(&chunk, 65536usize) {
            Result::Ok(n) => n,
            Result::Err(e) => {
                chunk.destroy();
                let closed = input.close();
                let closed = output.close();
                return Result::Err.(report(&cx, "cannot read", source));
            },
        };
        if count == 0usize { going = false; }
        else {
            let exists 'b. (tag, bytes, restore) = chunk.open();
            let (tag, written) = &output.write_all(tag, bytes);
            chunk = restore.restore(tag).clear();
            match written {
                Result::Ok(nothing) => (),
                Result::Err(e) => {
                    chunk.destroy();
                    let closed = input.close();
                    let closed = output.close();
                    return Result::Err.(report(&cx, "cannot write", destination));
                },
            }
            if count < 65536usize { going = false; }
        }
    }
    chunk.destroy();
    let read_closed = input.close();
    let write_closed = output.close();
    match read_closed {
        Result::Err(e) => return Result::Err.(report(&cx, "cannot read", source)),
        Result::Ok(nothing) => (),
    }
    match write_closed {
        Result::Err(e) => Result::Err.(report(&cx, "cannot write", destination)),
        Result::Ok(nothing) => Result::Ok.(()),
    }
}

forall 'k.
fn stream_copy_hashed(&cx: Domain!['k], source: Span['k], destination: Span['k],
    hashed_destination: Span['k]) -> Result[Span['k], Buffer!] {
    ensure_dir(&cx, parent(&cx, destination))?;
    let input = match File!::open_read(&cx, source) {
        Result::Ok(file) => file,
        Result::Err(e) => return Result::Err.(report(&cx, "cannot read", source)),
    };
    var input = input;
    let output = match File!::create(&cx, destination) {
        Result::Ok(file) => file,
        Result::Err(e) => {
            let closed = input.close();
            return Result::Err.(report(&cx, "cannot write", destination));
        },
    };
    var output = output;
    let hashed = match File!::create(&cx, hashed_destination) {
        Result::Ok(file) => file,
        Result::Err(e) => {
            let closed = input.close();
            let closed = output.close();
            return Result::Err.(report(&cx, "cannot write", hashed_destination));
        },
    };
    var hashed = hashed;
    var chunk = Buffer!::new_with_cap(65536usize);
    var hash = new_hash(&cx);
    var going = true;
    while going {
        let count = match &input.read_exact(&chunk, 65536usize) {
            Result::Ok(n) => n,
            Result::Err(e) => {
                chunk.destroy();
                let closed = input.close();
                let closed = output.close();
                let closed = hashed.close();
                return Result::Err.(report(&cx, "cannot read", source));
            },
        };
        if count == 0usize { going = false; }
        else {
            let exists 'b. (tag, bytes, restore) = chunk.open();
            hash = hash_bytes(&cx, hash, &tag, bytes);
            let (tag, original_written) = &output.write_all(tag, bytes);
            let (tag, hashed_written) = &hashed.write_all(tag, bytes);
            chunk = restore.restore(tag).clear();
            let original_ok = original_written.is_ok();
            let hashed_ok = hashed_written.is_ok();
            if !original_ok || !hashed_ok {
                chunk.destroy();
                let closed = input.close();
                let closed = output.close();
                let closed = hashed.close();
                return Result::Err.(report(&cx, "cannot write",
                    if original_ok { hashed_destination } else { destination }));
            }
            if count < 65536usize { going = false; }
        }
    }
    chunk.destroy();
    let read_closed = input.close();
    let write_closed = output.close();
    let hashed_closed = hashed.close();
    if !read_closed.is_ok() { return Result::Err.(report(&cx, "cannot read", source)); }
    if !write_closed.is_ok() { return Result::Err.(report(&cx, "cannot write", destination)); }
    if !hashed_closed.is_ok() { return Result::Err.(report(&cx, "cannot write", hashed_destination)); }
    Result::Ok.(finish_hash(&cx, hash))
}

forall 'k.
fn copy_assets(&cx: Domain!['k], build: Build['k], relative: Span['k], depth: usize) -> Result[(), Buffer!] {
    if depth >= 64usize { return Result::Err.(report(&cx, "asset tree too deep", relative)); }
    let directory = join(&cx, join(&cx, build.source, build.assets), relative);
    let directory = match read_dir(&cx, directory) {
        Result::Ok(directory) => directory,
        Result::Err(e) => return Result::Err.(report(&cx, "cannot list", directory)),
    };
    var directory = directory;
    var going = true;
    while going {
        match &directory.next() {
            Result::Err(e) => { directory.close(); return Result::Err.(report(&cx, "cannot list", relative)); },
            Result::Ok(next) => match next {
                Option::None => { going = false; },
                Option::Some(entry) => {
                    let { name, is_directory } = entry;
                    let child = join(&cx, relative, name.save(&cx));
                    if is_directory {
                        match copy_assets(&cx, build, child, depth + 1usize) {
                            Result::Ok(nothing) => (),
                            Result::Err(message) => { directory.close(); return Result::Err.(message); },
                        }
                    } else {
                        let source = join(&cx, join(&cx, build.source, build.assets), child);
                        let destination = join(&cx, join(&cx, build.output, build.assets), child);
                        match claim(&cx, build, destination, source) {
                            Result::Ok(nothing) => (),
                            Result::Err(message) => { directory.close(); return Result::Err.(message); },
                        }
                        let url = asset_url(&cx, build, child);
                        let hashed_url = match build.asset_urls.get(&cx, url) {
                            Option::Some(found) => found,
                            Option::None => { directory.close(); return Result::Err.(report(&cx, "asset was not scanned", source)); },
                        };
                        if !child.ends_with(&cx, lit(&cx, ".css")) {
                            if build.fingerprint_assets {
                                let hashed_destination = join(&cx, build.output, hashed_url.slice(1usize, hashed_url.len()));
                                match claim(&cx, build, hashed_destination, source) {
                                    Result::Ok(nothing) => (),
                                    Result::Err(message) => { directory.close(); return Result::Err.(message); },
                                }
                                let hash = match stream_copy_hashed(&cx, source, destination, hashed_destination) {
                                    Result::Ok(found) => found,
                                    Result::Err(message) => { directory.close(); return Result::Err.(message); },
                                };
                                let current_url = asset_url(&cx, build, fingerprint_name_hash(&cx, child, hash));
                                if !current_url.eq(&cx, hashed_url) {
                                    directory.close();
                                    return Result::Err.(report(&cx, "asset changed during build", source));
                                }
                            } else {
                                match stream_copy(&cx, source, destination) {
                                    Result::Ok(nothing) => (),
                                    Result::Err(message) => { directory.close(); return Result::Err.(message); },
                                }
                            }
                        } else {
                            let contents = match load(&cx, source) {
                                Result::Ok(found) => found,
                                Result::Err(message) => { directory.close(); return Result::Err.(message); },
                            };
                            match save(&cx, destination, Buffer!::new().push_bytes(&cx, contents)) {
                                Result::Ok(nothing) => (),
                                Result::Err(message) => { directory.close(); return Result::Err.(message); },
                            }
                            if build.fingerprint_assets {
                                let rewritten = rewrite_css(&cx, contents, url, build.base_path, build.asset_urls);
                                let current_url = asset_url(&cx, build, fingerprint_name(&cx, child, rewritten));
                                if !current_url.eq(&cx, hashed_url) {
                                    directory.close();
                                    return Result::Err.(report(&cx, "asset changed during build", source));
                                }
                                let hashed_destination = join(&cx, build.output, hashed_url.slice(1usize, hashed_url.len()));
                                match claim(&cx, build, hashed_destination, source) {
                                    Result::Ok(nothing) => (),
                                    Result::Err(message) => { directory.close(); return Result::Err.(message); },
                                }
                                match save(&cx, hashed_destination, Buffer!::new().push_bytes(&cx, rewritten)) {
                                    Result::Ok(nothing) => (),
                                    Result::Err(message) => { directory.close(); return Result::Err.(message); },
                                }
                                build.stylesheets.push(&cx, Stylesheet.{ source, output: hashed_destination,
                                    url: hashed_url, css: rewritten });
                            }
                            build.stylesheets.push(&cx, Stylesheet.{ source, output: destination, url, css: contents });
                        }
                    }
                },
            },
        }
    }
    if !directory.close().is_ok() { return Result::Err.(report(&cx, "cannot close directory", relative)); }
    Result::Ok.(())
}

forall 'k.
fn real_path(&cx: Domain!['k], path: Span['k]) -> Result[Span['k], Buffer!] {
    match canonicalize(&cx, path) {
        Result::Ok(found) => Result::Ok.(found.save(&cx)),
        Result::Err(e) => Result::Err.(report(&cx, "cannot resolve", path)),
    }
}

forall 'k.
fn basename(&cx: Domain!['k], path: Span['k]) -> Span['k] {
    let directory = parent(&cx, path);
    path.slice(if directory.is_empty() { 0usize } else { directory.len() + 1usize }, path.len())
}

// Walk only real directories under `root`. A directory symlink resolves to a
// different path, so it is unlinked without following its target. A stale
// dangling symlink is also removed as a file.
forall 'k.
fn remove_tree_at(&cx: Domain!['k], root: Span['k], path: Span['k], relative: Span['k], depth: usize) -> Result[(), Buffer!] {
    if depth >= 64usize { return Result::Err.(report(&cx, "output tree too deep", path)); }
    let opened = match read_dir(&cx, path) {
        Result::Ok(directory) => directory,
        Result::Err(e) => return Result::Err.(report(&cx, "cannot list output", path)),
    };
    var opened = opened;
    var going = true;
    while going {
        match &opened.next() {
            Result::Err(e) => { opened.close(); return Result::Err.(report(&cx, "cannot list output", path)); },
            Result::Ok(next) => match next {
                Option::None => { going = false; },
                Option::Some(entry) => {
                    let { name, is_directory } = entry;
                    let name = name.save(&cx);
                    let child = join(&cx, path, name);
                    let child_rel = join(&cx, relative, name);
                    let is_real_directory = match metadata(&cx, child) {
                        Result::Ok(m) => match m.kind {
                            FileKind::Directory => match real_path(&cx, child) {
                                Result::Ok(actual) => actual.eq(&cx, join(&cx, root, child_rel)),
                                Result::Err(message) => { message.destroy(); false },
                            },
                            _ => false,
                        },
                        Result::Err(e) => false,
                    };
                    let removed = if is_real_directory { remove_tree_at(&cx, root, child, child_rel, depth + 1usize) }
                        else { match remove(&cx, child) {
                            Result::Ok(nothing) => Result::Ok.(()),
                            Result::Err(e) => Result::Err.(report(&cx, "cannot remove", child)),
                        } };
                    match removed {
                        Result::Ok(nothing) => (),
                        Result::Err(message) => { opened.close(); return Result::Err.(message); },
                    }
                },
            },
        }
    }
    if !opened.close().is_ok() { return Result::Err.(report(&cx, "cannot close output", path)); }
    match remove(&cx, path) {
        Result::Ok(nothing) => Result::Ok.(()),
        Result::Err(e) => Result::Err.(report(&cx, "cannot remove", path)),
    }
}

forall 'k.
fn remove_tree(&cx: Domain!['k], path: Span['k]) -> Result[(), Buffer!] {
    let root = real_path(&cx, path)?;
    remove_tree_at(&cx, root, path, lit(&cx, ""), 0usize)
}

forall 'k.
fn stage_paths(&cx: Domain!['k], output: Span['k]) -> Result[(Span['k], Span['k]), Buffer!] {
    ensure_dir(&cx, parent(&cx, output))?;
    var attempt = 0usize;
    while attempt < 1000usize {
        let base = Buffer!::new().push_bytes(&cx, output).push_static(".krayon-")
            .push_i64(unsafe getpid() as i64).push_byte(b'-').push_usize(attempt).save(&cx);
        let stage = Buffer!::new().push_bytes(&cx, base).push_static("-stage").save(&cx);
        let backup = Buffer!::new().push_bytes(&cx, base).push_static("-previous").save(&cx);
        if !exists_path(&cx, backup)? {
            match mkdir(&cx, stage) {
                Result::Ok(nothing) => return Result::Ok.((stage, backup)),
                Result::Err(e) => if e.errno != 17i32 { return Result::Err.(report(&cx, "cannot create staging directory", stage)); },
            }
        }
        attempt = attempt + 1usize;
    }
    Result::Err.(report(&cx, "cannot reserve staging directory", output))
}

forall 'k.
fn check_output(&cx: Domain!['k], source: Span['k], output: Span['k]) -> Result[bool, Buffer!] {
    let source_real = real_path(&cx, source)?;
    let parent_real = real_path(&cx, parent(&cx, output))?;
    let prefix = Buffer!::new().push_bytes(&cx, source_real).push_static("/").save(&cx);
    if parent_real.eq(&cx, source_real) || parent_real.starts_with(&cx, prefix) {
        return Result::Err.(report(&cx, "output must be outside input", output));
    }
    if !exists_path(&cx, output)? { return Result::Ok.(false); }
    match metadata(&cx, output) {
        Result::Ok(m) => match m.kind {
            FileKind::Directory => (),
            _ => return Result::Err.(report(&cx, "output is not a directory", output)),
        },
        Result::Err(e) => return Result::Err.(report(&cx, "cannot stat output", output)),
    }
    let actual = real_path(&cx, output)?;
    let expected = join(&cx, parent_real, basename(&cx, output));
    if !actual.eq(&cx, expected) { return Result::Err.(report(&cx, "output may not be a symlink", output)); }
    Result::Ok.(true)
}

forall 'k.
fn collection_item(&cx: Domain!['k], source: SourcePage['k]) -> TomlValue['k] {
    let page = source.page;
    let fields = ArenaMap::new(&cx);
    var i = 0usize;
    while i < page.data.positions(&cx) {
        match page.data.key_at(&cx, i) {
            Option::None => (),
            Option::Some(key) => match page.data.get(&cx, key) {
                Option::None => (),
                Option::Some(value) => { let replaced = fields.insert(&cx, key, value); },
            },
        }
        i = i + 1usize;
    }
    let replaced = fields.insert(&cx, lit(&cx, "url"), TomlValue::String.(page.url));
    match source.excerpt {
        Option::Some(html) => { let replaced = fields.insert(&cx, lit(&cx, "excerpt"), TomlValue::String.(html)); },
        Option::None => (),
    }
    TomlValue::Table.(fields)
}

forall 'k.
fn prepare_sources(&cx: Domain!['k], build: Build['k]) -> Result[(), Buffer!] {
    var i = 0usize;
    while i < build.pages.len(&cx) {
        let entry = build.pages.at(&cx, i);
        match entry.source_path {
            Option::Some(relative) => { let replaced = build.source_urls.insert(&cx, relative, entry.page.url); },
            Option::None => (),
        }
        i = i + 1usize;
    }
    i = 0usize;
    while i < build.pages.len(&cx) {
        let entry = build.pages.at(&cx, i);
        match entry.excerpt {
            Option::None => (),
            Option::Some(source) => {
                let relative = entry.file.slice(build.source.len() + 1usize, entry.file.len());
                let html = match markdown(&cx, source, build.base_path, build.source_urls,
                    build.asset_urls, build.fingerprint_assets, relative) {
                    Result::Ok(result) => { let (html, headings) = result; html.save(&cx) },
                    Result::Err(message) => return Result::Err.(report_detail(&cx, entry.file, message)),
                };
                let previous = build.pages.replace(&cx, i, SourcePage.{ file: entry.file, source_path: entry.source_path, page: entry.page,
                    is_markdown: entry.is_markdown, format: entry.format, destination: entry.destination,
                    excerpt: Option::Some.(html) });
            },
        }
        i = i + 1usize;
    }
    Result::Ok.(())
}

forall 'k.
fn publish_pages(&cx: Domain!['k], build: Build['k]) -> () {
    build.pages.sort_by(&cx, |&cx, a, b| a.page.url.cmp(&cx, b.page.url));
    let all = ArenaVec::new(&cx);
    var i = 0usize;
    while i < build.pages.len(&cx) {
        let entry = build.pages.at(&cx, i);
        match entry.format {
            TemplateFormat::Html => all.push(&cx, collection_item(&cx, entry)),
            _ => (),
        }
        i = i + 1usize;
    }
    let replaced = build.collections.insert(&cx, lit(&cx, "pages"), TomlValue::Array.(all));
}

forall 'k.
fn collection_name(&cx: Domain!['k], name: Span['k]) -> bool {
    if name.is_empty() || name.is(&cx, "pages") { return false; }
    var i = 0usize;
    while i < name.len() {
        let c = byte(&cx, name, i);
        let letter = (c >= b'a' && c <= b'z') || (c >= b'A' && c <= b'Z');
        let digit = c >= b'0' && c <= b'9';
        if !letter && c != b'_' && (i == 0usize || !digit) { return false; }
        i = i + 1usize;
    }
    true
}

forall 'k.
fn publish_named_collections(&cx: Domain!['k], build: Build['k]) -> Result[(), Buffer!] {
    let pages = match build.collections.get(&cx, lit(&cx, "pages")) {
        Option::Some(value) => match value.as_array() {
            Option::Some(array) => array,
            Option::None => return Result::Err.(report(&cx, "page collection is not an array", build.config_file)),
        },
        Option::None => return Result::Err.(report(&cx, "page collection is missing", build.config_file)),
    };
    var i = 0usize;
    while i < build.definitions.positions(&cx) {
        match build.definitions.key_at(&cx, i) {
            Option::None => (),
            Option::Some(name) => {
                if !collection_name(&cx, name) {
                    return Result::Err.(report_detail(&cx, build.config_file,
                        Buffer!::new().push_static("invalid collection name: ").push_bytes(&cx, name).save(&cx)));
                }
                let rules = match build.definitions.get(&cx, name) {
                    Option::Some(value) => match value.as_table() {
                        Option::Some(table) => table,
                        Option::None => return Result::Err.(report_detail(&cx, build.config_file,
                            Buffer!::new().push_static("collection must be a table: ").push_bytes(&cx, name).save(&cx))),
                    },
                    Option::None => return Result::Err.(report(&cx, "collection definition is missing", build.config_file)),
                };
                var j = 0usize;
                while j < rules.positions(&cx) {
                    match rules.key_at(&cx, j) {
                        Option::Some(key) => if !key.is(&cx, "where") && !key.is(&cx, "sort_by")
                            && !key.is(&cx, "sort_order") {
                            return Result::Err.(report_detail(&cx, build.config_file,
                                Buffer!::new().push_static("unknown collection rule: ").push_bytes(&cx, key).save(&cx)));
                        },
                        Option::None => (),
                    }
                    j = j + 1usize;
                }
                let selected = select_records(&cx, pages, rules, build.config_file)?;
                let replaced = build.collections.insert(&cx, name, TomlValue::Array.(selected));
            },
        }
        i = i + 1usize;
    }
    Result::Ok.(())
}

forall 'k.
fn publish_collection_navigation(&cx: Domain!['k], build: Build['k]) -> () {
    var i = 0usize;
    while i < build.definitions.positions(&cx) {
        match build.definitions.key_at(&cx, i) {
            Option::None => (),
            Option::Some(name) => match build.collections.get(&cx, name) {
                Option::None => (),
                Option::Some(value) => match value.as_array() {
                    Option::None => (),
                    Option::Some(items) => {
                        var j = 0usize;
                        while j < items.len(&cx) {
                            let item = items.at(&cx, j);
                            match item.as_table() {
                                Option::None => (),
                                Option::Some(record) => match record.get(&cx, lit(&cx, "url")) {
                                    Option::None => (),
                                    Option::Some(url_value) => match url_value.as_string() {
                                        Option::None => (),
                                        Option::Some(url) => {
                                            let per_page = match build.navigation.get(&cx, url) {
                                                Option::Some(value) => match value.as_table() {
                                                    Option::Some(table) => table,
                                                    Option::None => ArenaMap::new(&cx),
                                                },
                                                Option::None => ArenaMap::new(&cx),
                                            };
                                            let neighbors = ArenaMap::new(&cx);
                                            if j > 0usize {
                                                let replaced = neighbors.insert(&cx, lit(&cx, "previous"), items.at(&cx, j - 1usize));
                                            }
                                            if j + 1usize < items.len(&cx) {
                                                let replaced = neighbors.insert(&cx, lit(&cx, "next"), items.at(&cx, j + 1usize));
                                            }
                                            let replaced = per_page.insert(&cx, name, TomlValue::Table.(neighbors));
                                            let replaced = build.navigation.insert(&cx, url, TomlValue::Table.(per_page));
                                        },
                                    },
                                },
                            }
                            j = j + 1usize;
                        }
                    },
                },
            },
        }
        i = i + 1usize;
    }
}

forall 'k.
fn discover_site(&cx: Domain!['k], build: Build['k]) -> Result[(), Buffer!] {
    let assets = join(&cx, build.source, build.assets);
    if exists_path(&cx, assets)? { scan_assets(&cx, build, lit(&cx, ""), 0usize)?; }
    fingerprint_stylesheets(&cx, build)?;
    let asset_values = ArenaMap::new(&cx);
    var j = 0usize;
    while j < build.asset_urls.positions(&cx) {
        match build.asset_urls.key_at(&cx, j) {
            Option::None => (),
            Option::Some(url) => match build.asset_urls.get(&cx, url) {
                Option::None => (),
                Option::Some(fingerprinted) => {
                    let replaced = asset_values.insert(&cx, url, TomlValue::String.(fingerprinted));
                },
            },
        }
        j = j + 1usize;
    }
    let replaced = build.site_data.insert(&cx, lit(&cx, "asset_urls"), TomlValue::Table.(asset_values));
    scan_pages(&cx, build, lit(&cx, ""), 0usize, ArenaMap::new(&cx))?;
    prepare_sources(&cx, build)?;
    publish_pages(&cx, build);
    publish_named_collections(&cx, build)?;
    publish_collection_navigation(&cx, build);
    var i = 0usize;
    while i < build.pending_pagination.len(&cx) {
        let pending = build.pending_pagination.at(&cx, i);
        paginate_pages(&cx, build, pending.file, pending.page, pending.source, pending.default_url)?;
        i = i + 1usize;
    }
    publish_pages(&cx, build);
    Result::Ok.(())
}

forall 'k.
fn render_site(&cx: Domain!['k], build: Build['k]) -> Result[(), Buffer!] {
    discover_site(&cx, build)?;
    var i = 0usize;
    while i < build.pages.len(&cx) {
        render_page(&cx, build, build.pages.at(&cx, i))?;
        i = i + 1usize;
    }
    write_redirects(&cx, build)?;
    let assets = join(&cx, build.source, build.assets);
    if exists_path(&cx, assets)? { copy_assets(&cx, build, lit(&cx, ""), 0usize)?; }
    let documents = ArenaVec::new(&cx);
    i = 0usize;
    while i < build.pages.len(&cx) {
        let source = build.pages.at(&cx, i);
        match source.format {
            TemplateFormat::Html => documents.push(&cx, Document.{
                source: source.file, output: source.destination, url: source.page.url,
                html: load(&cx, source.destination)?,
            }),
            _ => (),
        }
        i = i + 1usize;
    }
    validate(&cx, documents, build.stylesheets, build.written, build.output, build.base_path)?;
    Result::Ok.(())
}

forall 'k.
fn clean_after_error(&cx: Domain!['k], stage: Span['k], message: Buffer!) -> Buffer! {
    match remove_tree(&cx, stage) {
        Result::Ok(nothing) => message,
        Result::Err(cleanup) => message.push_buffer(cleanup),
    }
}

forall 'k.
fn check_config_output(&cx: Domain!['k], config: Config['k]) -> Result[(), Buffer!] {
    if config.output.eq(&cx, config.input) || config.output.starts_with(&cx,
        Buffer!::new().push_bytes(&cx, config.input).push_static("/").save(&cx)) {
        return Result::Err.(report(&cx, "output must be outside input", config.output));
    }
    Result::Ok.(())
}

forall 'k.
fn read_site_data(&cx: Domain!['k], source: Span['k], config: Config['k])
    -> Result[ArenaMap[Span['k], TomlValue['k], 'k], Buffer!] {
    let site_file = join(&cx, source, config.data);
    let site_data = if exists_path(&cx, site_file)? {
        let text = load(&cx, site_file)?;
        match parse(&cx, text) {
            Result::Ok(data) => data,
            Result::Err(e) => return Result::Err.(report_detail(&cx, site_file, lit(&cx, e.message))),
        }
    } else { ArenaMap::new(&cx) };
    if site_data.contains(&cx, lit(&cx, "base_path")) {
        return Result::Err.(report(&cx, "site data key is reserved", lit(&cx, "base_path")));
    }
    if site_data.contains(&cx, lit(&cx, "origin")) {
        return Result::Err.(report(&cx, "site data key is reserved", lit(&cx, "origin")));
    }
    if site_data.contains(&cx, lit(&cx, "asset_urls")) {
        return Result::Err.(report(&cx, "site data key is reserved", lit(&cx, "asset_urls")));
    }
    let replaced = site_data.insert(&cx, lit(&cx, "base_path"), TomlValue::String.(config.base_path));
    let replaced = site_data.insert(&cx, lit(&cx, "origin"), TomlValue::String.(config.origin));
    Result::Ok.(site_data)
}

forall 'k.
fn new_build(&cx: Domain!['k], root: Span['k], config: Config['k], source: Span['k],
    output: Span['k], include_drafts: bool, site_data: ArenaMap[Span['k], TomlValue['k], 'k]) -> Build['k] {
    Build.{ source, output, layouts: join(&cx, source, config.layouts), layouts_rel: config.layouts,
        assets: config.assets, fingerprint_assets: config.fingerprint_assets, asset_urls: ArenaMap::new(&cx),
        data_dir: parent(&cx, config.data), base_path: config.base_path,
        include_drafts, exclude: config.exclude,
        site_data, definitions: config.definitions, config_file: join(&cx, root, lit(&cx, "krayon.toml")),
        collections: ArenaMap::new(&cx), navigation: ArenaMap::new(&cx),
        source_urls: ArenaMap::new(&cx), pages: ArenaVec::new(&cx), redirects: ArenaVec::new(&cx),
        pending_pagination: ArenaVec::new(&cx),
        stylesheets: ArenaVec::new(&cx), written: ArenaMap::new(&cx) }
}

forall 'k.
fn routes_with_drafts(&cx: Domain!['k], root: Span['k], include_drafts: bool) -> Result[Buffer!, Buffer!] {
    let config = read_config(&cx, root)?;
    check_config_output(&cx, config)?;
    let source = join(&cx, root, config.input);
    let output = join(&cx, root, config.output);
    let site_data = read_site_data(&cx, source, config)?;
    let build = new_build(&cx, root, config, source, output, include_drafts, site_data);
    discover_site(&cx, build)?;
    build.redirects.sort_by(&cx, |&cx, a, b| a.url.cmp(&cx, b.url));
    var listing = Buffer!::new();
    var i = 0usize;
    while i < build.pages.len(&cx) {
        let entry = build.pages.at(&cx, i);
        let relative = entry.file.slice(build.source.len() + 1usize, entry.file.len());
        listing = listing.push_static("page\t").push_bytes(&cx, relative)
            .push_byte(b'\t').push_bytes(&cx, prefix(&cx, build.base_path, entry.page.url)).push_byte(b'\n');
        i = i + 1usize;
    }
    i = 0usize;
    while i < build.redirects.len(&cx) {
        let redirect = build.redirects.at(&cx, i);
        listing = listing.push_static("alias\t").push_bytes(&cx, prefix(&cx, build.base_path, redirect.url))
            .push_byte(b'\t').push_bytes(&cx, prefix(&cx, build.base_path, redirect.target)).push_byte(b'\n');
        i = i + 1usize;
    }
    Result::Ok.(listing)
}

forall 'k.
fn check_with_drafts(&cx: Domain!['k], root: Span['k], include_drafts: bool) -> Result[(), Buffer!] {
    let config = read_config(&cx, root)?;
    check_config_output(&cx, config)?;
    let source = join(&cx, root, config.input);
    let output = join(&cx, root, config.output);
    let site_data = read_site_data(&cx, source, config)?;
    ensure_dir(&cx, parent(&cx, output))?;
    let previous = check_output(&cx, source, output)?;
    let (stage, backup) = stage_paths(&cx, output)?;
    let build = new_build(&cx, root, config, source, stage, include_drafts, site_data);
    match render_site(&cx, build) {
        Result::Ok(nothing) => remove_tree(&cx, stage),
        Result::Err(message) => Result::Err.(clean_after_error(&cx, stage, message)),
    }
}

forall 'k.
fn build_with_drafts(&cx: Domain!['k], root: Span['k], include_drafts: bool) -> Result[(), Buffer!] {
    let config = read_config(&cx, root)?;
    check_config_output(&cx, config)?;
    let source = join(&cx, root, config.input);
    let output = join(&cx, root, config.output);
    let site_data = read_site_data(&cx, source, config)?;
    ensure_dir(&cx, parent(&cx, output))?;
    let previous = check_output(&cx, source, output)?;
    let (stage, backup) = stage_paths(&cx, output)?;
    let build = new_build(&cx, root, config, source, stage, include_drafts, site_data);
    match render_site(&cx, build) {
        Result::Ok(nothing) => (),
        Result::Err(message) => return Result::Err.(clean_after_error(&cx, stage, message)),
    }
    if previous {
        match rename(&cx, output, backup) {
            Result::Ok(nothing) => (),
            Result::Err(e) => return Result::Err.(clean_after_error(&cx, stage, report(&cx, "cannot move previous output", output))),
        }
    }
    match rename(&cx, stage, output) {
        Result::Ok(nothing) => (),
        Result::Err(e) => {
            var message = report(&cx, "cannot install generated output", output);
            if previous {
                match rename(&cx, backup, output) {
                    Result::Ok(nothing) => (),
                    Result::Err(e) => { message = message.push_buffer(report(&cx, "cannot restore previous output", backup)); },
                }
            }
            return Result::Err.(clean_after_error(&cx, stage, message));
        },
    }
    if previous { remove_tree(&cx, backup)?; }
    Result::Ok.(())
}

forall 'k.
fn build(&cx: Domain!['k], root: Span['k]) -> Result[(), Buffer!] {
    build_with_drafts(&cx, root, false)
}
