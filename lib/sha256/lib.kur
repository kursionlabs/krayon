use std::arena::Domain!;
use std::buffer::Buffer!;
use std::collections::arena_vec::ArenaVec;
use std::io::{Error, File!};
use std::option::{Option, Result};
use std::raw::Span;
use std::slice::ReadBytes;

forall 'k.
exposed struct Hasher {
    rounds: ArenaVec[u32, 'k],
    state: ArenaVec[u32, 'k],
    schedule: ArenaVec[u32, 'k],
    pending: ArenaVec[u8, 'k],
    used: usize,
    total: u64,
}

fn rotate(value: u32, amount: u32) -> u32 {
    (value >> amount) | (value << (32u32 - amount))
}

fn hex_value(c: u8) -> u32 {
    if c >= b'0' && c <= b'9' { (c - b'0') as u32 }
    else { (c - b'a' + 10u8) as u32 }
}

fn hex_digit(value: u8) -> u8 {
    if value < 10u8 { b'0' + value } else { b'a' + value - 10u8 }
}

fn push_hex_word(out: Buffer!, word: u32) -> Buffer! {
    var out = out;
    var i = 8usize;
    while i > 0usize {
        i = i - 1usize;
        out = out.push_byte(hex_digit(((word >> ((i as u32) * 4u32)) & 15u32) as u8));
    }
    out
}

forall 'k.
fn constant(&cx: Domain!['k], digits: Span['k], index: usize) -> u32 {
    var value = 0u32;
    var i = index * 8usize;
    while i < index * 8usize + 8usize {
        value = (value << 4u32) | hex_value(digits.byte_or_zero(&cx, i));
        i = i + 1usize;
    }
    value
}

// SHA-256 (FIPS 180-4), with a reusable 64-byte message block.
forall 'k.
fn new_hash(&cx: Domain!['k]) -> Hasher['k] {
    let constants = Buffer!::new()
        .push_static("428a2f9871374491b5c0fbcfe9b5dba53956c25b59f111f1923f82a4ab1c5ed5")
        .push_static("d807aa9812835b01243185be550c7dc372be5d7480deb1fe9bdc06a7c19bf174")
        .push_static("e49b69c1efbe47860fc19dc6240ca1cc2de92c6f4a7484aa5cb0a9dc76f988da")
        .push_static("983e5152a831c66db00327c8bf597fc7c6e00bf3d5a7914706ca635114292967")
        .push_static("27b70a852e1b21384d2c6dfc53380d13650a7354766a0abb81c2c92e92722c85")
        .push_static("a2bfe8a1a81a664bc24b8b70c76c51a3d192e819d6990624f40e3585106aa070")
        .push_static("19a4c1161e376c082748774c34b0bcb5391c0cb34ed8aa4a5b9cca4f682e6ff3")
        .push_static("748f82ee78a5636f84c878148cc7020890befffaa4506cebbef9a3f7c67178f2")
        .save(&cx);
    let rounds = ArenaVec::new(&cx);
    var i = 0usize;
    while i < 64usize {
        rounds.push(&cx, constant(&cx, constants, i));
        i = i + 1usize;
    }
    let state = ArenaVec::new(&cx);
    state.push(&cx, 0x6a09e667u32);
    state.push(&cx, 0xbb67ae85u32);
    state.push(&cx, 0x3c6ef372u32);
    state.push(&cx, 0xa54ff53au32);
    state.push(&cx, 0x510e527fu32);
    state.push(&cx, 0x9b05688cu32);
    state.push(&cx, 0x1f83d9abu32);
    state.push(&cx, 0x5be0cd19u32);
    Hasher.{ rounds, state, schedule: ArenaVec::filled(&cx, 64usize, 0u32),
        pending: ArenaVec::filled(&cx, 64usize, 0u8), used: 0usize, total: 0u64 }
}

forall 'k.
fn compress(&cx: Domain!['k], hash: Hasher['k]) -> () {
    var i = 0usize;
    while i < 16usize {
        var word = 0u32;
        var j = 0usize;
        while j < 4usize {
            word = (word << 8u32) | (hash.pending.at(&cx, i * 4usize + j) as u32);
            j = j + 1usize;
        }
        let previous = hash.schedule.replace(&cx, i, word);
        i = i + 1usize;
    }
    while i < 64usize {
        let x = hash.schedule.at(&cx, i - 15usize);
        let y = hash.schedule.at(&cx, i - 2usize);
        let s0 = rotate(x, 7u32) ^ rotate(x, 18u32) ^ (x >> 3u32);
        let s1 = rotate(y, 17u32) ^ rotate(y, 19u32) ^ (y >> 10u32);
        let word = hash.schedule.at(&cx, i - 16usize) + s0 + hash.schedule.at(&cx, i - 7usize) + s1;
        let previous = hash.schedule.replace(&cx, i, word);
        i = i + 1usize;
    }
    var a = hash.state.at(&cx, 0usize);
    var b = hash.state.at(&cx, 1usize);
    var c = hash.state.at(&cx, 2usize);
    var d = hash.state.at(&cx, 3usize);
    var e = hash.state.at(&cx, 4usize);
    var f = hash.state.at(&cx, 5usize);
    var g = hash.state.at(&cx, 6usize);
    var h = hash.state.at(&cx, 7usize);
    i = 0usize;
    while i < 64usize {
        let s1 = rotate(e, 6u32) ^ rotate(e, 11u32) ^ rotate(e, 25u32);
        let choice = (e & f) ^ ((e ^ 0xffff_ffffu32) & g);
        let t1 = h + s1 + choice + hash.rounds.at(&cx, i) + hash.schedule.at(&cx, i);
        let s0 = rotate(a, 2u32) ^ rotate(a, 13u32) ^ rotate(a, 22u32);
        let majority = (a & b) ^ (a & c) ^ (b & c);
        let t2 = s0 + majority;
        h = g;
        g = f;
        f = e;
        e = d + t1;
        d = c;
        c = b;
        b = a;
        a = t1 + t2;
        i = i + 1usize;
    }
    let previous = hash.state.replace(&cx, 0usize, hash.state.at(&cx, 0usize) + a);
    let previous = hash.state.replace(&cx, 1usize, hash.state.at(&cx, 1usize) + b);
    let previous = hash.state.replace(&cx, 2usize, hash.state.at(&cx, 2usize) + c);
    let previous = hash.state.replace(&cx, 3usize, hash.state.at(&cx, 3usize) + d);
    let previous = hash.state.replace(&cx, 4usize, hash.state.at(&cx, 4usize) + e);
    let previous = hash.state.replace(&cx, 5usize, hash.state.at(&cx, 5usize) + f);
    let previous = hash.state.replace(&cx, 6usize, hash.state.at(&cx, 6usize) + g);
    let previous = hash.state.replace(&cx, 7usize, hash.state.at(&cx, 7usize) + h);
}

forall 'k, C, S where ReadBytes[C, S], Copy[S].
fn hash_bytes(&cx: Domain!['k], hash: Hasher['k], &read: C, bytes: S) -> Hasher['k] {
    var used = hash.used;
    var total = hash.total;
    var i = 0usize;
    let count = ReadBytes[C, S]::len(&read, bytes);
    while i < count {
        let value = match ReadBytes[C, S]::get(&read, bytes, i) {
            Some(found) => found,
            None => 0u8,
        };
        used = absorb(&cx, hash, used, value);
        total = total + 1u64;
        i = i + 1usize;
    }
    Hasher.{ rounds: hash.rounds, state: hash.state, schedule: hash.schedule,
        pending: hash.pending, used, total }
}

forall 'k.
fn absorb(&cx: Domain!['k], hash: Hasher['k], used: usize, value: u8) -> usize {
    let previous = hash.pending.replace(&cx, used, value);
    if used + 1usize == 64usize {
        compress(&cx, hash);
        0usize
    } else { used + 1usize }
}

forall 'k.
fn finish_hash(&cx: Domain!['k], hash: Hasher['k]) -> Span['k] {
    let bits = hash.total * 8u64;
    var used = hash.used;
    let previous = hash.pending.replace(&cx, used, 128u8);
    used = used + 1usize;
    if used > 56usize {
        while used < 64usize {
            let previous = hash.pending.replace(&cx, used, 0u8);
            used = used + 1usize;
        }
        compress(&cx, hash);
        used = 0usize;
    }
    while used < 56usize {
        let previous = hash.pending.replace(&cx, used, 0u8);
        used = used + 1usize;
    }
    var i = 0usize;
    while i < 8usize {
        let value = ((bits >> (((7usize - i) as u64) * 8u64)) & 255u64) as u8;
        let previous = hash.pending.replace(&cx, 56usize + i, value);
        i = i + 1usize;
    }
    compress(&cx, hash);
    var result = Buffer!::new();
    i = 0usize;
    while i < 8usize {
        result = push_hex_word(result, hash.state.at(&cx, i));
        i = i + 1usize;
    }
    result.save(&cx)
}

forall 'k.
fn digest_hex(&cx: Domain!['k], contents: Span['k]) -> Span['k] {
    var hash = new_hash(&cx);
    var used = 0usize;
    var i = 0usize;
    while i < contents.len() {
        used = absorb(&cx, hash, used, contents.byte_or_zero(&cx, i));
        i = i + 1usize;
    }
    hash = Hasher.{ rounds: hash.rounds, state: hash.state, schedule: hash.schedule,
        pending: hash.pending, used, total: contents.len() as u64 };
    finish_hash(&cx, hash)
}

// Reads a regular file in bounded chunks and hashes exactly the bytes read.
forall 'k.
fn digest_file(&cx: Domain!['k], path: Span['k]) -> Result[Span['k], Error] {
    let opened = File!::open_read(&cx, path)?;
    var opened = opened;
    var chunk = Buffer!::with_capacity(65536usize);
    var hash = new_hash(&cx);
    var going = true;
    while going {
        let count = match &opened.read_exact(&chunk, 65536usize) {
            Ok(n) => n,
            Err(e) => {
                chunk.destroy();
                let closed = opened.close();
                return Result::Err.(e);
            },
        };
        if count == 0usize { going = false; }
        else {
            var exists 'b. (tag, bytes, restore) = chunk.open();
            hash = hash_bytes(&cx, hash, &tag, bytes);
            chunk = restore.restore(tag).clear();
            if count < 65536usize { going = false; }
        }
    }
    chunk.destroy();
    match opened.close() {
        Ok(nothing) => Result::Ok.(finish_hash(&cx, hash)),
        Err(e) => Result::Err.(e),
    }
}
